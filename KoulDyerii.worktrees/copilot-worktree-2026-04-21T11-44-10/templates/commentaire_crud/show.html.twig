{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <h1>Commentaire</h1>
    <table class="table">
        <tbody>
            <tr><th>Id</th><td>{{ commentaire.id }}</td></tr>
            <tr><th>Contenu</th><td>{{ commentaire.content }}</td></tr>
            <tr><th>Post</th><td>{{ commentaire.post.title }}</td></tr>
            <tr><th>Utilisateur</th><td>{{ commentaire.utilisateur ? commentaire.utilisateur.email : 'Anonyme' }}</td></tr>
            <tr><th>Créé le</th><td>{{ commentaire.createdAt ? commentaire.createdAt|date('Y-m-d H:i:s') : '' }}</td></tr>
        </tbody>
    </table>
    <a href="{{ path('admin_commentaire_index') }}" class="btn btn-secondary">Retour à la liste</a>
    <a href="{{ path('admin_commentaire_edit', {'id': commentaire.id}) }}" class="btn btn-primary">Modifier</a>
    {{ include('commentaire_crud/_delete_form.html.twig') }}
</div>
{% endblock %}