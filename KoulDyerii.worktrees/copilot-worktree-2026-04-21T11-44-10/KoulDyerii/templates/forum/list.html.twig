{% extends 'base.html.twig' %}

{% block title %}Forum - Liste des sujets{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Forum</h1>
        <a href="{{ path('admin_post_new') }}" class="btn btn-success">➕ Créer un article</a>
    </div>

    {% for post in posts %}
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">{{ post.title }}</h5>
                <p class="card-text">{{ post.content|slice(0, 200) }}...</p>
                <a href="{{ path('forum_show', {'id': post.id}) }}" class="btn btn-primary">Lire la suite</a>
                <small class="text-muted">Posté le {{ post.createdAt|date('d/m/Y H:i') }}</small>
            </div>
        </div>
    {% else %}
        <p>Aucun article pour le moment.</p>
    {% endfor %}
{% endblock %}