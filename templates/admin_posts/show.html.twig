{% extends 'base_admin.html.twig' %}

{% block admin_title %}{{ 'admin.posts.show_page_title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
/* ============================================================
   VARIABLES
   ============================================================ */
:root {
    --crimson:       #7B0A2A;
    --crimson-dark:  #4E0619;
    --crimson-light: #A61840;
    --gold:          #C9922E;
    --gold-light:    #E8BE6A;
    --parchment:     #F7F0E6;
    --parchment-dark:#EDE3D3;
    --ink:           #1A120B;
    --ink-soft:      #4A3728;
    --muted:         #8A7468;
    --surface:       #FFFFFF;
    --surface-2:     #FBF7F2;
    --border:        #E8DED2;
    --green:         #1A7F4B;
    --blue:          #2563EB;
    --shadow-sm:     0 1px 3px rgba(26,18,11,.07), 0 1px 2px rgba(26,18,11,.05);
    --shadow-md:     0 4px 12px rgba(26,18,11,.09), 0 2px 6px rgba(26,18,11,.06);
    --shadow-lg:     0 10px 30px rgba(26,18,11,.12), 0 4px 12px rgba(26,18,11,.07);
    --radius-sm:     8px;
    --radius-md:     14px;
    --radius-lg:     22px;
    --transition:    all .22s cubic-bezier(.4,0,.2,1);
}

.show-page * { box-sizing: border-box; }
.show-page { font-family: 'DM Sans', sans-serif; color: var(--ink); }

/* ============================================================
   PAGE HEADER
   ============================================================ */
.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1.5px solid var(--border);
    flex-wrap: wrap;
}

.page-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 800;
    color: var(--crimson);
    margin: 0 0 4px;
    line-height: 1.25;
}

.page-header .breadcrumb-hint {
    font-size: 12.5px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 6px;
}

/* ============================================================
   BUTTONS
   ============================================================ */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 20px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    border: none;
    transition: var(--transition);
    white-space: nowrap;
}
.btn-outline {
    background: var(--surface);
    color: var(--ink-soft);
    border: 1.5px solid var(--border);
    box-shadow: var(--shadow-sm);
}
.btn-outline:hover { border-color: var(--crimson); color: var(--crimson); background: rgba(123,10,42,.04); }

.btn-primary {
    background: linear-gradient(135deg, var(--crimson), var(--crimson-light));
    color: #fff;
    box-shadow: 0 3px 10px rgba(123,10,42,.25);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 7px 18px rgba(123,10,42,.35); color: #fff; }

.btn-sm { padding: 6px 14px; font-size: 12.5px; }

/* ============================================================
   ALERTS
   ============================================================ */
.alert {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 18px;
    border-radius: var(--radius-sm);
    margin-bottom: 16px;
    font-size: 14px;
    font-weight: 500;
    animation: slideIn .3s ease;
}
@keyframes slideIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
}
.alert-success { background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; }
.alert-danger  { background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA; }

/* ============================================================
   POST CARD
   ============================================================ */
.post-detail-card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    margin-bottom: 24px;
}

.post-detail-header {
    background: linear-gradient(135deg, var(--crimson-dark), var(--crimson));
    padding: 20px 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
}

.post-detail-header .author-row {
    display: flex;
    align-items: center;
    gap: 12px;
}

.avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    background: rgba(255,255,255,.2);
    border: 2px solid rgba(255,255,255,.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: #fff;
}
.avatar img { width: 100%; height: 100%; object-fit: cover; }

.post-detail-header .author-meta strong {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
}
.post-detail-header .author-meta time {
    font-size: 12px;
    color: rgba(255,255,255,.65);
    display: flex;
    align-items: center;
    gap: 5px;
}

.post-detail-body { padding: 26px; }

.post-detail-title {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 14px;
    line-height: 1.3;
}

.post-detail-content {
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.75;
    margin-bottom: 20px;
}

.post-detail-image {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: 20px;
    box-shadow: var(--shadow-sm);
}

.post-detail-footer {
    padding: 14px 26px;
    background: var(--surface-2);
    border-top: 1.5px solid var(--border);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

/* ============================================================
   LIKE BUTTON
   ============================================================ */
.like-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 18px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    transition: var(--transition);
}
.like-btn:hover   { border-color: var(--crimson); color: var(--crimson); background: rgba(123,10,42,.05); }
.like-btn.reacted { border-color: var(--crimson); color: var(--crimson); background: rgba(123,10,42,.08); }
.like-btn i { transition: transform .2s ease; }
.like-btn:hover i, .like-btn.reacted i { transform: scale(1.2); }

/* ============================================================
   ADD COMMENT PANEL
   ============================================================ */
.add-comment-panel {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    margin-bottom: 24px;
}

.add-comment-panel .panel-header {
    background: var(--parchment);
    padding: 14px 22px;
    border-bottom: 1.5px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
}

.add-comment-panel .panel-header h5 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    gap: 8px;
}

.add-comment-panel .panel-body { padding: 22px; }

.form-textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: var(--ink);
    background: var(--surface-2);
    resize: vertical;
    outline: none;
    transition: var(--transition);
    min-height: 90px;
}
.form-textarea:focus { border-color: var(--crimson); box-shadow: 0 0 0 3px rgba(123,10,42,.08); background: #fff; }
.form-textarea.is-invalid { border-color: #DC2626; background: #FEF2F2; }
.invalid-feedback { color: #DC2626; font-size: 12.5px; margin-top: 5px; display: block; }
.form-hint { color: var(--muted); font-size: 12px; margin-top: 6px; }

/* ============================================================
   COMMENTS SECTION
   ============================================================ */
.comments-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.comments-section-title .count-pill {
    background: var(--parchment);
    color: var(--muted);
    border: 1px solid var(--border);
    font-size: 12px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 20px;
}

/* Comment card */
.comment-card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 18px 20px;
    margin-bottom: 14px;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    position: relative;
}
.comment-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--parchment-dark);
    transform: translateX(3px);
}

.comment-author-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
}

.avatar-sm {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--crimson), var(--gold));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    box-shadow: 0 2px 6px rgba(123,10,42,.18);
}

.comment-author-meta strong {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
}
.comment-author-meta time {
    font-size: 11.5px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 4px;
}

.comment-actions-right {
    margin-left: auto;
    display: flex;
    gap: 6px;
    align-items: center;
}

.comment-body {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.65;
    margin-bottom: 12px;
}

.comment-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
}

/* Inline small action buttons */
.iact-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 13px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    border: 1.5px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    transition: var(--transition);
}
.iact-btn:hover { border-color: var(--crimson); color: var(--crimson); background: rgba(123,10,42,.04); }
.iact-btn.like-btn.reacted { border-color: var(--crimson); color: var(--crimson); background: rgba(123,10,42,.08); }
.iact-btn.reply-btn:hover { border-color: var(--blue); color: var(--blue); background: rgba(37,99,235,.05); }

/* Edit/Delete small */
.cadm-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 11px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    border: 1.5px solid var(--border);
    background: var(--surface);
    transition: var(--transition);
}
.cadm-btn.edit  { color: #D97706; }
.cadm-btn.edit:hover  { border-color: #D97706; background: #FFFBEB; }
.cadm-btn.del   { color: #DC2626; }
.cadm-btn.del:hover   { border-color: #DC2626; background: #FEF2F2; }
.cadm-del-form { display: inline; }
.cadm-del-form button { background: none; }

/* Reply form */
.reply-form-wrap {
    background: var(--surface-2);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-top: 12px;
    animation: slideIn .2s ease;
}

.reply-form-wrap .form-textarea { min-height: 70px; }

.reply-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
}

.btn-cancel-reply {
    padding: 6px 14px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    transition: var(--transition);
}
.btn-cancel-reply:hover { border-color: var(--crimson); color: var(--crimson); }

/* Replies thread */
.replies-wrap {
    margin-top: 14px;
    margin-left: 30px;
    padding-left: 16px;
    border-left: 2px solid var(--parchment-dark);
}

.replies-wrap .comment-card {
    background: var(--surface-2);
    border-color: var(--parchment-dark);
}

/* Empty comments */
.no-comments {
    text-align: center;
    padding: 42px 20px;
    background: var(--surface);
    border: 1.5px dashed var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: 24px;
}
.no-comments-icon {
    width: 60px;
    height: 60px;
    background: var(--parchment);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
    font-size: 24px;
    color: var(--muted);
}
.no-comments p { color: var(--muted); font-size: 14px; margin: 0; }

/* ============================================================
   HISTORIQUE TABLE
   ============================================================ */
.history-section {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1.5px solid var(--border);
}

.history-section h4 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.history-table-wrap {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}

table.htable {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}

table.htable thead tr {
    background: var(--parchment);
    border-bottom: 1.5px solid var(--border);
}

table.htable thead th {
    padding: 11px 14px;
    font-weight: 700;
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .5px;
    white-space: nowrap;
}

table.htable tbody tr {
    border-bottom: 1px solid var(--border);
    transition: var(--transition);
}
table.htable tbody tr:last-child { border-bottom: none; }
table.htable tbody tr:hover { background: var(--surface-2); }

table.htable tbody td {
    padding: 10px 14px;
    vertical-align: middle;
    color: var(--ink-soft);
}

.badge-action {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .4px;
    text-transform: uppercase;
}
.badge-create  { background: #ECFDF5; color: #065F46; }
.badge-update  { background: #FFFBEB; color: #92400E; }
.badge-delete  { background: #FEF2F2; color: #991B1B; }
.badge-like    { background: #EFF6FF; color: #1E40AF; }
.badge-pin     { background: rgba(201,146,46,.12); color: #7C5A00; }
.badge-comment { background: #F0FDF4; color: #166534; }
.badge-signal  { background: #FFF7ED; color: #9A3412; }

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 768px) {
    .page-header { flex-direction: column; }
    .post-detail-header { flex-direction: column; align-items: flex-start; }
    .comment-author-row { flex-wrap: wrap; }
    .comment-actions-right { width: 100%; justify-content: flex-end; margin-left: 0; }
    .replies-wrap { margin-left: 10px; padding-left: 10px; }
    table.htable { font-size: 12px; }
    table.htable thead th, table.htable tbody td { padding: 8px 10px; }
}
</style>
{% endblock %}

{% block admin_content %}
<div class="show-page">

    {# ── PAGE HEADER ── #}
    <div class="page-header">
        <div>
            <h2>{{ post.title }}</h2>
            <div class="breadcrumb-hint">
                <i class="fas fa-newspaper"></i>
                <a href="{{ path('app_admin_posts_index') }}" style="color:var(--muted);text-decoration:none">{{ 'admin.posts.header_title'|trans }}</a>
                <i class="fas fa-chevron-right" style="font-size:9px"></i>
                <span>{{ 'admin.posts.detail_label'|trans }}</span>
            </div>
        </div>
        <a href="{{ path('app_admin_posts_index') }}" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> {{ 'admin.posts.back_to_list'|trans }}
        </a>
    </div>

    {# ── FLASH MESSAGES ── #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> {{ message }}</div>
    {% endfor %}

    {# ── POST DETAIL CARD ── #}
    <div class="post-detail-card">

        <div class="post-detail-header">
            <div class="author-row">
                <div class="avatar">
                    {% if post.utilisateur and post.utilisateur.photo %}
                        <img src="{{ post.utilisateur.photo }}" alt="">
                    {% else %}
                        {{ post.utilisateur ? post.utilisateur.nom|first|upper : '?' }}
                    {% endif %}
                </div>
                <div class="author-meta">
                    <strong>{{ post.utilisateur ? post.utilisateur.nom : ('admin.posts.unknown_user'|trans) }}</strong>
                    <time><i class="far fa-clock"></i> {{ post.createdAt|date('d/m/Y à H:i') }}</time>
                </div>
            </div>

            <button type="button"
                    class="btn btn-primary btn-sm"
                    data-bs-toggle="collapse"
                    data-bs-target="#addCommentForm"
                    aria-expanded="false">
                <i class="fas fa-plus"></i> {{ 'admin.posts.comment_action'|trans }}
            </button>
        </div>

        <div class="post-detail-body">
            <div class="post-detail-title">{{ post.title }}</div>
            <div class="post-detail-content">{{ post.content|nl2br }}</div>

            {% if post.imagePath %}
                <img src="{{ post.imagePath }}" class="post-detail-image" alt="{{ 'admin.posts.image_alt'|trans }}" loading="lazy">
            {% endif %}
        </div>

        <div class="post-detail-footer">
            <button class="like-btn {% if userLikedPost %}reacted{% endif %}"
                    onclick="togglePostLike({{ post.id }})"
                    id="post-like-btn-{{ post.id }}">
                <i class="fas fa-heart"></i>
                <span id="post-like-count-{{ post.id }}">{{ postLikesCount|default(0) }}</span> {{ 'admin.posts.like_label'|trans }}
            </button>

            <span style="color:var(--muted);font-size:13px;margin-left:4px">
                <i class="fas fa-comment" style="margin-right:4px"></i>
                {{ 'admin.posts.comments_count'|trans({'%count%': commentaires|filter(c => c.parent is null)|length}) }}
            </span>
        </div>

    </div>

    {# ── ADD COMMENT PANEL ── #}
    <div class="collapse {% if errors.content is defined %}show{% endif %}" id="addCommentForm">
        <div class="add-comment-panel">
            <div class="panel-header">
                <h5><i class="fas fa-pen" style="color:var(--crimson)"></i> {{ 'admin.posts.add_comment_title'|trans }}</h5>
                <i class="fas fa-chevron-up" style="color:var(--muted);font-size:12px"></i>
            </div>
            <div class="panel-body">
                <form method="post" action="{{ path('app_admin_post_comment', {id: post.id}) }}" novalidate>
                    <div style="margin-bottom:12px">
                        <textarea name="content"
                                  class="form-textarea {% if errors.content is defined %}is-invalid{% endif %}"
                                  placeholder="{{ 'admin.posts.add_comment_placeholder'|trans }}">{{ formData.content|default('') }}</textarea>
                        {% if errors.content is defined %}
                            <span class="invalid-feedback">{{ errors.content }}</span>
                        {% else %}
                            <span class="form-hint">{{ 'admin.posts.add_comment_hint'|trans }}</span>
                        {% endif %}
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-paper-plane"></i> {{ 'admin.posts.add_comment_submit'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    {# ── COMMENTS ── #}
    {% macro renderComment(commentaire, userLikedComments, commentLikesCount, postId) %}
        <div class="comment-card" id="comment-{{ commentaire.id }}">

            <div class="comment-author-row">
                <div class="avatar-sm">
                    {{ commentaire.utilisateur ? commentaire.utilisateur.nom|first|upper : '?' }}
                </div>
                <div class="comment-author-meta">
                    <strong>{{ commentaire.utilisateur ? commentaire.utilisateur.nom : ('admin.posts.comment_unknown'|trans) }}</strong>
                    <time><i class="far fa-clock"></i> {{ commentaire.createdAt|date('d/m/Y H:i') }}</time>
                </div>

                {% if app.user and commentaire.utilisateur and commentaire.utilisateur.idUtilisateur == app.user.idUtilisateur %}
                    <div class="comment-actions-right">
                        <a href="{{ path('app_admin_comment_edit', {id: commentaire.id}) }}" class="cadm-btn edit">
                            <i class="fas fa-edit"></i> {{ 'common.edit'|trans }}
                        </a>
                        <form class="cadm-del-form" method="post"
                              action="{{ path('app_admin_comment_delete', {id: commentaire.id}) }}"
                              onsubmit="return confirm('{{ 'admin.posts.comment_delete_confirm'|trans }}')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_comment' ~ commentaire.id) }}">
                            <button type="submit" class="cadm-btn del">
                                <i class="fas fa-trash"></i> {{ 'common.delete'|trans }}
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>

            <div class="comment-body">{{ commentaire.content|nl2br }}</div>

            <div class="comment-footer">
                <button class="iact-btn like-btn {% if userLikedComments[commentaire.id] is defined and userLikedComments[commentaire.id] %}reacted{% endif %}"
                        onclick="toggleCommentLike({{ commentaire.id }})"
                        id="comment-like-btn-{{ commentaire.id }}">
                    <i class="fas fa-heart"></i>
                    <span id="comment-like-count-{{ commentaire.id }}">{{ commentLikesCount[commentaire.id]|default(0) }}</span>
                </button>

                <button class="iact-btn reply-btn" onclick="toggleReplyForm({{ commentaire.id }})">
                    <i class="fas fa-reply"></i> {{ 'admin.posts.reply'|trans }}
                </button>
            </div>

            {# Reply form #}
            <div id="reply-form-{{ commentaire.id }}" class="reply-form-wrap" style="display:none">
                <form method="post" action="{{ path('app_admin_post_comment', {id: postId}) }}">
                    <input type="hidden" name="parent_id" value="{{ commentaire.id }}">
                    <textarea name="content" class="form-textarea"
                              placeholder="{{ 'admin.posts.reply_placeholder'|trans }}" required></textarea>
                    <div class="reply-actions">
                        <button type="button" class="btn-cancel-reply" onclick="hideReplyForm({{ commentaire.id }})">
                            {{ 'common.cancel'|trans }}
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-paper-plane"></i> {{ 'admin.posts.reply'|trans }}
                        </button>
                    </div>
                </form>
            </div>

            {# Nested replies #}
            {% if commentaire.replies is defined and commentaire.replies|length > 0 %}
                <div class="replies-wrap">
                    {% for reply in commentaire.replies %}
                        {{ _self.renderComment(reply, userLikedComments, commentLikesCount, postId) }}
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    {% endmacro %}

    {% import _self as commentsMacro %}

    {% set rootComments = commentaires|filter(c => c.parent is null) %}

    <div class="comments-section-title">
        <i class="fas fa-comments" style="color:var(--crimson)"></i>
        {{ 'admin.posts.comments'|trans }}
        <span class="count-pill">{{ rootComments|length }}</span>
    </div>

    {% if rootComments|length > 0 %}
        {% for commentaire in commentaires %}
            {% if commentaire.parent is null %}
                {{ commentsMacro.renderComment(commentaire, userLikedComments, commentLikesCount, post.id) }}
            {% endif %}
        {% endfor %}
    {% else %}
        <div class="no-comments">
            <div class="no-comments-icon"><i class="fas fa-comment-dots"></i></div>
            <p>{{ 'admin.posts.comments_empty'|trans }}</p>
        </div>
    {% endif %}

    {# ── HISTORIQUE ── #}
    <div class="history-section">
        <h4><i class="fas fa-history" style="color:var(--crimson);font-size:18px"></i> {{ 'admin.posts.history_title'|trans }}</h4>

        <div class="history-table-wrap">
            <div style="overflow-x:auto">
                <table class="htable">
                    <thead>
                        <tr>
                            <th>{{ 'admin.posts.history_date'|trans }}</th>
                            <th>{{ 'admin.posts.history_user'|trans }}</th>
                            <th>{{ 'admin.posts.history_action'|trans }}</th>
                            <th>{{ 'admin.posts.history_type'|trans }}</th>
                            <th>{{ 'admin.posts.history_details'|trans }}</th>
                            <th>{{ 'admin.posts.history_ip'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in historique %}
                            <tr>
                                <td style="white-space:nowrap;color:var(--muted)">
                                    <i class="far fa-clock" style="margin-right:4px"></i>
                                    {{ log.createdAt|date('d/m/Y H:i:s') }}
                                </td>
                                <td>
                                    <strong style="font-size:13px">{{ log.user ? log.user.nom : ('admin.posts.system_label'|trans) }}</strong>
                                </td>
                                <td>
                                    <span class="badge-action
                                        {% if log.action == 'create'  %}badge-create
                                        {% elseif log.action == 'update'  %}badge-update
                                        {% elseif log.action == 'delete'  %}badge-delete
                                        {% elseif log.action == 'like'    %}badge-like
                                        {% elseif log.action == 'pin'     %}badge-pin
                                        {% elseif log.action == 'comment' %}badge-comment
                                        {% elseif log.action == 'signal'  %}badge-signal
                                        {% else %}badge-update{% endif %}">
                                        {{ log.action|upper }}
                                    </span>
                                </td>
                                <td style="color:var(--muted)">{{ log.entityType }}</td>
                                <td style="color:var(--ink-soft)">{{ log.details|default('—') }}</td>
                                <td style="color:var(--muted);font-family:monospace;font-size:12px">
                                    {{ log.ipAddress|default('—') }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" style="text-align:center;padding:24px;color:var(--muted)">
                                    <i class="fas fa-inbox" style="margin-right:6px"></i>
                                    {{ 'admin.posts.history_empty'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script>
/* ── Like post ── */
function togglePostLike(postId) {
    fetch(`/admin/posts/${postId}/like`, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'like' })
    })
    .then(r => r.json())
    .then(d => {
        if (!d.success) return;
        document.getElementById('post-like-count-' + postId).textContent = d.count;
        const b = document.getElementById('post-like-btn-' + postId);
        d.liked ? b.classList.add('reacted') : b.classList.remove('reacted');
    })
    .catch(console.error);
}

/* ── Like comment ── */
function toggleCommentLike(commentId) {
    fetch(`/admin/posts/comment/${commentId}/like`, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'like' })
    })
    .then(r => r.json())
    .then(d => {
        if (!d.success) return;
        document.getElementById('comment-like-count-' + commentId).textContent = d.count;
        const b = document.getElementById('comment-like-btn-' + commentId);
        d.liked ? b.classList.add('reacted') : b.classList.remove('reacted');
    })
    .catch(console.error);
}

/* ── Reply forms ── */
function toggleReplyForm(id) {
    const el = document.getElementById('reply-form-' + id);
    if (!el) return;
    const isHidden = el.style.display === 'none' || el.style.display === '';
    el.style.display = isHidden ? 'block' : 'none';
    if (isHidden) el.querySelector('textarea')?.focus();
}

function hideReplyForm(id) {
    const el = document.getElementById('reply-form-' + id);
    if (el) el.style.display = 'none';
}
</script>
{% endblock %}
