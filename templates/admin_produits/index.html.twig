function initBuilderDragAndDrop() {
    const container = document.getElementById('builderBlocks');
    if (!container) return;

    let draggedItem = null;

    container.querySelectorAll('.builder-item').forEach(item => {
        item.addEventListener('dragstart', function () {
            draggedItem = this;
            this.classList.add('dragging');
        });

        item.addEventListener('dragend', function () {
            this.classList.remove('dragging');
            draggedItem = null;
            renderCustomPreview();
        });

        item.addEventListener('dragover', function (e) {
            e.preventDefault();
        });

        item.addEventListener('drop', function (e) {
            e.preventDefault();

            if (!draggedItem || draggedItem === this) {
                return;
            }

            const items = Array.from(container.querySelectorAll('.builder-item'));
            const draggedIndex = items.indexOf(draggedItem);
            const targetIndex = items.indexOf(this);

            if (draggedIndex < targetIndex) {
                this.after(draggedItem);
            } else {
                this.before(draggedItem);
            }

            renderCustomPreview();
        });
    });
}

async function saveCustomTheme() {
    const customThemeAlert = document.getElementById('customThemeAlert');
    customThemeAlert.style.display = 'none';
    customThemeAlert.className = 'alert panel-alert';

    const payload = {
        title: document.getElementById('customThemeTitle').value || 'My custom layout',
        style: document.getElementById('customThemeStyle').value || 'premium',
        showBundles: document.getElementById('customShowBundles').checked,
        showTestimonials: document.getElementById('customShowTestimonials').checked,
        order: getBuilderOrder()
    };

    try {
       const response = await fetch('{{ path('app_admin_produits_save_custom_theme') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
            customThemeAlert.style.display = 'block';
            customThemeAlert.classList.add('alert-danger');
            customThemeAlert.textContent = data.message || 'Erreur lors de la sauvegarde.';
            return;
        }

        customThemeAlert.style.display = 'block';
        customThemeAlert.classList.add('alert-success');
        customThemeAlert.textContent = data.message || 'Thème personnalisé sauvegardé.';

        setTimeout(() => {
            window.location.reload();
        }, 700);
    } catch (error) {
        customThemeAlert.style.display = 'block';
        customThemeAlert.classList.add('alert-danger');
        customThemeAlert.textContent = 'Erreur réseau ou serveur.';
    }
}

document.getElementById('customThemeTitle')?.addEventListener('input', renderCustomPreview);
document.getElementById('customThemeStyle')?.addEventListener('change', renderCustomPreview);
document.getElementById('customShowBundles')?.addEventListener('change', renderCustomPreview);
document.getElementById('customShowTestimonials')?.addEventListener('change', renderCustomPreview);

document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
        closeProductPanel();
        closeAiImagePanel();
        closeCustomThemeBuilder();
    }
});

initBuilderDragAndDrop();
renderCustomPreview();
toggleAiPrompt();
</script>
