        if (key === 'bundles' && !showBundles) {
            html += `<div class="preview-hidden-note">Bundles masqués dans ce thème.</div>`;
            return;
        }

        if (key === 'testimonials' && !showTestimonials) {
            html += `<div class="preview-hidden-note">Avis clients masqués dans ce thème.</div>`;
            return;
        }

        html += sections[key] || '';
