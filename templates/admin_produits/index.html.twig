                        <div class="preview-card-body">
                            <strong>Produit #1</strong>
                            <small>Bloc premium avec image et prix</small>
                            <div class="preview-price">29,90 TND</div>
                        </div>
                    </div>
                    <div class="preview-card">
                        <div class="preview-card-image"><i class="fas fa-fire"></i></div>
                        <div class="preview-card-body">
                            <strong>Produit #2</strong>
                            <small>Best seller mis en avant</small>
                            <div class="preview-price">34,90 TND</div>
                        </div>
                    </div>
                    <div class="preview-card">
                        <div class="preview-card-image"><i class="fas fa-star"></i></div>
                        <div class="preview-card-body">
                            <strong>Produit #3</strong>
                            <small>Carte compacte conversion</small>
                            <div class="preview-price">39,90 TND</div>
                        </div>
                    </div>
                </div>
            </div>
        `,
        bundles: `
            <div class="preview-section">
                <div class="preview-section-head">Bundles / Offres</div>
                <div class="preview-bundles">
                    <div class="preview-bundle">
                        <strong>Pack 2</strong>
