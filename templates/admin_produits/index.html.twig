{% extends 'base_admin.html.twig' %}

{% block admin_title %}Gestion des produits{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .products-shell {
        color: #2c1a1d;
    }

    .products-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .products-topbar h3 {
        margin: 0;
        font-weight: 800;
        color: #000;
    }

    .btn-add-product {
        background: linear-gradient(135deg, #8B0000 0%, #A52A2A 100%);
        color: #fff;
        border: none;
        border-radius: 14px;
        padding: 12px 18px;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 10px 25px rgba(139, 0, 0, 0.18);
    }

    .btn-add-product:hover {
        color: #fff;
        transform: translateY(-1px);
    }

    .theme-switcher-wrap{
        margin: 6px 0 24px;
        background: linear-gradient(135deg, #fff7f2 0%, #fff 100%);
        border: 1px solid #ead9d2;
        border-radius: 22px;
        padding: 18px;
        box-shadow: 0 10px 30px rgba(139, 0, 0, 0.06);
    }

    .theme-switcher-title{
        display:flex;
        align-items:center;
        gap:10px;
        font-weight:800;
        color:#5C4033;
        margin-bottom:14px;
        font-size:15px;
    }

    .theme-switcher{
        display:flex;
        gap:12px;
        flex-wrap:wrap;
    }

    .theme-form{
        margin:0;
    }

    .theme-pill{
        position:relative;
        display:flex;
        align-items:center;
        gap:14px;
        min-width:240px;
        padding:14px 18px;
        border:none;
        border-radius:18px;
        background:linear-gradient(135deg, #8B0000 0%, #A52A2A 100%);
        color:#fff;
        font-weight:800;
        cursor:pointer;
        overflow:hidden;
        transition:transform .25s ease, box-shadow .25s ease, filter .25s ease;
        box-shadow:0 10px 22px rgba(139, 0, 0, 0.18);
        text-align: left;
    }

    .theme-pill.dark{
        background:linear-gradient(135deg,#111 0%,#333 100%);
        box-shadow:0 10px 22px rgba(0,0,0,.18);
    }

    .theme-pill.custom{
        background:linear-gradient(135deg,#5C4033 0%, #8b5e4a 100%);
        box-shadow:0 10px 22px rgba(92,64,51,.18);
    }

    .theme-pill::before{
        content:"";
        position:absolute;
        inset:0;
        background:linear-gradient(120deg, transparent 0%, rgba(255,255,255,.18) 50%, transparent 100%);
        transform:translateX(-120%);
        transition:transform .6s ease;
    }

    .theme-pill:hover{
        transform:translateY(-4px) scale(1.01);
        filter:brightness(1.03);
    }

    .theme-pill:hover::before{
        transform:translateX(120%);
    }

    .theme-pill.active{
        transform:translateY(-2px) scale(1.02);
        box-shadow:
            0 0 0 3px rgba(255,255,255,.92),
            0 0 0 7px rgba(139,0,0,.18),
            0 18px 35px rgba(139,0,0,.22);
    }

    .theme-pill.dark.active{
        box-shadow:
            0 0 0 3px rgba(255,255,255,.92),
            0 0 0 7px rgba(0,0,0,.15),
            0 18px 35px rgba(0,0,0,.24);
    }

    .theme-pill.custom.active{
        box-shadow:
            0 0 0 3px rgba(255,255,255,.92),
            0 0 0 7px rgba(92,64,51,.18),
            0 18px 35px rgba(92,64,51,.24);
    }

    .theme-icon{
        width:46px;
        height:46px;
        border-radius:14px;
        background:rgba(255,255,255,.14);
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:18px;
        flex-shrink:0;
    }

    .theme-text{
        display:flex;
        flex-direction:column;
        align-items:flex-start;
        line-height:1.1;
    }

    .theme-text strong{
        color:#fff;
        font-size:15px;
    }

    .theme-text small{
        color:rgba(255,255,255,.82);
        font-size:12px;
        margin-top:4px;
    }

    .theme-check{
        margin-left:auto;
        width:32px;
        height:32px;
        border-radius:50%;
        background:rgba(255,255,255,.16);
        display:flex;
        align-items:center;
        justify-content:center;
        opacity:.45;
        transform:scale(.8);
        transition:all .25s ease;
        flex-shrink: 0;
    }

    .theme-pill.active .theme-check{
        opacity:1;
        transform:scale(1);
        background:#fff;
        color:#8B0000;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-box {
        border-radius: 22px;
        padding: 22px;
        color: #fff;
        position: relative;
        overflow: hidden;
        min-height: 140px;
    }

    .stat-box::after {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        right: -60px;
        top: -40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
    }

    .stat-bordeaux {
        background: linear-gradient(135deg, #8B0000 0%, #A52A2A 100%);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .stat-green {
        background: linear-gradient(135deg, #5e8a24 0%, #7aa53a 100%);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .stat-red {
        background: linear-gradient(135deg, #b42318 0%, #d84c4c 100%);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .stat-dark {
        background: linear-gradient(135deg, #5C4033 0%, #7a5a4a 100%);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .stat-title {
        font-size: 15px;
        color: rgba(255,255,255,0.92);
        margin-bottom: 12px;
        font-weight: 700;
    }

    .stat-value {
        font-size: 40px;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 10px;
    }

    .stat-subvalue {
        font-size: 14px;
        font-weight: 700;
        opacity: 0.95;
    }

    .filters-card {
        background: #fff7f2;
        border: 1px solid #ead9d2;
        border-radius: 20px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .filters-card .form-control,
    .filters-card .form-select {
        background: #fff;
        border: 1px solid #e3cfc7;
        color: #2c1a1d;
        border-radius: 14px;
        height: 48px;
    }

    .filters-card .form-control::placeholder {
        color: #9a7f75;
    }

    .btn-reset-products {
        background: #6d7683;
        color: #fff;
        border: none;
        border-radius: 14px;
        padding: 12px 16px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 48px;
        width: 100%;
    }

    .btn-reset-products:hover {
        color: #fff;
        opacity: 0.95;
    }

    .products-table-card {
        background: #110015;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        overflow: hidden;
    }

    .products-table {
    margin: 0;
    color: #000 !important; /* BLACK TEXT */
}

    .products-table thead th {
        background: #7b1e2b;
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        padding: 16px 14px;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .products-table td {
        padding: 15px 14px;
        vertical-align: middle;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .products-table tbody tr:hover {
        background: rgba(255,255,255,0.02);
    }

    .image-thumb {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,0.1);
        background: #1f1230;
    }

    .image-fallback {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #1f1230;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #d8c4ff;
        font-size: 18px;
    }

    .product-name {
        font-weight: 800;
        color: #fff;
    }

    .product-desc {
        color: #b8a6c9;
        font-size: 13px;
        max-width: 280px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .price-text {
        font-weight: 800;
        color: #000;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 800;
    }

    .status-on {
        background: #dcfce7;
        color: #166534;
    }

    .status-off {
        background: #fee2e2;
        color: #991b1b;
    }

    .actions-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,0.10);
        background: #1a0626;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .action-btn:hover {
        background: #8B0000;
        color: #fff;
    }

    .action-btn.ai-btn {
        background: #2b183a;
        border-color: rgba(216, 180, 255, 0.18);
        color: #f1d7ff;
    }

    .action-btn.ai-btn:hover {
        background: #6e2db4;
        color: #fff;
    }

    .flash-box {
        border-radius: 14px;
        margin-bottom: 16px;
    }

    .empty-box {
        text-align: center;
        padding: 50px 20px;
        color: #c4b5d9;
    }

    .product-panel-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 9998;
        opacity: 0;
        visibility: hidden;
        transition: 0.25s ease;
    }

    .product-panel-overlay.open {
        opacity: 1;
        visibility: visible;
    }

    .product-panel {
        position: fixed;
        top: 0;
        right: -760px;
        width: 760px;
        max-width: 100%;
        height: 100vh;
        background: #fff7f2;
        box-shadow: -10px 0 40px rgba(0,0,0,0.25);
        z-index: 9999;
        transition: 0.32s ease;
        overflow-y: auto;
        border-left: 1px solid #ead9d2;
    }

    #customThemePanel.product-panel{
        width: 1400px;
        max-width: 96vw;
        right: -96vw;
    }

    #customThemePanel.product-panel.open{
        right: 0;
    }

    .product-panel.open {
        right: 0;
    }

    .product-panel-header {
        padding: 22px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #ead9d2;
        background: linear-gradient(135deg, #8B0000 0%, #A52A2A 100%);
        color: #fff;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .product-panel-title {
        font-size: 28px;
        font-weight: 900;
        margin: 0;
    }

    .product-panel-close {
        background: #fff;
        color: #8B0000;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        border: none;
        font-size: 18px;
        font-weight: 900;
        cursor: pointer;
    }

    .product-panel-body {
        padding: 24px;
    }

    .product-section {
        background: #fff;
        border: 1px solid #ead9d2;
        border-radius: 18px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .product-section-head {
        padding: 16px 20px;
        border-bottom: 1px solid #f0dfd8;
        font-size: 22px;
        font-weight: 800;
        color: #5C4033;
    }

    .product-section-content {
        padding: 20px;
    }

    .product-panel label {
        display: block;
        font-weight: 800;
        color: #5C4033;
        margin-bottom: 8px;
    }

   .product-panel .form-control,
.product-panel textarea {
    border-radius: 14px;
    border: 1px solid #e3cfc7;
    background: #fff;
    color: #000 !important; /* ✅ BLACK TEXT */
}

    .product-panel .form-control {
        min-height: 48px;
    }

    .product-panel textarea.form-control {
        min-height: 140px;
        resize: vertical;
    }

    .product-panel .form-control::placeholder,
.product-panel textarea::placeholder {
    color: #888; /* softer gray */
}

    .product-panel .form-check-label {
        color: #5C4033;
        font-weight: 700;
    }

    .upload-box {
        border: 2px dashed #d6bfb5;
        border-radius: 18px;
        background: #fff7f2;
        min-height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 18px;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .upload-box:hover {
        background: #fff2eb;
    }

    .upload-placeholder {
        color: #8a6a60;
    }

    .upload-placeholder i {
        font-size: 42px;
        color: #8B0000;
        margin-bottom: 10px;
    }

    .upload-preview {
        max-width: 100%;
        max-height: 220px;
        object-fit: cover;
        border-radius: 14px;
        border: 1px solid #ead9d2;
        display: none;
    }

    .upload-note {
        margin-top: 10px;
        color: #8a6a60;
        font-size: 13px;
    }

    .save-panel-btn {
        background: linear-gradient(135deg, #8B0000 0%, #A52A2A 100%);
        color: #fff;
        border: none;
        width: 100%;
        min-height: 52px;
        border-radius: 14px;
        font-size: 18px;
        font-weight: 900;
        box-shadow: 0 10px 20px rgba(139, 0, 0, 0.15);
    }

    .save-panel-btn:hover {
        opacity: 0.96;
    }

    .panel-alert {
        display: none;
        margin-bottom: 16px;
        border-radius: 14px;
    }

    .form-small-note {
        font-size: 13px;
        color: #8a6a60;
        margin-top: 6px;
    }

    .custom-builder-layout{
        display:grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.9fr);
        gap:20px;
        align-items:start;
    }

    .custom-builder-left,
    .custom-builder-right{
        display:flex;
        flex-direction:column;
        gap:20px;
    }

    .custom-builder-left .product-section,
    .custom-builder-right .product-section{
        margin-bottom:0;
    }

    .builder-blocks{
        display:flex;
        flex-direction:column;
        gap:12px;
    }

    .builder-item{
        display:flex;
        align-items:center;
        gap:12px;
        padding:14px 16px;
        border-radius:16px;
        background:#fff;
        border:1px solid #ead9d2;
        cursor:grab;
        font-weight:700;
        color:#5C4033;
        box-shadow:0 8px 18px rgba(92,64,51,.06);
        transition:transform .2s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease;
    }

    .builder-item:hover{
        transform:translateY(-2px);
        box-shadow:0 14px 24px rgba(92,64,51,.10);
        border-color:#d7b2a3;
    }

    .builder-item.dragging{
        opacity:.55;
        transform:scale(.98);
    }

    .builder-item i{
        color:#8B0000;
    }

    .custom-theme-preview{
        display:grid;
        gap:16px;
    }

    .preview-stage{
        border:1px solid #ead9d2;
        border-radius:24px;
        overflow:hidden;
        background:#fff;
        box-shadow:0 16px 40px rgba(92,64,51,.08);
    }

    .preview-stage.premium{ background:linear-gradient(180deg,#fff8f4 0%,#ffffff 100%); }
    .preview-stage.clean{ background:#ffffff; }
    .preview-stage.conversion{ background:linear-gradient(180deg,#fff 0%,#fff4f0 100%); }

    .preview-toolbar{
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding:14px 16px;
        background:#fff7f2;
        border-bottom:1px solid #ead9d2;
    }

    .preview-toolbar strong{ color:#5C4033; font-size:15px; }
    .preview-toolbar span{ font-size:12px; color:#8a6a60; font-weight:700; }

    .preview-canvas{
        padding:18px;
        display:grid;
        gap:14px;
    }

    .preview-section{
        border:1px solid #ead9d2;
        border-radius:18px;
        background:#fff;
        overflow:hidden;
    }

    .preview-section-head{
        padding:10px 14px;
        font-size:12px;
        font-weight:900;
        letter-spacing:.3px;
        text-transform:uppercase;
        background:#fff7f2;
        color:#8B0000;
        border-bottom:1px solid #f0dfd8;
    }

    .preview-hero{
        padding:18px;
        display:grid;
        grid-template-columns:1.2fr .8fr;
        gap:14px;
        align-items:center;
    }

    .preview-hero-copy h4{ margin:0 0 8px; font-size:24px; font-weight:900; color:#2c1a1d; }
    .preview-hero-copy p{ margin:0 0 12px; color:#7a6259; line-height:1.5; font-size:13px; }
    .preview-buttons{ display:flex; gap:8px; flex-wrap:wrap; }
    .preview-btn{ border-radius:999px; padding:8px 12px; font-size:12px; font-weight:800; }
    .preview-btn.primary{ background:linear-gradient(135deg,#8B0000 0%,#A52A2A 100%); color:#fff; }
    .preview-btn.soft{ background:#f3e4dd; color:#8B0000; }

    .preview-hero-visual{
        min-height:150px;
        border-radius:18px;
        background:linear-gradient(135deg,#8B0000 0%,#A52A2A 100%);
        display:flex;
        align-items:center;
        justify-content:center;
        color:#fff;
        font-size:38px;
    }

    .preview-cards{
        padding:16px;
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:12px;
    }

    .preview-card{
        border:1px solid #ead9d2;
        border-radius:16px;
        background:#fff;
        overflow:hidden;
    }

    .preview-card-image{
        height:90px;
        background:linear-gradient(135deg,#f2dfd7 0%,#fff7f2 100%);
        display:flex;
        align-items:center;
        justify-content:center;
        color:#8B0000;
        font-size:26px;
    }

    .preview-card-body{ padding:12px; }
    .preview-card-body strong{ display:block; color:#2c1a1d; font-size:13px; margin-bottom:6px; }
    .preview-card-body small{ display:block; color:#8a6a60; margin-bottom:8px; }
    .preview-price{ font-size:15px; font-weight:900; color:#8B0000; }

    .preview-bundles{
        padding:16px;
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:12px;
    }

    .preview-bundle{
        border:1px solid #ead9d2;
        border-radius:16px;
        padding:14px;
        background:#fffaf7;
        text-align:center;
    }

    .preview-bundle strong{ display:block; color:#5C4033; margin-bottom:6px; }
    .preview-bundle span{ font-size:12px; color:#8a6a60; display:block; margin-bottom:8px; }
    .preview-bundle b{ color:#8B0000; font-size:16px; }

    .preview-testimonials{
        padding:16px;
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:12px;
    }

    .preview-quote{
        border:1px solid #ead9d2;
        border-radius:16px;
        padding:14px;
        background:#fff;
    }

    .preview-quote p{ margin:0 0 8px; color:#5f4b45; font-size:13px; line-height:1.5; }
    .preview-quote strong{ color:#8B0000; font-size:12px; }

    .preview-cta{
        padding:20px;
        text-align:center;
        background:linear-gradient(135deg,#8B0000 0%,#A52A2A 100%);
        color:#fff;
    }

    .preview-cta h5{ margin:0 0 8px; font-size:20px; font-weight:900; }
    .preview-cta p{ margin:0 0 12px; color:rgba(255,255,255,.86); font-size:13px; }

    .preview-hidden-note{
        padding:14px;
        border:1px dashed #d7b2a3;
        border-radius:16px;
        text-align:center;
        color:#8a6a60;
        font-size:13px;
        background:#fffaf7;
    }

    @media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .custom-builder-layout{
            grid-template-columns:1fr;
        }

        .wallet-summary-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .product-panel {
            width: 100%;
        }

        .theme-pill{
            width:100%;
            min-width:unset;
        }

        .preview-hero,
        .preview-cards,
        .preview-bundles,
        .preview-testimonials{
            grid-template-columns:1fr;
        }
    }
.product-panel input,
.product-panel textarea {
    color: #000 !important;
}

.ai-image-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.ai-image-card {
    border: 1px solid #ead9d2;
    background: #fff;
    border-radius: 18px;
    padding: 16px;
}

.ai-image-card h5 {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 800;
    color: #5C4033;
}

.ai-image-stage {
    min-height: 280px;
    border-radius: 16px;
    border: 1px dashed #d8c2ba;
    background: #fff7f2;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.ai-image-stage img {
    width: 100%;
    height: 280px;
    object-fit: contain;
    display: block;
    background: #fff;
}

.ai-image-placeholder {
    color: #9d8277;
    text-align: center;
    padding: 20px;
    font-weight: 700;
}

.ai-result-link {
    margin-top: 10px;
    font-size: 13px;
}

.ai-panel-actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
}

.ai-panel-meta {
    font-size: 13px;
    color: #8a6a60;
    margin-top: 10px;
}

</style>
{% endblock %}

{% block admin_content %}
{% set customThemeConfig = customThemeConfig|default({}) %}
<div class="products-shell">
    <div class="products-topbar">
        <h3>📦 Gestion des produits</h3>
        <button type="button" class="btn-add-product" onclick="openProductPanel()">
            <i class="fas fa-plus"></i> Ajouter un produit
        </button>
    </div>
    <div class="theme-switcher-wrap">
        <div class="theme-switcher-title">
            <i class="fas fa-palette"></i>
            <span>Choisir le thème d'affichage</span>
        </div>

        <div class="theme-switcher">
            <form action="{{ path('app_admin_produits_set_theme', {theme: 'aov'}) }}" method="post" class="theme-form">
                <button type="submit" class="theme-pill {{ currentTheme == 'aov' ? 'active' : '' }}">
                    <span class="theme-icon"><i class="fas fa-layer-group"></i></span>
                    <span class="theme-text">
                        <strong>Theme AOV</strong>
                        <small>Look premium</small>
                    </span>
                    <span class="theme-check"><i class="fas fa-check"></i></span>
                </button>
            </form>

            <form action="{{ path('app_admin_produits_set_theme', {theme: 'conversion'}) }}" method="post" class="theme-form">
                <button type="submit" class="theme-pill dark {{ currentTheme == 'conversion' ? 'active' : '' }}">
                    <span class="theme-icon"><i class="fas fa-bolt"></i></span>
                    <span class="theme-text">
                        <strong>Theme Conversion</strong>
                        <small>Focus vente</small>
                    </span>
                    <span class="theme-check"><i class="fas fa-check"></i></span>
                </button>
            </form>

            <button type="button" class="theme-pill custom {{ currentTheme == 'custom' ? 'active' : '' }}" onclick="openCustomThemeBuilder()">
                <span class="theme-icon"><i class="fas fa-magic"></i></span>
                <span class="theme-text">
                    <strong>Custom Theme</strong>
                    <small>Drag & Drop builder</small>
                </span>
                <span class="theme-check"><i class="fas fa-check"></i></span>
            </button>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-box stat-bordeaux">
            <div class="stat-title">Quantité totale</div>
            <div class="stat-value">{{ stats.total_quantity }}</div>
            <div class="stat-subvalue">{{ stats.total }} produit(s)</div>
        </div>

        <div class="stat-box stat-green">
            <div class="stat-title">Quantité disponible</div>
            <div class="stat-value">{{ stats.available_quantity }}</div>
            <div class="stat-subvalue">{{ stats.disponibles }} produit(s) actifs</div>
        </div>

        <div class="stat-box stat-red">
            <div class="stat-title">Produits indisponibles</div>
            <div class="stat-value">{{ stats.indisponibles }}</div>
            <div class="stat-subvalue">Produits désactivés</div>
        </div>

        <div class="stat-box stat-dark">
            <div class="stat-title">Valeur catalogue estimée</div>
            <div class="stat-value" style="font-size: 30px;">
                {{ stats.catalog_value|number_format(2, ',', ' ') }} TND
            </div>
            <div class="stat-subvalue">
                Disponibles: {{ stats.available_value|number_format(2, ',', ' ') }} TND
            </div>
        </div>
    </div>

    <div class="filters-card">
        <form method="get" id="filterForm">
            <div class="row g-3">
                <div class="col-lg-4">
                    <input
                        type="text"
                        name="search"
                        class="form-control"
                        placeholder="Search..."
                        value="{{ search }}"
                    >
                </div>

                <div class="col-lg-3">
                    <select name="disponible" class="form-select" onchange="this.form.submit()">
                        <option value="">Tous les produits</option>
                        <option value="disponible" {% if disponible == 'disponible' %}selected{% endif %}>Disponibles</option>
                        <option value="indisponible" {% if disponible == 'indisponible' %}selected{% endif %}>Indisponibles</option>
                    </select>
                </div>

                <div class="col-lg-3">
                    <select name="sort" class="form-select" onchange="this.form.submit()">
                        <option value="id_desc" {% if sort == 'id_desc' %}selected{% endif %}>Plus récents</option>
                        <option value="id_asc" {% if sort == 'id_asc' %}selected{% endif %}>Plus anciens</option>
                        <option value="nom_asc" {% if sort == 'nom_asc' %}selected{% endif %}>Nom A→Z</option>
                        <option value="nom_desc" {% if sort == 'nom_desc' %}selected{% endif %}>Nom Z→A</option>
                        <option value="prix_asc" {% if sort == 'prix_asc' %}selected{% endif %}>Prix croissant</option>
                        <option value="prix_desc" {% if sort == 'prix_desc' %}selected{% endif %}>Prix décroissant</option>
                    </select>
                </div>

                <div class="col-lg-2">
                    <a href="{{ path('app_admin_produits_index') }}" class="btn-reset-products">
                        <i class="fas fa-undo"></i>&nbsp; Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success flash-box">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger flash-box">{{ message }}</div>
    {% endfor %}

    <div class="products-table-card">
        <div class="table-responsive">
            <table class="table products-table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Quantité</th>
                        <th>Statut</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for produit in produits %}
                        <tr>
                            <td><strong>{{ produit.idProduit }}</strong></td>

                            <td>
                                {% if produit.photo %}
                                    <img src="{{ produit.photo }}" alt="{{ produit.nom }}" class="image-thumb">
                                {% else %}
                                    <span class="image-fallback">
                                        <i class="fas fa-box"></i>
                                    </span>
                                {% endif %}
                            </td>

                            <td>
                                <div class="product-name">{{ produit.nom }}</div>
                                <div class="product-desc">
                                    {{ produit.description ? produit.description|slice(0, 70) ~ (produit.description|length > 70 ? '...' : '') : 'Sans description' }}
                                </div>
                            </td>

                            <td>
                                <span class="price-text">{{ produit.prix|number_format(2, ',', ' ') }} TND</span>
                            </td>

                            <td>
                                <span class="price-text">{{ produit.quantite|default(0) }}</span>
                            </td>

                            <td>
                                {% if produit.disponible %}
                                    <span class="status-badge status-on">Shown</span>
                                {% else %}
                                    <span class="status-badge status-off">Hidden</span>
                                {% endif %}
                            </td>

                            <td>
                                <div class="actions-wrap">
                                    <button
    type="button"
    class="action-btn"
    title="Modifier"
    onclick="openEditProductPanel(
    '{{ produit.idProduit }}',
    '{{ produit.nom|e('js') }}',
    '{{ produit.prix }}',
    '{{ produit.quantite|default(0) }}',
    '{{ produit.description|default('')|e('js') }}',
    '{{ produit.disponible ? 1 : 0 }}',
    '{{ produit.photo|default('')|e('js') }}',
    '{{ produit.bundleActive ? 1 : 0 }}',
    '{{ produit.bundleType|default('')|e('js') }}',
    '{{ produit.bundleBuyQty|default('') }}',
    '{{ produit.bundlePayQty|default('') }}',
    '{{ produit.bundleDiscountPercent|default('') }}'
)"
>
    <i class="fas fa-pen"></i>
</button>

                                    <button
                                        type="button"
                                        class="action-btn ai-btn"
                                        title="AI Edit"
                                        onclick="openAiImagePanel(
                                            '{{ produit.idProduit }}',
                                            '{{ produit.nom|e('js') }}',
                                            '{{ produit.photo|default('')|e('js') }}'
                                        )"
                                    >
                                        <i class="fas fa-wand-magic-sparkles"></i>
                                    </button>

                                    <form action="{{ path('app_admin_produits_delete', {id: produit.idProduit}) }}" method="post" style="display:inline-block;">
                                        <button type="submit" class="action-btn" title="Supprimer" onclick="return confirm('Supprimer {{ produit.nom }} ?')" style="cursor:pointer;">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">
                                <div class="empty-box">
                                    <i class="fas fa-box-open fa-2x mb-3"></i>
                                    <div>Aucun produit trouvé.</div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="productPanelOverlay" class="product-panel-overlay" onclick="closeProductPanel()"></div>

<div id="productPanel" class="product-panel">
    <div class="product-panel-header">
        <h3 class="product-panel-title" id="productPanelTitle">Create a product</h3>
        <button type="button" class="product-panel-close" onclick="closeProductPanel()">✕</button>
    </div>

    <div class="product-panel-body">
        <div id="productPanelAlert" class="alert panel-alert"></div>

        <form id="productForm" enctype="multipart/form-data">
        <input type="hidden" id="panelProductId" name="id" value="">
            <div class="product-section">
                <div class="product-section-head">Details</div>
                <div class="product-section-content">
                    <div class="row g-4">
                        <div class="col-lg-4">
                            <label>Image du produit</label>

                            <label for="productPhotoInput" class="upload-box">
                                <div id="uploadPlaceholder" class="upload-placeholder">
                                    <i class="fas fa-image"></i>
                                    <div><strong>Ajouter une image</strong></div>
                                    <div class="form-small-note">JPG, PNG, WEBP - max 2 Mo</div>
                                </div>

                                <img id="uploadPreview" class="upload-preview" alt="Preview">
                            </label>

                            <input type="file" id="productPhotoInput" name="photo" accept="image/*" style="display:none;">

                            <div class="upload-note">Prévisualisation directe avant sauvegarde.</div>
                        </div>

                        <div class="col-lg-8">
                            <div class="mb-3">
                                <label for="panelNom">Nom du produit</label>
                                <input type="text" class="form-control" id="panelNom" name="nom" placeholder="Ex: Ma9rouna" required>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="panelPrix">Prix</label>
                                    <input type="number" step="0.01" min="0.01" class="form-control" id="panelPrix" name="prix" placeholder="Ex: 49.90" required>
                                </div>

                                <div class="col-md-6">
                                    <label for="panelQuantite">Quantité</label>
                                    <input type="number" min="0" class="form-control" id="panelQuantite" name="quantite" placeholder="Ex: 20" required>
                                </div>
                            </div>

                            <div class="mt-3">
                                <label for="panelDescription">Description</label>
                                <textarea class="form-control" id="panelDescription" name="description" placeholder="Décris ton produit..."></textarea>
                            </div>

                            <div class="mt-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="panelDisponible" name="disponible" checked>
                                    <label class="form-check-label" for="panelDisponible">
                                        Produit visible / disponible
                                    </label>
                                </div>
                            </div>
                            <div class="product-section mt-4">
    <div class="product-section-head">Bundle / Offre</div>
    <div class="product-section-content">
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="panelBundleActive" name="bundle_active">
            <label class="form-check-label" for="panelBundleActive">
                Activer une offre bundle
            </label>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <label for="panelBundleType">Type d'offre</label>
                <select id="panelBundleType" name="bundle_type" class="form-control">
                    <option value="">Aucune</option>
                    <option value="discount">Réduction %</option>
                    <option value="bxgy">Buy X Pay Y</option>
                </select>
            </div>

            <div class="col-md-4">
                <label for="panelBundleDiscount">Réduction (%)</label>
                <input type="number" id="panelBundleDiscount" name="bundle_discount_percent" class="form-control" min="0" max="100" placeholder="Ex: 10">
            </div>

            <div class="col-md-2">
                <label for="panelBundleBuy">Acheter X</label>
                <input type="number" id="panelBundleBuy" name="bundle_buy_qty" class="form-control" min="1" placeholder="Ex: 4">
            </div>

            <div class="col-md-2">
                <label for="panelBundlePay">Payer Y</label>
                <input type="number" id="panelBundlePay" name="bundle_pay_qty" class="form-control" min="1" placeholder="Ex: 3">
            </div>
        </div>

        <div class="form-small-note">
            Exemple :<br>
            - Réduction % → acheter 2 = -10%<br>
            - Buy X Pay Y → acheter 4 payer 3
        </div>
    </div>
</div>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="save-panel-btn" id="productPanelSubmitBtn">
    <i class="fas fa-save"></i> Save Product
</button>
        </form>
    </div>
</div>

<div id="aiImagePanelOverlay" class="product-panel-overlay" onclick="closeAiImagePanel()"></div>

<div id="aiImagePanel" class="product-panel">
    <div class="product-panel-header">
        <h3 class="product-panel-title">AI Image Edit</h3>
        <button type="button" class="product-panel-close" onclick="closeAiImagePanel()">✕</button>
    </div>

    <div class="product-panel-body">
        <div id="aiPanelAlert" class="alert panel-alert"></div>

        <form id="aiImageForm">
            <input type="hidden" id="aiProductId" name="id" value="">

            <div class="product-section">
                <div class="product-section-head">Produit sélectionné</div>
                <div class="product-section-content">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="aiProductName">Nom du produit</label>
                            <input type="text" id="aiProductName" class="form-control" readonly>
                        </div>

                        <div class="col-md-6">
                            <label for="aiAction">Action</label>
                            <select id="aiAction" name="action" class="form-control">
                                <option value="remove_background">Supprimer le fond</option>
                                <option value="replace_background">Remplacer le fond avec prompt</option>
                            </select>
                        </div>

                        <div class="col-12" id="aiPromptWrap" style="display:none;">
                            <label for="aiPrompt">Prompt</label>
                            <input
                                type="text"
                                id="aiPrompt"
                                name="prompt"
                                class="form-control"
                                placeholder="Ex: a clean luxury kitchen with soft warm light"
                            >
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="aiApplyToProduct" name="apply_to_product" checked>
                                <label class="form-check-label" for="aiApplyToProduct">
                                    Remplacer directement l'image du produit après génération
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="product-section">
                <div class="product-section-head">Prévisualisation</div>
                <div class="product-section-content">
                    <div class="ai-image-grid">
                        <div class="ai-image-card">
                            <h5>Image actuelle</h5>
                            <div class="ai-image-stage">
                                <img id="aiSourcePreview" src="" alt="Source preview">
                                <div id="aiSourcePlaceholder" class="ai-image-placeholder" style="display:none;">
                                    Ce produit n'a pas encore d'image.
                                </div>
                            </div>
                        </div>

                        <div class="ai-image-card">
                            <h5>Résultat IA</h5>
                            <div class="ai-image-stage">
                                <img id="aiResultPreview" src="" alt="AI result" style="display:none;">
                                <div id="aiResultPlaceholder" class="ai-image-placeholder">
                                    Lance une génération pour voir le résultat ici.
                                </div>
                            </div>
                            <div class="ai-result-link">
                                <a id="aiResultLink" href="#" target="_blank" style="display:none;">Ouvrir l'image générée</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ai-panel-actions">
                <button type="submit" class="save-panel-btn" id="aiPanelSubmitBtn">
                    <i class="fas fa-wand-magic-sparkles"></i> Generate with AI
                </button>
            </div>
        </form>
    </div>
</div>

<div id="customThemeOverlay" class="product-panel-overlay" onclick="closeCustomThemeBuilder()"></div>

<div id="customThemePanel" class="product-panel">
    <div class="product-panel-header">
        <h3 class="product-panel-title">Custom Theme Builder</h3>
        <button type="button" class="product-panel-close" onclick="closeCustomThemeBuilder()">✕</button>
    </div>

    <div class="product-panel-body">
        <div id="customThemeAlert" class="alert panel-alert"></div>

        <div class="custom-builder-layout">
            <div class="custom-builder-left">
                <div class="product-section">
                    <div class="product-section-head">Preview</div>
                    <div class="product-section-content">
                        <div id="customThemePreview" class="custom-theme-preview"></div>
                    </div>
                </div>
            </div>

            <div class="custom-builder-right">
                <div class="product-section">
                    <div class="product-section-head">Choisis l'ordre des blocs</div>
                    <div class="product-section-content">
                        <p class="form-small-note" style="margin-bottom:14px;">
                            Glisse-dépose les sections pour décider ce qui apparaît en premier sur la page produit.
                        </p>

                        <div id="builderBlocks" class="builder-blocks">
                            {% set order = customThemeConfig.order|default(['hero', 'featured', 'bundles', 'testimonials', 'cta']) %}
                            {% for block in order %}
                                {% set label = '' %}
                                {% if block == 'hero' %}
                                    {% set label = 'Hero principal' %}
                                {% elseif block == 'featured' %}
                                    {% set label = 'Produits mis en avant' %}
                                {% elseif block == 'bundles' %}
                                    {% set label = 'Bundles / Offres' %}
                                {% elseif block == 'testimonials' %}
                                    {% set label = 'Avis clients' %}
                                {% elseif block == 'cta' %}
                                    {% set label = 'Call To Action' %}
                                {% else %}
                                    {% set label = block %}
                                {% endif %}

                                <div class="builder-item" draggable="true" data-key="{{ block }}">
                                    <i class="fas fa-grip-vertical"></i>
                                    <span>{{ label }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="product-section">
                    <div class="product-section-head">Réglages rapides</div>
                    <div class="product-section-content">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="customThemeTitle">Titre du thème</label>
                                <input
                                    type="text"
                                    id="customThemeTitle"
                                    class="form-control"
                                    placeholder="Ex: My custom layout"
                                    value="{{ customThemeConfig.title|default('My custom layout') }}"
                                >
                            </div>

                            <div class="col-md-6">
                                <label for="customThemeStyle">Style principal</label>
                                <select id="customThemeStyle" class="form-control">
                                    <option value="premium" {% if customThemeConfig.style|default('premium') == 'premium' %}selected{% endif %}>Premium</option>
                                    <option value="clean" {% if customThemeConfig.style|default('premium') == 'clean' %}selected{% endif %}>Clean</option>
                                    <option value="conversion" {% if customThemeConfig.style|default('premium') == 'conversion' %}selected{% endif %}>Conversion</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check mt-4">
                                    <input class="form-check-input" type="checkbox" id="customShowBundles" {% if customThemeConfig.showBundles|default(true) %}checked{% endif %}>
                                    <label class="form-check-label" for="customShowBundles">Afficher bundles</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check mt-4">
                                    <input class="form-check-input" type="checkbox" id="customShowTestimonials" {% if customThemeConfig.showTestimonials|default(true) %}checked{% endif %}>
                                    <label class="form-check-label" for="customShowTestimonials">Afficher avis</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="custom-theme-save-wrap">
                    <button type="button" class="save-panel-btn" onclick="saveCustomTheme()">
                        <i class="fas fa-save"></i> Save Custom Theme
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let productPanelMode = 'create';

function resetProductPanel() {
    productPanelMode = 'create';

    document.getElementById('productPanelTitle').textContent = 'Create a product';
    document.getElementById('productPanelSubmitBtn').innerHTML = '<i class="fas fa-save"></i> Save Product';

    document.getElementById('panelProductId').value = '';
    document.getElementById('panelNom').value = '';
    document.getElementById('panelPrix').value = '';
    document.getElementById('panelQuantite').value = '';
    document.getElementById('panelDescription').value = '';
    document.getElementById('panelDisponible').checked = true;
    document.getElementById('productPhotoInput').value = '';
    document.getElementById('panelBundleActive').checked = false;
document.getElementById('panelBundleType').value = '';
document.getElementById('panelBundleBuy').value = '';
document.getElementById('panelBundlePay').value = '';
document.getElementById('panelBundleDiscount').value = '';

    const uploadPreview = document.getElementById('uploadPreview');
    const uploadPlaceholder = document.getElementById('uploadPlaceholder');

    uploadPreview.style.display = 'none';
    uploadPreview.src = '';
    uploadPlaceholder.style.display = 'block';

    const alertBox = document.getElementById('productPanelAlert');
    alertBox.style.display = 'none';
    alertBox.className = 'alert panel-alert';
    alertBox.textContent = '';
}

function openProductPanel() {
    resetProductPanel();
    document.getElementById('productPanel').classList.add('open');
    document.getElementById('productPanelOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}

function openEditProductPanel(
    id,
    nom,
    prix,
    quantite,
    description,
    disponible,
    photo,
    bundleActive,
    bundleType,
    bundleBuy,
    bundlePay,
    bundleDiscount
) {
    resetProductPanel();
    productPanelMode = 'edit';

    document.getElementById('productPanelTitle').textContent = 'Modifier le produit';
    document.getElementById('productPanelSubmitBtn').innerHTML = '<i class="fas fa-save"></i> Update Product';

    document.getElementById('panelProductId').value = id;
    document.getElementById('panelNom').value = nom;
    document.getElementById('panelPrix').value = prix;
    document.getElementById('panelQuantite').value = quantite;
    document.getElementById('panelDescription').value = description;
    document.getElementById('panelDisponible').checked = disponible == 1;

    document.getElementById('panelBundleActive').checked = bundleActive == 1;
    document.getElementById('panelBundleType').value = bundleType || '';
    document.getElementById('panelBundleBuy').value = bundleBuy || '';
    document.getElementById('panelBundlePay').value = bundlePay || '';
    document.getElementById('panelBundleDiscount').value = bundleDiscount || '';

    const uploadPreview = document.getElementById('uploadPreview');
    const uploadPlaceholder = document.getElementById('uploadPlaceholder');

    if (photo) {
        uploadPreview.src = photo;
        uploadPreview.style.display = 'block';
        uploadPlaceholder.style.display = 'none';
    }

    document.getElementById('productPanel').classList.add('open');
    document.getElementById('productPanelOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeProductPanel() {
    document.getElementById('productPanel').classList.remove('open');
    document.getElementById('productPanelOverlay').classList.remove('open');
    document.body.style.overflow = '';
}

function resetAiImagePanel() {
    document.getElementById('aiProductId').value = '';
    document.getElementById('aiProductName').value = '';
    document.getElementById('aiAction').value = 'remove_background';
    document.getElementById('aiPrompt').value = '';
    document.getElementById('aiApplyToProduct').checked = true;

    const sourcePreview = document.getElementById('aiSourcePreview');
    const sourcePlaceholder = document.getElementById('aiSourcePlaceholder');
    const resultPreview = document.getElementById('aiResultPreview');
    const resultPlaceholder = document.getElementById('aiResultPlaceholder');
    const resultLink = document.getElementById('aiResultLink');
    const alertBox = document.getElementById('aiPanelAlert');

    sourcePreview.src = '';
    sourcePreview.style.display = 'none';
    sourcePlaceholder.style.display = 'none';

    resultPreview.src = '';
    resultPreview.style.display = 'none';
    resultPlaceholder.style.display = 'block';
    resultLink.style.display = 'none';
    resultLink.href = '#';

    alertBox.style.display = 'none';
    alertBox.className = 'alert panel-alert';

    toggleAiPrompt();
}

function openAiImagePanel(id, nom, photo) {
    resetAiImagePanel();

    document.getElementById('aiProductId').value = id;
    document.getElementById('aiProductName').value = nom;

    const sourcePreview = document.getElementById('aiSourcePreview');
    const sourcePlaceholder = document.getElementById('aiSourcePlaceholder');

    if (photo) {
        sourcePreview.src = photo;
        sourcePreview.style.display = 'block';
        sourcePlaceholder.style.display = 'none';
    } else {
        sourcePreview.style.display = 'none';
        sourcePlaceholder.style.display = 'block';
    }

    document.getElementById('aiImagePanel').classList.add('open');
    document.getElementById('aiImagePanelOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeAiImagePanel() {
    document.getElementById('aiImagePanel').classList.remove('open');
    document.getElementById('aiImagePanelOverlay').classList.remove('open');
    document.body.style.overflow = '';
}

function toggleAiPrompt() {
    const action = document.getElementById('aiAction').value;
    document.getElementById('aiPromptWrap').style.display = action === 'replace_background' ? 'block' : 'none';
}

const photoInput = document.getElementById('productPhotoInput');
const uploadPreview = document.getElementById('uploadPreview');
const uploadPlaceholder = document.getElementById('uploadPlaceholder');

if (photoInput) {
    photoInput.addEventListener('change', function () {
        const file = this.files && this.files[0];

        if (!file) {
            if (!uploadPreview.src) {
                uploadPreview.style.display = 'none';
                uploadPlaceholder.style.display = 'block';
            }
            return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            uploadPreview.src = e.target.result;
            uploadPreview.style.display = 'block';
            uploadPlaceholder.style.display = 'none';
        };
        reader.readAsDataURL(file);
    });
}

const productForm = document.getElementById('productForm');
const productPanelAlert = document.getElementById('productPanelAlert');
const aiImageForm = document.getElementById('aiImageForm');

if (productForm) {
    productForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        const formData = new FormData(productForm);
        const url = productPanelMode === 'edit'
            ? '{{ path('app_admin_produit_ajax_update') }}'
            : '{{ path('app_admin_produit_ajax') }}';

        productPanelAlert.style.display = 'none';
        productPanelAlert.className = 'alert panel-alert';

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (!response.ok || !data.success) {
                productPanelAlert.style.display = 'block';
                productPanelAlert.classList.add('alert-danger');
                productPanelAlert.textContent = data.message || 'Erreur.';
                return;
            }

            productPanelAlert.style.display = 'block';
            productPanelAlert.classList.add('alert-success');
            productPanelAlert.textContent = data.message || 'Succès.';

            setTimeout(() => {
                window.location.reload();
            }, 700);
        } catch (error) {
            productPanelAlert.style.display = 'block';
            productPanelAlert.classList.add('alert-danger');
            productPanelAlert.textContent = 'Erreur réseau ou serveur.';
        }
    });
}

document.getElementById('aiAction')?.addEventListener('change', toggleAiPrompt);

if (aiImageForm) {
    aiImageForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        const alertBox = document.getElementById('aiPanelAlert');
        const resultPreview = document.getElementById('aiResultPreview');
        const resultPlaceholder = document.getElementById('aiResultPlaceholder');
        const resultLink = document.getElementById('aiResultLink');
        const submitBtn = document.getElementById('aiPanelSubmitBtn');
        const formData = new FormData(aiImageForm);

        if (!document.getElementById('aiApplyToProduct').checked) {
            formData.set('apply_to_product', '0');
        }

        alertBox.style.display = 'none';
        alertBox.className = 'alert panel-alert';

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

        try {
            const response = await fetch('{{ path('app_admin_produit_ai_edit') }}', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (!response.ok || !data.success) {
                alertBox.style.display = 'block';
                alertBox.classList.add('alert-danger');
                alertBox.textContent = data.message || 'Erreur pendant la génération IA.';
                return;
            }

            const publicPath = data.result?.public_path || '';

            if (publicPath) {
                resultPreview.src = publicPath + '?v=' + Date.now();
                resultPreview.style.display = 'block';
                resultPlaceholder.style.display = 'none';
                resultLink.href = publicPath;
                resultLink.style.display = 'inline-flex';
            }

            alertBox.style.display = 'block';
            alertBox.classList.add('alert-success');
            alertBox.textContent = data.message || 'Image générée avec succès.';

            if (data.result?.updated_product_image) {
                setTimeout(() => {
                    window.location.reload();
                }, 900);
            }
        } catch (error) {
            alertBox.style.display = 'block';
            alertBox.classList.add('alert-danger');
            alertBox.textContent = 'Erreur réseau ou serveur.';
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-wand-magic-sparkles"></i> Generate with AI';
        }
    });
}

function openCustomThemeBuilder() {
    const panel = document.getElementById('customThemePanel');
    const overlay = document.getElementById('customThemeOverlay');

    panel.classList.add('open');
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';

    setTimeout(() => {
        renderCustomPreview();
    }, 50);
}

function closeCustomThemeBuilder() {
    document.getElementById('customThemePanel').classList.remove('open');
    document.getElementById('customThemeOverlay').classList.remove('open');
    document.body.style.overflow = '';
}

function getBuilderOrder() {
    return Array.from(document.querySelectorAll('#builderBlocks .builder-item')).map(item => item.dataset.key);
}

