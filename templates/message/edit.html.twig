{% extends 'base.html.twig' %}

{% block title %}{{ 'messages.edit_title'|trans }}{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">✏️ {{ 'messages.edit_title'|trans }}</h4>
        </div>
        <div class="card-body">
            <form method="post" id="editForm">
                <div class="mb-3">
                    <label class="form-label">{{ 'messages.content_label'|trans }}</label>
                    <textarea name="content" id="content" class="form-control" rows="5" required>{{ message.content }}</textarea>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_messages_conversation', {id: message.recipient.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> {{ 'common.cancel'|trans }}
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> {{ 'common.save'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('editForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const content = document.getElementById('content').value.trim();
    if (!content) {
        alert('{{ 'messages.empty_error'|trans }}');
        return;
    }
    this.submit();
});
</script>
{% endblock %}
