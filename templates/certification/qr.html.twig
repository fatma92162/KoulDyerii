{% extends 'base.html.twig' %}

{% block title %}QR Code Certification{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-center">
                    <h1 class="h3 mb-3">QR Code de certification</h1>
                    <p class="text-muted mb-4">
                        Scannez ce QR code pour ouvrir directement le PDF de votre certification.
                    </p>

                    <div class="mb-4">
                        <img id="cert-qr-img" src="{{ qrImageUrlPrimary }}" data-fallback="{{ qrImageUrlFallback }}" alt="QR Code certification" width="280" height="280" class="img-fluid border rounded p-2 bg-white">
                    </div>

                    <div class="alert alert-light text-start mb-4">
                        <div><strong>ID certificat:</strong> {{ certification.certificateId }}</div>
                        <div><strong>Formation:</strong> {{ certification.formationTitre }}</div>
                        <div><strong>Date:</strong> {{ certification.dateInscription ? certification.dateInscription|date('d/m/Y') : '-' }}</div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a href="{{ pdfUrl }}" target="_blank" rel="noopener" class="btn btn-dark">
                            Ouvrir le PDF
                        </a>
                        <a href="{{ path('app_certification_mes') }}" class="btn btn-outline-secondary">
                            Mes certifications
                        </a>
                    </div>

                    <div class="mt-4 small text-muted">
                        Si le scan ne marche pas, utilisez ce lien:
                        <a href="{{ pdfUrl }}" target="_blank" rel="noopener">{{ pdfUrl }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const qrImage = document.getElementById('cert-qr-img');
    if (!qrImage) return;

    qrImage.addEventListener('error', function () {
        const fallback = qrImage.dataset.fallback;
        if (fallback && qrImage.src !== fallback) {
            qrImage.src = fallback;
            return;
        }
        const wrapper = qrImage.parentElement;
        wrapper.innerHTML = '<div class="alert alert-warning mb-0">QR indisponible via image distante. Utilisez le lien PDF ci-dessous.</div>';
    });
});
</script>
{% endblock %}
