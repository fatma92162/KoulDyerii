{% extends 'base.html.twig' %}

{% block title %}Mes livraisons - Koul Dyeri{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<style>
    .page-header {
        background: linear-gradient(135deg, #8B0000 0%, #A52A2A 100%);
        padding: 40px 0;
        margin-bottom: 40px;
        color: white;
        text-align: center;
    }

    .livraison-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 25px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

    .livraison-card:hover {
        transform: translateY(-5px);
    }

    .livraison-header {
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #f0e6d6;
    }

    .livraison-header h5 {
        margin: 0;
        font-weight: 700;
    }

    .livraison-body {
        padding: 20px;
    }

    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-en_cours {
        background: #FF9800;
        color: white;
    }

    .status-livree {
        background: #4CAF50;
        color: white;
    }

    .status-annulee {
        background: #9E9E9E;
        color: white;
    }

    .status-en_attente {
        background: #2196F3;
        color: white;
    }

    .tracking-step {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

    .tracking-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f0e6d6;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        color: #8B0000;
    }

    .tracking-icon.active {
        background: #4CAF50;
        color: white;
    }

    .tracking-icon.current {
        background: #FF9800;
        color: white;
    }

    .tracking-content {
        flex: 1;
    }

    .btn-cancel {
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 8px 20px;
        transition: all 0.3s ease;
    }

    .btn-cancel:hover {
        background: #c82333;
        transform: translateY(-2px);
    }

    .btn-track {
        background: #8B0000;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 8px 20px;
        transition: all 0.3s ease;
    }

    .btn-track:hover {
        background: #A52A2A;
        transform: translateY(-2px);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 20px;
    }

    .empty-state i {
        font-size: 64px;
        color: #ccc;
        margin-bottom: 20px;
    }

    .livraison-map-wrapper {
        margin-top: 15px;
    }

    .livraison-map-title {
        font-weight: 700;
        color: #8B0000;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .livraison-map {
        height: 280px;
        width: 100%;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #f0e6d6;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

    .map-loading {
        font-size: 14px;
        color: #666;
        margin-top: 8px;
    }

    .smart-route-box {
        margin-top: 14px;
        background: linear-gradient(135deg, #fff8f5 0%, #fff 100%);
        border: 1px solid #f3d6c9;
        border-radius: 16px;
        padding: 14px;
        box-shadow: 0 5px 16px rgba(139, 0, 0, 0.06);
    }

    .smart-route-title {
        font-weight: 700;
        color: #8B0000;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .smart-route-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }

    .smart-stat {
        background: #fff;
        border-radius: 12px;
        padding: 10px;
        border: 1px solid #f2e5db;
    }

    .smart-stat-label {
        font-size: 12px;
        color: #777;
        margin-bottom: 4px;
    }

    .smart-stat-value {
        font-weight: 700;
        color: #222;
    }

    .smart-ai-message {
        margin-top: 10px;
        font-size: 14px;
        color: #444;
        background: #fff;
        padding: 10px 12px;
        border-radius: 12px;
        border-left: 4px solid #8B0000;
    }

    .smart-badge {
        display: inline-block;
        margin-top: 8px;
        background: #8B0000;
        color: white;
        padding: 6px 12px;
        font-size: 12px;
        border-radius: 999px;
        font-weight: 600;
    }

    .call-notice {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 10000;
        display: none;
    }

    .call-notice-pill {
        background: #f0fff4;
        border: 1px solid #b9ebc9;
        color: #14733c;
        border-radius: 999px;
        padding: 10px 16px;
        font-weight: 800;
        box-shadow: 0 12px 26px rgba(0, 0, 0, 0.15);
    }

    .incoming-call-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 10001;
        align-items: center;
        justify-content: center;
        padding: 18px;
    }

    .incoming-call-modal {
        width: min(460px, 94vw);
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
    }

    .incoming-call-head {
        background: linear-gradient(135deg, #8B0000 0%, #B22222 100%);
        color: #fff;
        padding: 22px;
        text-align: center;
    }

    .incoming-call-head h4 {
        margin: 0;
        font-size: 24px;
        font-weight: 900;
    }

    .incoming-call-body {
        padding: 22px;
        text-align: center;
    }

    .incoming-call-state {
        font-size: 20px;
        font-weight: 900;
        color: #083b4c;
        margin-bottom: 10px;
    }

    .incoming-call-copy {
        color: #5f5f5f;
        margin-bottom: 18px;
    }

    .incoming-call-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }
</style>
{% endblock %}



{% block body %}
<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-truck"></i> Mes livraisons</h1>
        <p class="mb-0">Suivez l'état de vos livraisons en temps réel</p>
    </div>
</div>

<div class="container mb-5">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('info') %}
        <div class="alert alert-info alert-dismissible fade show">
            <i class="fas fa-info-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% if livraisons|length > 0 %}
        {% for livraison in livraisons %}
        <div class="livraison-card" data-livraison-id="{{ livraison.idLivraison }}" data-livraison-status="{{ livraison.statutLivraison }}">
            <div class="livraison-header">
                <h5>Livraison #{{ livraison.idLivraison }}</h5>
                <span class="status-badge status-{{ livraison.statutLivraison }}">
                    {% if livraison.statutLivraison == 'en_cours' %}
                        🚚 En cours
                    {% elseif livraison.statutLivraison == 'livree' %}
                        ✅ Livrée
                    {% elseif livraison.statutLivraison == 'annulee' %}
                        ❌ Annulée
                    {% else %}
                        ⏳ En attente
                    {% endif %}
                </span>
            </div>

            <div class="livraison-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>📦 Commande #{{ livraison.commande.id }}</strong></p>
                        <p><strong>📍 Adresse de livraison :</strong> {{ livraison.adresse }}</p>
                        <p><strong>📅 Date de commande :</strong> {{ livraison.commande.createdAt|date('d/m/Y H:i') }}</p>

                        {% if livraison.livreur %}
                            <p><strong>👨‍💼 Livreur :</strong> {{ livraison.livreur.prenom }} {{ livraison.livreur.nom }}</p>
                            <p><strong>📞 Téléphone livreur :</strong> {{ livraison.livreur.telephone }}</p>
                        {% endif %}

                        <div class="livraison-map-wrapper">
                            <div class="livraison-map-title">
                                <i class="fas fa-map-marker-alt"></i>
                                Smart Map de la livraison
                            </div>

                            <div
                                id="map-{{ livraison.idLivraison }}"
                                class="livraison-map"
                                data-address="{{ livraison.adresse|e('html_attr') }}"
                            ></div>

                            <div id="map-status-{{ livraison.idLivraison }}" class="map-loading">
                                Chargement de la carte intelligente...
                            </div>

                            <div class="smart-route-box" id="smart-box-{{ livraison.idLivraison }}">
                                <div class="smart-route-title">
                                    <i class="fas fa-route"></i>
                                    Suggestion intelligente de trajet
                                </div>

                                <div class="smart-route-grid">
                                    <div class="smart-stat">
                                        <div class="smart-stat-label">Distance</div>
                                        <div class="smart-stat-value" id="distance-{{ livraison.idLivraison }}">--</div>
                                    </div>
                                    <div class="smart-stat">
                                        <div class="smart-stat-label">Durée estimée</div>
                                        <div class="smart-stat-value" id="duration-{{ livraison.idLivraison }}">--</div>
                                    </div>
                                    <div class="smart-stat">
                                        <div class="smart-stat-label">Niveau trafic</div>
                                        <div class="smart-stat-value" id="traffic-{{ livraison.idLivraison }}">--</div>
                                    </div>
                                </div>

                                <div class="smart-ai-message" id="ai-message-{{ livraison.idLivraison }}">
                                    Analyse du meilleur trajet en cours...
                                </div>

                                <span class="smart-badge">AI Route Suggestion</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="tracking-step">
                            <div class="tracking-icon {% if livraison.statutLivraison != 'annulee' %}active{% endif %}">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="tracking-content">
                                <strong>Commande validée</strong>
                                <small class="text-muted d-block">Votre commande a été acceptée</small>
                            </div>
                        </div>

                        <div class="tracking-step">
                            <div class="tracking-icon {% if livraison.statutLivraison == 'en_cours' %}current{% endif %}">
                                <i class="fas fa-truck"></i>
                            </div>
                            <div class="tracking-content">
                                <strong>En cours de livraison</strong>
                                <small class="text-muted d-block">Votre colis est en route</small>
                            </div>
                        </div>

                        <div class="tracking-step">
                            <div class="tracking-icon {% if livraison.statutLivraison == 'livree' %}active{% endif %}">
                                <i class="fas fa-home"></i>
                            </div>
                            <div class="tracking-content">
                                <strong>Livrée</strong>
                                <small class="text-muted d-block">Votre colis a été livré</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 text-end">
                    <a href="{{ path('app_client_livraison_commande', {id: livraison.commande.id}) }}" class="btn btn-track">
                        <i class="fas fa-eye"></i> Voir les détails
                    </a>

                    {% if livraison.statutLivraison == 'en_cours' %}
                        <form action="{{ path('app_client_livraison_annuler', {id: livraison.idLivraison}) }}" method="post" style="display: inline-block;">
                            <button type="submit" class="btn btn-cancel" onclick="return confirm('Annuler cette livraison ?')">
                                <i class="fas fa-times"></i> Annuler la livraison
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    {% else %}
        <div class="empty-state">
            <i class="fas fa-truck"></i>
            <h4>Aucune livraison trouvée</h4>
            <p class="text-muted">Vous n'avez pas encore de livraisons en cours.</p>
            <a href="{{ path('app_produits_index') }}" class="btn btn-primary">
                <i class="fas fa-store"></i> Découvrir nos produits
            </a>
        </div>
    {% endif %}
</div>
<div class="call-notice" id="clientCallNotice">
    <div class="call-notice-pill" id="clientCallNoticeText">Appel en cours</div>
</div>

<div id="incomingCallOverlay" class="incoming-call-overlay">
    <div class="incoming-call-modal">
        <div class="incoming-call-head">
            <h4><i class="fas fa-phone-volume"></i> Appel entrant</h4>
        </div>

        <div class="incoming-call-body">
            <div class="incoming-call-state" id="incomingCallState">Le livreur vous appelle</div>
            <div class="incoming-call-copy" id="incomingCallCopy">Accepter ou refuser l'appel directement dans l'application.</div>
            <div class="call-notice-pill" id="clientCallTimer" style="display:inline-block; margin-bottom:18px;">00:00</div>

            <div class="incoming-call-actions">
                <button type="button" class="btn btn-track" id="acceptIncomingCallBtn" onclick="acceptIncomingListCall()">
                    <i class="fas fa-phone"></i> Accepter
                </button>

                <button type="button" class="btn btn-cancel" id="declineIncomingCallBtn" onclick="declineIncomingListCall()">
                    <i class="fas fa-phone-slash"></i> Refuser
                </button>

                <button type="button" class="btn btn-track" id="endIncomingCallBtn" onclick="hangupClientListCall()" style="display:none;">
                    <i class="fas fa-xmark"></i> Terminer
                </button>
            </div>

            <audio id="clientRemoteAudio" autoplay></audio>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
const activeLivraisonIds = [
    {% set firstActiveLivraison = true %}
    {% for livraison in livraisons %}
        {% if livraison.statutLivraison == 'en_cours' %}
            {% if not firstActiveLivraison %},{% endif %}{{ livraison.idLivraison }}
            {% set firstActiveLivraison = false %}
        {% endif %}
    {% endfor %}
];

const clientRtcConfig = {
    iceServers: [
        { urls: 'stun:stun.l.google.com:19302' }
    ]
};

const listPageCallState = {
    pc: null,
    localStream: null,
    pollTimer: null,
    currentOffer: null,
    currentLivraisonId: null,
    active: false,
    isPolling: false,
    callStartedAt: null,
    timerInterval: null,
    ringtoneInterval: null,
    audioContext: null,
};

function setIncomingCallState(title, copy) {
    const titleEl = document.getElementById('incomingCallState');
    const copyEl = document.getElementById('incomingCallCopy');

    if (titleEl) {
        titleEl.textContent = title;
    }

    if (copyEl) {
        copyEl.textContent = copy;
    }
}

function toggleClientCallNotice(show, text = 'Appel en cours') {
    const wrap = document.getElementById('clientCallNotice');
    const label = document.getElementById('clientCallNoticeText');

    if (label) {
        label.textContent = text;
    }

    if (wrap) {
        wrap.style.display = show ? 'block' : 'none';
    }
}

function formatCallTimer(totalSeconds) {
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;

    if (hours > 0) {
        return String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
    }

    return String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
}

function updateClientCallTimerDisplay() {
    const el = document.getElementById('clientCallTimer');
    if (!el) {
        return;
    }

    if (!listPageCallState.callStartedAt) {
        el.textContent = '00:00';
        return;
    }

    const totalSeconds = Math.max(0, Math.floor((Date.now() - listPageCallState.callStartedAt) / 1000));
    el.textContent = formatCallTimer(totalSeconds);
}

function startClientCallTimer() {
    if (listPageCallState.callStartedAt) {
        return;
    }

    listPageCallState.callStartedAt = Date.now();
    updateClientCallTimerDisplay();

    if (listPageCallState.timerInterval) {
        window.clearInterval(listPageCallState.timerInterval);
    }

    listPageCallState.timerInterval = window.setInterval(updateClientCallTimerDisplay, 1000);
}

function stopClientCallTimer() {
    if (listPageCallState.timerInterval) {
        window.clearInterval(listPageCallState.timerInterval);
        listPageCallState.timerInterval = null;
    }

    listPageCallState.callStartedAt = null;
    updateClientCallTimerDisplay();
}

function playRingtoneBurst() {
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextClass) {
        return;
    }

    if (!listPageCallState.audioContext) {
        listPageCallState.audioContext = new AudioContextClass();
    }

    const ctx = listPageCallState.audioContext;
    if (ctx.state === 'suspended') {
        ctx.resume().catch(() => {});
    }

    const now = ctx.currentTime;
    const notes = [
        { freq: 659.25, start: 0, duration: 0.16 },
        { freq: 880.0, start: 0.22, duration: 0.16 },
        { freq: 987.77, start: 0.44, duration: 0.3 }
    ];

    notes.forEach(note => {
        const oscillator = ctx.createOscillator();
        const gain = ctx.createGain();

        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(note.freq, now + note.start);

        gain.gain.setValueAtTime(0.0001, now + note.start);
        gain.gain.exponentialRampToValueAtTime(0.08, now + note.start + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + note.start + note.duration);

        oscillator.connect(gain);
        gain.connect(ctx.destination);

        oscillator.start(now + note.start);
        oscillator.stop(now + note.start + note.duration + 0.05);
    });
}

function startIncomingRingtone() {
    if (listPageCallState.ringtoneInterval) {
        return;
    }

    playRingtoneBurst();
    listPageCallState.ringtoneInterval = window.setInterval(playRingtoneBurst, 1600);
}

function stopIncomingRingtone() {
    if (listPageCallState.ringtoneInterval) {
        window.clearInterval(listPageCallState.ringtoneInterval);
        listPageCallState.ringtoneInterval = null;
    }
}

function showIncomingCallOverlay() {
    const overlay = document.getElementById('incomingCallOverlay');
    if (overlay) {
        overlay.style.display = 'flex';
    }
}

function hideIncomingCallOverlay() {
    const overlay = document.getElementById('incomingCallOverlay');
    if (overlay) {
        overlay.style.display = 'none';
    }
}

async function clientWaitForIceGatheringComplete(pc) {
    if (pc.iceGatheringState === 'complete') {
        return;
    }

    await new Promise(resolve => {
        const onChange = () => {
            if (pc.iceGatheringState === 'complete') {
                pc.removeEventListener('icegatheringstatechange', onChange);
                resolve();
            }
        };

        pc.addEventListener('icegatheringstatechange', onChange);
    });
}

async function fetchCallSession(livraisonId) {
    const response = await fetch('{{ path('app_delivery_call_poll', {id: 0}) }}'.replace('/0/', '/' + livraisonId + '/') + '?role=client');
    const data = await response.json();

    if (!response.ok || !data.success) {
        return null;
    }

    return data.session || null;
}

async function pollClientListCallState() {
    if (listPageCallState.isPolling || activeLivraisonIds.length === 0) {
        return;
    }

    listPageCallState.isPolling = true;

    try {
        const livraisonIdsToCheck = listPageCallState.currentLivraisonId
            ? [listPageCallState.currentLivraisonId]
            : activeLivraisonIds;

        for (const livraisonId of livraisonIdsToCheck) {
            const session = await fetchCallSession(livraisonId);
            if (!session) {
                continue;
            }

            const status = session.status || 'idle';

            if (status === 'ringing' && session.offer && !listPageCallState.active) {
                listPageCallState.currentLivraisonId = livraisonId;
                listPageCallState.currentOffer = session.offer;
                setIncomingCallState(
                    'Le livreur vous appelle',
                    'Livraison #' + livraisonId + ' : acceptez ou refusez l appel directement dans l application.'
                );
                document.getElementById('acceptIncomingCallBtn').style.display = 'inline-block';
                document.getElementById('declineIncomingCallBtn').style.display = 'inline-block';
                document.getElementById('endIncomingCallBtn').style.display = 'none';
                stopClientCallTimer();
                startIncomingRingtone();
                showIncomingCallOverlay();
                break;
            }

            if (listPageCallState.currentLivraisonId === livraisonId) {
                if (status === 'declined') {
                    setIncomingCallState('Appel refuse', 'L appel a ete refuse ou annule.');
                    stopIncomingRingtone();
                    cleanupClientListCall();
                    hideIncomingCallOverlay();
                    toggleClientCallNotice(false);
                } else if (status === 'accepted' && listPageCallState.active) {
                    toggleClientCallNotice(true, 'Appel en cours avec le livreur');
                } else if (status === 'ended') {
                    setIncomingCallState('Appel termine', 'Le livreur a raccroche.');
                    stopIncomingRingtone();
                    cleanupClientListCall();
                    hideIncomingCallOverlay();
                    toggleClientCallNotice(false);
                }
            }
        }
    } catch (error) {
    } finally {
        listPageCallState.isPolling = false;
    }
}

async function acceptIncomingListCall() {
    if (!listPageCallState.currentLivraisonId || !listPageCallState.currentOffer) {
        return;
    }

    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        const pc = new RTCPeerConnection(clientRtcConfig);
        const remoteAudio = document.getElementById('clientRemoteAudio');

        stream.getTracks().forEach(track => pc.addTrack(track, stream));

        pc.ontrack = (event) => {
            if (event.streams && event.streams[0]) {
                remoteAudio.srcObject = event.streams[0];
            }
        };

        pc.onconnectionstatechange = () => {
            if (pc.connectionState === 'connected') {
                setIncomingCallState('En communication', 'Vous etes maintenant en appel avec le livreur.');
                toggleClientCallNotice(true, 'Appel en cours avec le livreur');
                startClientCallTimer();
            } else if (['failed', 'disconnected'].includes(pc.connectionState)) {
                setIncomingCallState('Connexion interrompue', 'Le signal audio a ete coupe.');
            }
        };

        await pc.setRemoteDescription(listPageCallState.currentOffer);
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        await clientWaitForIceGatheringComplete(pc);

        const response = await fetch('{{ path('app_delivery_call_accept', {id: 0}) }}'.replace('/0/', '/' + listPageCallState.currentLivraisonId + '/'), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                answer: pc.localDescription
            })
        });

        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.message || 'Impossible d accepter l appel.');
        }

        listPageCallState.pc = pc;
        listPageCallState.localStream = stream;
        listPageCallState.active = true;
        stopIncomingRingtone();

        document.getElementById('acceptIncomingCallBtn').style.display = 'none';
        document.getElementById('declineIncomingCallBtn').style.display = 'none';
        document.getElementById('endIncomingCallBtn').style.display = 'inline-block';

        setIncomingCallState('En communication', 'Vous etes maintenant en appel avec le livreur.');
        toggleClientCallNotice(true, 'Appel en cours avec le livreur');
        startClientCallTimer();
    } catch (error) {
        stopIncomingRingtone();
        setIncomingCallState('Erreur', error.message || 'Impossible d accepter l appel.');
    }
}

async function declineIncomingListCall() {
    if (!listPageCallState.currentLivraisonId) {
        return;
    }

    try {
        await fetch('{{ path('app_delivery_call_decline', {id: 0}) }}'.replace('/0/', '/' + listPageCallState.currentLivraisonId + '/'), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                reason: 'declined_by_client'
            })
        });
    } catch (error) {
    }

    stopIncomingRingtone();
    cleanupClientListCall();
    hideIncomingCallOverlay();
    toggleClientCallNotice(false);
}

async function hangupClientListCall() {
    if (!listPageCallState.currentLivraisonId) {
        return;
    }

    try {
        await fetch('{{ path('app_delivery_call_hangup', {id: 0}) }}'.replace('/0/', '/' + listPageCallState.currentLivraisonId + '/'), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                role: 'client'
            })
        });
    } catch (error) {
    }

    stopIncomingRingtone();
    cleanupClientListCall();
    hideIncomingCallOverlay();
    toggleClientCallNotice(false);
}

function cleanupClientListCall(resetOffer = true) {
    if (listPageCallState.pc) {
        try {
            listPageCallState.pc.close();
        } catch (error) {
        }
        listPageCallState.pc = null;
    }

    if (listPageCallState.localStream) {
        listPageCallState.localStream.getTracks().forEach(track => track.stop());
        listPageCallState.localStream = null;
    }

    if (resetOffer) {
        listPageCallState.currentOffer = null;
        listPageCallState.currentLivraisonId = null;
    }

    listPageCallState.active = false;
    stopClientCallTimer();
    stopIncomingRingtone();

    const remoteAudio = document.getElementById('clientRemoteAudio');
    if (remoteAudio) {
        remoteAudio.srcObject = null;
    }
}

document.addEventListener('DOMContentLoaded', function () {
    const defaultLat = 36.8065;
    const defaultLng = 10.1815;

    function formatDuration(minutes) {
        if (minutes < 60) {
            return Math.round(minutes) + ' min';
        }
        const h = Math.floor(minutes / 60);
        const m = Math.round(minutes % 60);
        return h + 'h ' + m + ' min';
    }

    function getTrafficLevel(durationMinutes) {
        if (durationMinutes <= 15) return 'Faible';
        if (durationMinutes <= 30) return 'Moyen';
        return 'Dense';
    }

    function getSmartMessage(durationMinutes, distanceKm) {
        if (durationMinutes <= 15) {
            return '🚀 Livreur localisé à proximité. Arrivée estimée dans ' + formatDuration(durationMinutes) + '.';
        }
        if (durationMinutes <= 30) {
            return '🧠 Trajet simulé optimisé de ' + distanceKm.toFixed(1) + ' km. Arrivée estimée dans ' + formatDuration(durationMinutes) + '.';
        }
        return '⚠️ Le livreur vient d’une zone un peu plus éloignée. Le trajet simulé le plus stable a été choisi avec une arrivée estimée dans ' + formatDuration(durationMinutes) + '.';
    }

    function generateNearbyPoint(lat, lng) {
        const radius = 0.05;
        const angle = Math.random() * Math.PI * 2;
        const distance = Math.random() * radius;

        return {
            lat: lat + Math.cos(angle) * distance,
            lng: lng + Math.sin(angle) * distance
        };
    }

    function haversineDistance(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;

        const a =
            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);

        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return R * c;
    }

    function buildFakeRoute(fromLat, fromLng, toLat, toLng) {
        const points = [];
        const steps = 30;

        const midLat = (fromLat + toLat) / 2;
        const midLng = (fromLng + toLng) / 2;

        const curveLatOffset = (Math.random() > 0.5 ? 1 : -1) * 0.012;
        const curveLngOffset = (Math.random() > 0.5 ? 1 : -1) * 0.012;

        for (let i = 0; i <= steps; i++) {
            const t = i / steps;

            const lat =
                Math.pow(1 - t, 2) * fromLat +
                2 * (1 - t) * t * (midLat + curveLatOffset) +
                Math.pow(t, 2) * toLat;

            const lng =
                Math.pow(1 - t, 2) * fromLng +
                2 * (1 - t) * t * (midLng + curveLngOffset) +
                Math.pow(t, 2) * toLng;

            points.push([lat, lng]);
        }

        const directDistance = haversineDistance(fromLat, fromLng, toLat, toLng);
        const routeDistance = Math.max(2.5, directDistance * 1.35);
        const durationMinutes = Math.max(8, routeDistance * 3.8);

        return {
            coordinates: points,
            distanceKm: routeDistance,
            durationMinutes: durationMinutes
        };
    }

    async function geocodeAddress(address) {
        try {
            const query = encodeURIComponent(address + ', Tunisie');
            const response = await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + query, {
                headers: { 'Accept': 'application/json' }
            });

            const data = await response.json();

            if (data && data.length > 0) {
                return {
                    lat: parseFloat(data[0].lat),
                    lng: parseFloat(data[0].lon),
                    label: data[0].display_name || address
                };
            }
        } catch (e) {
            console.warn('Geocoding failed:', e);
        }

        return null;
    }

    function updateSmartBox(livraisonId, distanceKm, durationMinutes, trafficLevel, message) {
        const distanceElement = document.getElementById('distance-' + livraisonId);
        const durationElement = document.getElementById('duration-' + livraisonId);
        const trafficElement = document.getElementById('traffic-' + livraisonId);
        const messageElement = document.getElementById('ai-message-' + livraisonId);

        if (distanceElement) {
            distanceElement.textContent = distanceKm.toFixed(1) + ' km';
        }

        if (durationElement) {
            durationElement.textContent = formatDuration(durationMinutes);
        }

        if (trafficElement) {
            trafficElement.textContent = trafficLevel;
        }

        if (messageElement) {
            messageElement.textContent = message;
        }
    }

    async function initSmartMap(mapId, address, statusId, livraisonId, startLat, startLng) {
        const mapElement = document.getElementById(mapId);
        const statusElement = document.getElementById(statusId);

        if (!mapElement) return;

        const map = L.map(mapId).setView([defaultLat, defaultLng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        let destination = null;

        if (address && address.trim() !== '') {
            destination = await geocodeAddress(address);
        }

        if (!destination) {
            destination = {
                lat: defaultLat + ((Math.random() - 0.5) * 0.02),
                lng: defaultLng + ((Math.random() - 0.5) * 0.02),
                label: address || 'Zone de livraison'
            };

            if (statusElement) {
                statusElement.textContent = 'Adresse non trouvée. Simulation intelligente activée.';
            }
        } else {
            if (statusElement) {
                statusElement.textContent = 'Adresse localisée. Simulation du trajet du livreur activée.';
            }
        }

        let livreurPoint;

        if (startLat !== null && startLng !== null && !isNaN(startLat) && !isNaN(startLng)) {
            livreurPoint = {
                lat: parseFloat(startLat),
                lng: parseFloat(startLng)
            };
        } else {
            livreurPoint = generateNearbyPoint(destination.lat, destination.lng);
        }

        const routeData = buildFakeRoute(
            livreurPoint.lat,
            livreurPoint.lng,
            destination.lat,
            destination.lng
        );

        const destinationIcon = L.divIcon({
            className: '',
            html: `
                <div style="
                    width:18px;
                    height:18px;
                    background:#d32f2f;
                    border:3px solid white;
                    border-radius:50%;
                    box-shadow:0 0 0 3px rgba(211,47,47,0.25);
                "></div>
            `,
            iconSize: [18, 18],
            iconAnchor: [9, 9]
        });

        const livreurIcon = L.divIcon({
            className: '',
            html: `
                <div style="
                    width:24px;
                    height:24px;
                    background:#1976d2;
                    border:3px solid white;
                    border-radius:50%;
                    box-shadow:0 0 0 3px rgba(25,118,210,0.25);
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    color:white;
                    font-size:12px;
                    font-weight:bold;
                ">🚚</div>
            `,
            iconSize: [24, 24],
            iconAnchor: [12, 12]
        });

        L.marker([destination.lat, destination.lng], { icon: destinationIcon }).addTo(map)
            .bindPopup('📍 Client');

        const movingMarker = L.marker([livreurPoint.lat, livreurPoint.lng], { icon: livreurIcon }).addTo(map)
            .bindPopup('🚚 Livreur');

        L.polyline(routeData.coordinates, {
            color: '#8B0000',
            weight: 7,
            opacity: 0.95,
            lineCap: 'round',
            lineJoin: 'round',
            dashArray: '12, 10'
        }).addTo(map);

        L.circle([livreurPoint.lat, livreurPoint.lng], {
            radius: 250,
            color: '#1976d2',
            fillColor: '#1976d2',
            fillOpacity: 0.10,
            weight: 1
        }).addTo(map);

        const bounds = L.latLngBounds([
            [livreurPoint.lat, livreurPoint.lng],
            [destination.lat, destination.lng]
        ]);

        map.fitBounds(bounds, { padding: [60, 60] });

        const trafficLevel = getTrafficLevel(routeData.durationMinutes);
        const smartMessage = getSmartMessage(routeData.durationMinutes, routeData.distanceKm);

        updateSmartBox(
            livraisonId,
            routeData.distanceKm,
            routeData.durationMinutes,
            trafficLevel,
            smartMessage
        );

        let index = 0;
        function moveLivreur() {
            if (index < routeData.coordinates.length) {
                movingMarker.setLatLng(routeData.coordinates[index]);
                index++;
                setTimeout(moveLivreur, 250);
            }
        }
        moveLivreur();

        setTimeout(function () {
            map.invalidateSize();
        }, 300);
    }

    {% for livraison in livraisons %}
        initSmartMap(
            'map-{{ livraison.idLivraison }}',
            {{ livraison.adresse ? livraison.adresse|json_encode|raw : '""' }},
            'map-status-{{ livraison.idLivraison }}',
            '{{ livraison.idLivraison }}',
            {{ attribute(livraison, 'startLat') is defined and livraison.startLat is not null ? livraison.startLat : 'null' }},
            {{ attribute(livraison, 'startLng') is defined and livraison.startLng is not null ? livraison.startLng : 'null' }}
        );
    {% endfor %}

    if (activeLivraisonIds.length > 0) {
        listPageCallState.pollTimer = window.setInterval(pollClientListCallState, 2000);
        pollClientListCallState();
    }

    window.addEventListener('beforeunload', function () {
        if (listPageCallState.pollTimer) {
            window.clearInterval(listPageCallState.pollTimer);
        }
    });
});
</script>
{% endblock %}
