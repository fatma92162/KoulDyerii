{% extends 'base_admin.html.twig' %}

{% block admin_title %}Inscrits à la formation - {{ formation.titre }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .page-header {
        background: linear-gradient(135deg, #8B0000, #A52A2A);
        padding: 20px 25px;
        border-radius: 15px;
        color: white;
        margin-bottom: 25px;
    }
    
    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 15px;
        text-align: center;
        margin-bottom: 20px;
        border: 1px solid #E8D5B7;
    }
    
    .stat-number {
        font-size: 32px;
        font-weight: 800;
        color: #8B0000;
    }
    
    .stat-label {
        font-size: 14px;
        color: #666;
    }
</style>
{% endblock %}

{% block admin_content %}
<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>📋 Inscriptions - {{ formation.titre }}</h3>
        <a href="{{ path('app_admin_formations_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>

    <div class="page-header">
        <h4><i class="fas fa-info-circle"></i> Informations de la formation</h4>
        <p class="mb-0"><strong>Prix :</strong> {{ formation.prix|number_format(2, ',', ' ') }} €</p>
        <p class="mb-0"><strong>Statut :</strong> 
            {% if formation.statut == 'en_cours' %}
                <span class="badge bg-warning">En cours</span>
            {% elseif formation.statut == 'termine' %}
                <span class="badge bg-success">Terminé</span>
            {% else %}
                <span class="badge bg-secondary">{{ formation.statut }}</span>
            {% endif %}
        </p>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-number">{{ inscriptions|length }}</div>
                <div class="stat-label">Total inscrits</div>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nom complet</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th>Date d'inscription</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for inscription in inscriptions %}
                <tr>
                    <td>{{ inscription.idInscription }}</td>
                    <td>{{ inscription.utilisateur.nom }}</td>
                    <td>{{ inscription.utilisateur.email }}</td>
                    <td>
                        {% if inscription.utilisateur.role == 'admin' %}
                            <span class="badge bg-danger">Admin</span>
                        {% else %}
                            <span class="badge bg-success">User</span>
                        {% endif %}
                    </td>
                    <td>{{ inscription.dateInscription|date('d/m/Y H:i') }}</td>
                    <td>
                        <span class="badge bg-{{ inscription.statut == 'en_attente' ? 'warning' : 'success' }}">
                            {{ inscription.statut }}
                        </span>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center py-4">
                        <i class="fas fa-users fa-3x text-muted mb-3 d-block"></i>
                        <p>Aucune inscription pour cette formation.</p>
                    </a>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}