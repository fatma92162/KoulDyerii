{% extends 'base_admin.html.twig' %}

{% block admin_title %}Gestion des livreurs{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(139, 0, 0, 0.1);
    }

    .stat-card.active {
        border-color: #8B0000;
        background: #FFF8F0;
    }

    .stat-number {
        font-size: 32px;
        font-weight: 800;
        color: #8B0000;
    }

    .stat-label {
        font-size: 14px;
        color: #666;
    }

    .filter-bar {
        background: #FFF8F0;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 25px;
        border: 1px solid #E8D5B7;
    }

    .btn-reset {
        background: #E8D5B7;
        border: none;
        color: #8B4513;
        border-radius: 50px;
        padding: 10px 20px;
    }

    .btn-reset:hover {
        background: #D4A574;
        color: white;
    }

    .table-clickable-row {
        cursor: pointer;
    }

    .table-clickable-row:hover {
        background: #fff8f0;
    }

    .call-kpi {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        background: #fff3e5;
        color: #8B4513;
    }

    .call-kpi.success {
        background: #edf9f0;
        color: #14733c;
    }

    .call-kpi.danger {
        background: #fff0f0;
        color: #b42318;
    }

    .driver-call-details-row {
        display: none;
    }

    .driver-call-details-row.open {
        display: table-row;
    }

    .driver-call-panel {
        background: linear-gradient(135deg, #fffaf5 0%, #fff 100%);
        border: 1px solid #f1dfcb;
        border-radius: 18px;
        padding: 22px;
        margin: 12px 0;
    }

    .driver-call-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .driver-call-summary-card {
        background: #fff;
        border: 1px solid #f2e7d8;
        border-radius: 14px;
        padding: 14px;
    }

    .driver-call-summary-label {
        font-size: 12px;
        color: #8b6c4f;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .driver-call-summary-value {
        font-size: 24px;
        font-weight: 800;
        color: #8B0000;
    }

    .driver-call-history-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
    }

    .driver-call-history-table th,
    .driver-call-history-table td {
        padding: 12px 14px;
        border-bottom: 1px solid #f4e7da;
        font-size: 14px;
        vertical-align: middle;
    }

    .driver-call-history-table th {
        background: #8B0000;
        color: #fff;
        font-weight: 700;
    }

    .call-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
    }

    .call-status-completed {
        background: #edf9f0;
        color: #14733c;
    }

    .call-status-declined {
        background: #fff0f0;
        color: #b42318;
    }

    .call-status-missed {
        background: #fff4e5;
        color: #9a6700;
    }

    .call-status-accepted {
        background: #eef4ff;
        color: #175cd3;
    }
</style>
{% endblock %}

{% block admin_content %}
<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Gestion des livreurs</h3>
        <a href="{{ path('app_admin_livreur_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Ajouter un livreur
        </a>
    </div>

    <div class="stats-cards">
        <div class="stat-card {% if status == '' %}active{% endif %}" onclick="filterByStatus('')">
            <div class="stat-number">{{ stats.total }}</div>
            <div class="stat-label">Total livreurs</div>
        </div>
        <div class="stat-card {% if status == 'disponible' %}active{% endif %}" onclick="filterByStatus('disponible')">
            <div class="stat-number">{{ stats.disponibles }}</div>
            <div class="stat-label">Disponibles</div>
        </div>
        <div class="stat-card {% if status == 'indisponible' %}active{% endif %}" onclick="filterByStatus('indisponible')">
            <div class="stat-number">{{ stats.indisponibles }}</div>
            <div class="stat-label">Indisponibles</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">{{ stats.total_calls|default(0) }}</div>
            <div class="stat-label">Appels totaux</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">{{ stats.accepted_calls|default(0) }}</div>
            <div class="stat-label">Appels acceptes</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">{{ stats.declined_calls|default(0) }}</div>
            <div class="stat-label">Appels refuses</div>
        </div>
    </div>

    <div class="filter-bar">
        <form method="get" id="filterForm">
            <div class="row g-3">
                <div class="col-md-5">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Rechercher par ID, nom, prenom ou telephone..."
                           value="{{ search|default('') }}">
                </div>
                <div class="col-md-4">
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">Tous les statuts</option>
                        <option value="disponible" {% if status == 'disponible' %}selected{% endif %}>Disponibles</option>
                        <option value="indisponible" {% if status == 'indisponible' %}selected{% endif %}>Indisponibles</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="sort" class="form-select" onchange="this.form.submit()">
                        <option value="id_desc" {% if sort == 'id_desc' %}selected{% endif %}>Plus recents</option>
                        <option value="id_asc" {% if sort == 'id_asc' %}selected{% endif %}>Plus anciens</option>
                        <option value="nom_asc" {% if sort == 'nom_asc' %}selected{% endif %}>Nom A-Z</option>
                        <option value="nom_desc" {% if sort == 'nom_desc' %}selected{% endif %}>Nom Z-A</option>
                        <option value="prenom_asc" {% if sort == 'prenom_asc' %}selected{% endif %}>Prenom A-Z</option>
                        <option value="prenom_desc" {% if sort == 'prenom_desc' %}selected{% endif %}>Prenom Z-A</option>
                        <option value="telephone_asc" {% if sort == 'telephone_asc' %}selected{% endif %}>Telephone croissant</option>
                        <option value="telephone_desc" {% if sort == 'telephone_desc' %}selected{% endif %}>Telephone decroissant</option>
                        <option value="status_asc" {% if sort == 'status_asc' %}selected{% endif %}>Disponibles d'abord</option>
                        <option value="status_desc" {% if sort == 'status_desc' %}selected{% endif %}>Indisponibles d'abord</option>
                    </select>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12">
                    <a href="{{ path('app_admin_livreurs_liste') }}" class="btn btn-reset">
                        <i class="fas fa-undo"></i> Reinitialiser les filtres
                    </a>
                </div>
            </div>
        </form>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Prenom</th>
                    <th>Telephone</th>
                    <th>Statut</th>
                    <th>Appels</th>
                    <th>% accepte</th>
                    <th>% refuse</th>
                    <th>Duree moy.</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for livreur in livreurs %}
                    {% set callSummary = livreurCallStats[livreur.idLivreur]|default({
                        total_calls: 0,
                        accepted_count: 0,
                        declined_count: 0,
                        missed_count: 0,
                        accepted_percentage: 0,
                        declined_percentage: 0,
                        average_duration_seconds: 0,
                        last_call_at: null,
                        recent_calls: []
                    }) %}
                    {% set avgMinutes = (callSummary.average_duration_seconds / 60)|round(0, 'floor') %}
                    {% set avgSeconds = callSummary.average_duration_seconds - (avgMinutes * 60) %}
                    <tr class="table-clickable-row" onclick="toggleLivreurCallDetails({{ livreur.idLivreur }})">
                        <td>{{ livreur.idLivreur }}</td>
                        <td>{{ livreur.nom }}</td>
                        <td>{{ livreur.prenom }}</td>
                        <td>{{ livreur.telephone }}</td>
                        <td>
                            {% if livreur.disponibilite %}
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle"></i> Disponible
                                </span>
                            {% else %}
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-truck"></i> En livraison
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="call-kpi">
                                <i class="fas fa-phone"></i> {{ callSummary.total_calls }}
                            </span>
                        </td>
                        <td>
                            <span class="call-kpi success">
                                <i class="fas fa-check-circle"></i> {{ callSummary.accepted_percentage }}%
                            </span>
                        </td>
                        <td>
                            <span class="call-kpi danger">
                                <i class="fas fa-phone-slash"></i> {{ callSummary.declined_percentage }}%
                            </span>
                        </td>
                        <td>
                            {% if callSummary.average_duration_seconds > 0 %}
                                {{ avgMinutes }}m {{ avgSeconds }}s
                            {% else %}
                                0s
                            {% endif %}
                        </td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-info"
                                    title="Voir les appels"
                                    onclick="event.stopPropagation(); toggleLivreurCallDetails({{ livreur.idLivreur }})">
                                <i class="fas fa-phone-volume"></i>
                            </button>
                            <a href="{{ path('app_admin_livreur_edit', {idLivreur: livreur.idLivreur}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form action="{{ path('app_admin_livreur_delete', {idLivreur: livreur.idLivreur}) }}"
                                  method="post"
                                  style="display: inline-block;"
                                  onsubmit="return confirm('Supprimer definitivement {{ livreur.prenom }} {{ livreur.nom }} ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_livreur_' ~ livreur.idLivreur) }}">
                                <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    <tr id="livreur-call-details-{{ livreur.idLivreur }}" class="driver-call-details-row">
                        <td colspan="10">
                            <div class="driver-call-panel">
                                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                    <h5 class="mb-0">
                                        <i class="fas fa-chart-line"></i> Appels de {{ livreur.prenom }} {{ livreur.nom }}
                                    </h5>
                                    <div class="text-muted">
                                        Dernier appel :
                                        {% if callSummary.last_call_at %}
                                            {{ callSummary.last_call_at|date('d/m/Y H:i') }}
                                        {% else %}
                                            Aucun
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="driver-call-summary-grid">
                                    <div class="driver-call-summary-card">
                                        <div class="driver-call-summary-label">Appels totaux</div>
                                        <div class="driver-call-summary-value">{{ callSummary.total_calls }}</div>
                                    </div>
                                    <div class="driver-call-summary-card">
                                        <div class="driver-call-summary-label">Acceptes</div>
                                        <div class="driver-call-summary-value">{{ callSummary.accepted_count }}</div>
                                    </div>
                                    <div class="driver-call-summary-card">
                                        <div class="driver-call-summary-label">Refuses</div>
                                        <div class="driver-call-summary-value">{{ callSummary.declined_count }}</div>
                                    </div>
                                    <div class="driver-call-summary-card">
                                        <div class="driver-call-summary-label">Manques</div>
                                        <div class="driver-call-summary-value">{{ callSummary.missed_count }}</div>
                                    </div>
                                    <div class="driver-call-summary-card">
                                        <div class="driver-call-summary-label">% accepte</div>
                                        <div class="driver-call-summary-value">{{ callSummary.accepted_percentage }}%</div>
                                    </div>
                                    <div class="driver-call-summary-card">
                                        <div class="driver-call-summary-label">% refuse</div>
                                        <div class="driver-call-summary-value">{{ callSummary.declined_percentage }}%</div>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="driver-call-history-table">
                                        <thead>
                                            <tr>
                                                <th>Livraison</th>
                                                <th>Debut</th>
                                                <th>Statut</th>
                                                <th>Duree</th>
                                                <th>Raison</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for call in callSummary.recent_calls %}
                                                {% set durationMinutes = (call.duration_seconds / 60)|round(0, 'floor') %}
                                                {% set durationSeconds = call.duration_seconds - (durationMinutes * 60) %}
                                                <tr>
                                                    <td>#{{ call.livraison_id }}</td>
                                                    <td>{{ call.started_at ? call.started_at|date('d/m/Y H:i:s') : '-' }}</td>
                                                    <td>
                                                        <span class="call-status-badge call-status-{{ call.final_status|default('missed') }}">
                                                            {% if call.final_status == 'completed' %}
                                                                <i class="fas fa-check-circle"></i> Termine
                                                            {% elseif call.final_status == 'declined' %}
                                                                <i class="fas fa-phone-slash"></i> Refuse
                                                            {% elseif call.final_status == 'accepted' %}
                                                                <i class="fas fa-phone"></i> Accepte
                                                            {% else %}
                                                                <i class="fas fa-clock"></i> Manque
                                                            {% endif %}
                                                        </span>
                                                    </td>
                                                    <td>
                                                        {% if call.duration_seconds > 0 %}
                                                            {{ durationMinutes }}m {{ durationSeconds }}s
                                                        {% else %}
                                                            0s
                                                        {% endif %}
                                                    </td>
                                                    <td>{{ call.decline_reason ?: '-' }}</td>
                                                </tr>
                                            {% else %}
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted">Aucun historique d'appel pour ce livreur.</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10" class="text-center py-4">
                            <i class="fas fa-users fa-3x text-muted mb-3 d-block"></i>
                            <p>Aucun livreur trouve.</p>
                            <a href="{{ path('app_admin_livreur_new') }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus"></i> Ajouter un livreur
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
function filterByStatus(statut) {
    const url = new URL(window.location.href);
    if (statut) {
        url.searchParams.set('status', statut);
    } else {
        url.searchParams.delete('status');
    }
    window.location.href = url.toString();
}

function toggleLivreurCallDetails(livreurId) {
    const row = document.getElementById('livreur-call-details-' + livreurId);
    if (!row) {
        return;
    }

    const isOpen = row.classList.contains('open');

    document.querySelectorAll('.driver-call-details-row').forEach((detailsRow) => {
        detailsRow.classList.remove('open');
    });

    if (!isOpen) {
        row.classList.add('open');
    }
}
</script>
{% endblock %}
