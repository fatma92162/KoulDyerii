{% extends 'base.html.twig' %}

{% block title %}Mes Commandes - Koul Dyeri{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .commandes-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 60px 0;
        text-align: center;
        color: white;
        margin-bottom: 50px;
    }
    
    .commande-card {
        border-radius: 15px;
        margin-bottom: 20px;
        transition: transform 0.3s ease;
        border: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    
    .commande-card:hover {
        transform: translateY(-3px);
    }
    
    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    
    .status-en-attente {
        background: #FF9800;
        color: white;
    }
    
    .status-acceptee {
        background: #4CAF50;
        color: white;
    }
    
    .status-refusee {
        background: #f44336;
        color: white;
    }
    
    .status-annulee {
        background: #9E9E9E;
        color: white;
    }
    .device-progress {
    margin-top: 10px;
    display: grid;
    gap: 8px;
}

.device-progress-line {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.device-progress-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #5C4033;
    font-weight: 700;
}

.device-progress-bar {
    width: 100%;
    height: 8px;
    background: rgba(0,0,0,0.08);
    border-radius: 999px;
    overflow: hidden;
}

.device-progress-fill {
    height: 100%;
    border-radius: 999px;
}

.device-progress-fill.pc {
    background: linear-gradient(90deg, #3b82f6 0%, #60a5fa 100%);
}

.device-progress-fill.mobile {
    background: linear-gradient(90deg, #10b981 0%, #34d399 100%);
}
</style>
{% endblock %}

{% block body %}
<div class="commandes-header">
    <div class="container">
        <h1><i class="fas fa-box"></i> Mes Commandes</h1>
        <p class="lead">Suivez l'état de vos commandes</p>
    </div>
</div>

<div class="container mb-5">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    
    {% if commandes|length > 0 %}
        {% for commande in commandes %}
        <div class="card commande-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Commande #{{ commande.id }}</strong>
                <span class="status-badge status-{{ commande.status|replace({'_': '-'}) }}">
                    {% if commande.status == 'en_attente' %}
                        ⏳ En attente
                    {% elseif commande.status == 'acceptee' %}
                        ✅ Acceptée
                    {% elseif commande.status == 'refusee' %}
                        ❌ Refusée
                    {% elseif commande.status == 'annulee' %}
                        🚫 Annulée
                    {% endif %}
                </span>
            </div>
            <div class="device-progress">
    <div class="device-progress-line">
        <div class="device-progress-top">
            <span>PC</span>
            <strong>{{ deviceStats.pc_percentage|default(0) }}%</strong>
        </div>
        <div class="device-progress-bar">
            <div class="device-progress-fill pc" style="width: {{ deviceStats.pc_percentage|default(0) }}%;"></div>
        </div>
    </div>

    <div class="device-progress-line">
        <div class="device-progress-top">
            <span>Mobile</span>
            <strong>{{ deviceStats.mobile_percentage|default(0) }}%</strong>
        </div>
        <div class="device-progress-bar">
            <div class="device-progress-fill mobile" style="width: {{ deviceStats.mobile_percentage|default(0) }}%;"></div>
        </div>
    </div>
</div>
</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <strong>Produit :</strong><br>
                        {% if commande.produit %}
                            {{ commande.produit.nom }}
                        {% else %}
                            Produit #{{ commande.productId }}
                        {% endif %}
                    </div>
                    <div class="col-md-2">
                        <strong>Prix :</strong><br>
                        {% if commande.produit %}
                            {{ commande.produit.prix|number_format(2, ',', ' ') }} €
                        {% else %}
                            -
                        {% endif %}
                    </div>
                    <div class="col-md-3">
                        <strong>Date :</strong><br>
                        {{ commande.createdAt|date('d/m/Y H:i') }}
                    </div>
                    <div class="col-md-4">
                        <strong>Adresse :</strong><br>
                        {{ commande.location }}
                    </div>
                </div>
                <div class="mt-3">
                    <a href="{{ path('app_mes_commandes_show', {id: commande.id}) }}" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i> Détails
                    </a>
                    {% if commande.status == 'en_attente' %}
                        <form action="{{ path('app_mes_commandes_annuler', {id: commande.id}) }}" method="post" style="display: inline-block;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Annuler cette commande ?')">
                                <i class="fas fa-times"></i> Annuler
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    {% else %}
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle fa-2x mb-3"></i>
            <h4>Vous n'avez pas encore de commandes</h4>
            <p>Découvrez nos produits et passez votre première commande !</p>
            <a href="{{ path('app_produits_index') }}" class="btn btn-primary">
                <i class="fas fa-store"></i> Voir les produits
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}