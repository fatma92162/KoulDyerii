{% extends 'base.html.twig' %}

{% block title %}Détail produit{% endblock %}

{% block body %}
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <h1 class="h3 mb-1">{{ plat.nom ?: 'Produit' }}</h1>
        <p class="text-muted mb-4">Partenaire: {{ partenaire ? partenaire.nom : 'Inconnu' }}</p>
        <div class="mb-4"><strong>Prix:</strong> {{ plat.prix ?: '-' }} TND</div>
        <div class="d-flex gap-2">
            {% if partenaire %}
                <a href="{{ path('app_partenaire_detail', {id: partenaire.id}) }}" class="btn btn-primary">Voir partenaire</a>
            {% endif %}
            <a href="{{ path('app_partenaires_liste') }}" class="btn btn-outline-secondary">Retour</a>
        </div>
    </div>
</div>
{% endblock %}
