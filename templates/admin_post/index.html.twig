    const donutOpts = { responsive:true, maintainAspectRatio:true, plugins:{ legend:{position:'bottom',labels:{usePointStyle:true,padding:16,font:{size:12}}} }, cutout:'62%' };
    new Chart(document.getElementById('modalPinnedChart'), { type:'doughnut', data:{labels:['Épinglés','Non épinglés'], datasets:[{data:[pinnedPosts,unpinnedPosts],backgroundColor:[GOLD,'#EDE3D3'],borderWidth:0}]}, options:donutOpts });
    new Chart(document.getElementById('modalImageChart'),  { type:'doughnut', data:{labels:['Avec image','Sans image'],  datasets:[{data:[withImage,withoutImage],  backgroundColor:[BLUE,'#EDE3D3'],borderWidth:0}]}, options:donutOpts });
