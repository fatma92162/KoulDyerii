{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login.page_title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ===== RESET & BASE ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ===== PAGE ===== */
    .login-page {
        min-height: 100vh;
        background-color: #ede8dc;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
        font-family: Arial, sans-serif;
    }

    /* ===== ORNEMENTS SVG EN ARRIERE-PLAN ===== */
    .bg-ornaments {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    /* ===== CARD PRINCIPALE ===== */
    .login-card {
        display: flex;
        width: 100%;
        max-width: 860px;
        border-radius: 22px;
        overflow: hidden;
        position: relative;
        z-index: 2;
        border: 0.5px solid rgba(90, 26, 26, 0.15);
        animation: fadeInUp 0.7s ease-out;
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ===== COLONNE GAUCHE ===== */
    .login-left {
        width: 260px;
        flex-shrink: 0;
        background-color: #5a1a1a;
        padding: 2.5rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .left-pattern {
        position: absolute;
        inset: 0;
        opacity: 0.10;
        pointer-events: none;
        width: 100%;
        height: 100%;
    }

    /* Logo */
    .logo-circle {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        border: 1.5px solid rgba(255, 255, 255, 0.22);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        position: relative;
        z-index: 1;
    }

    .brand-name {
        font-family: Georgia, serif;
        font-size: 17px;
        font-weight: normal;
        color: #f5d9c0;
        letter-spacing: 0.08em;
        text-align: center;
        margin-bottom: 2rem;
        position: relative;
        z-index: 1;
    }

    /* Features list */
    .feature-list {
        list-style: none;
        width: 100%;
        position: relative;
        z-index: 1;
        margin-top: auto;
    }

    .feature-list li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 0;
        border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
        font-size: 12px;
        color: rgba(255, 255, 255, 0.75);
        line-height: 1.4;
    }

    .feat-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.10);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .spices-deco {
        margin-top: 2rem;
        text-align: center;
        font-size: 20px;
        letter-spacing: 6px;
        opacity: 0.55;
        position: relative;
        z-index: 1;
    }

    /* ===== COLONNE DROITE ===== */
    .login-right {
        flex: 1;
        background: #faf5ec;
        padding: 2.8rem 2.5rem;
        position: relative;
        overflow: hidden;
    }

    .right-ornament {
        position: absolute;
        top: 0; right: 0;
        pointer-events: none;
        opacity: 0.055;
    }

    .login-right h2 {
        font-family: Georgia, serif;
        font-size: 26px;
        font-weight: normal;
        color: #3a1a0a;
        margin-bottom: 4px;
        position: relative;
        z-index: 1;
    }

    .login-subtitle {
        font-size: 13px;
        color: #a08060;
        margin-bottom: 1.8rem;
        position: relative;
        z-index: 1;
    }

    /* Alerts */
    .alert-tunisian {
        background: #f5e8e0;
        border: 0.5px solid rgba(90, 26, 26, 0.25);
        border-left: 3px solid #5a1a1a;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 13px;
        color: #5a1a1a;
        margin-bottom: 1.5rem;
        position: relative;
        z-index: 1;
    }

    .alert-warning-tunisian {
        background: #fef4e0;
        border: 0.5px solid rgba(180, 120, 0, 0.3);
        border-left: 3px solid #b47800;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 13px;
        color: #7a5000;
        margin-bottom: 1.5rem;
        position: relative;
        z-index: 1;
    }

    /* Form fields */
    .form-group {
        margin-bottom: 1.1rem;
        position: relative;
        z-index: 1;
    }

    .form-group label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: #7a4530;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .input-wrap {
        display: flex;
        align-items: center;
        background: #ffffff;
        border: 1px solid rgba(90, 26, 26, 0.18);
        border-radius: 10px;
        padding: 0 14px;
        height: 44px;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-wrap:focus-within {
        border-color: #5a1a1a;
        box-shadow: 0 0 0 3px rgba(90, 26, 26, 0.10);
    }

    .input-wrap.is-invalid {
        border-color: #c0392b;
    }

    .input-icon {
        flex-shrink: 0;
        margin-right: 10px;
        opacity: 0.5;
    }

    .input-wrap input {
        border: none;
        background: transparent;
        font-size: 14px;
        color: #3a1a0a;
        font-family: Arial, sans-serif;
        outline: none;
        width: 100%;
    }

    .input-wrap input::placeholder { color: #c0a090; }

    .input-wrap input.is-invalid {
        color: #c0392b;
    }

    .toggle-password {
        cursor: pointer;
        color: #8a4530;
        opacity: 0.6;
        flex-shrink: 0;
        transition: opacity 0.15s;
    }
    .toggle-password:hover { opacity: 1; }

    /* Forgot + remember */
    .forgot-link {
        text-align: right;
        margin-top: -6px;
        margin-bottom: 14px;
        position: relative;
        z-index: 1;
    }

    .forgot-link a {
        font-size: 12px;
        color: #8a6050;
        text-decoration: none;
        transition: color 0.15s;
    }
    .forgot-link a:hover { color: #5a1a1a; }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 1.4rem;
        position: relative;
        z-index: 1;
    }

    .checkbox-group input[type="checkbox"] {
        width: 16px;
        height: 16px;
        accent-color: #5a1a1a;
        cursor: pointer;
    }

    .checkbox-group label {
        font-size: 13px;
        color: #8a6050;
        cursor: pointer;
        margin: 0;
    }

    /* Buttons */
    .btn-login {
        width: 100%;
        height: 46px;
        background-color: #5a1a1a;
        color: #ffffff;
        border: none;
        border-radius: 25px;
        font-size: 15px;
        font-family: Arial, sans-serif;
        font-weight: 600;
        cursor: pointer;
        letter-spacing: 0.03em;
        transition: opacity 0.2s, transform 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        position: relative;
        z-index: 1;
    }

    .btn-login:hover {
        opacity: 0.88;
        transform: translateY(-1px);
    }

    /* Divider */
    .divider-line {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 1.2rem 0;
        position: relative;
        z-index: 1;
    }

    .divider-line span {
        font-size: 12px;
        color: #b09080;
        white-space: nowrap;
    }

    .divider-line::before,
    .divider-line::after {
        content: '';
        flex: 1;
        height: 0.5px;
        background: rgba(90, 26, 26, 0.15);
    }

    /* Google button */
    .btn-google {
        width: 100%;
        height: 44px;
        background: #ffffff;
        border: 1px solid rgba(90, 26, 26, 0.20);
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 14px;
        color: #3a1a0a;
        font-family: Arial, sans-serif;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s, transform 0.15s;
        position: relative;
        z-index: 1;
    }

    .btn-google:hover {
        background: #f5ede0;
        transform: translateY(-1px);
        color: #3a1a0a;
        text-decoration: none;
    }

    /* Register link */
    .register-text {
        text-align: center;
        margin-top: 1.2rem;
        font-size: 13px;
        color: #9a7060;
        position: relative;
        z-index: 1;
    }

    .register-text a {
        color: #5a1a1a;
        text-decoration: none;
        font-weight: 700;
    }

    .register-text a:hover { text-decoration: underline; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .login-left { display: none; }
        .login-right { padding: 2rem 1.5rem; }
        .login-card { max-width: 480px; border-radius: 16px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="login-page">

    {# ===== Ornements arabesques en arrière-plan ===== #}
    <svg class="bg-ornaments" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        {# Rosace en haut à droite #}
        <g opacity="0.20">
            <circle cx="1100" cy="100" r="160" fill="none" stroke="#6b1f1f" stroke-width="0.8"/>
            <circle cx="1100" cy="100" r="120" fill="none" stroke="#6b1f1f" stroke-width="0.5"/>
            <circle cx="1100" cy="100" r="80"  fill="none" stroke="#6b1f1f" stroke-width="0.4"/>
            <circle cx="1100" cy="100" r="40"  fill="none" stroke="#6b1f1f" stroke-width="0.4"/>
            <line x1="1100" y1="-62" x2="1100" y2="262" stroke="#6b1f1f" stroke-width="0.6"/>
            <line x1="938"  y1="100" x2="1262" y2="100" stroke="#6b1f1f" stroke-width="0.6"/>
            <line x1="987"  y1="-13" x2="1213" y2="213" stroke="#6b1f1f" stroke-width="0.35"/>
            <line x1="1213" y1="-13" x2="987"  y2="213" stroke="#6b1f1f" stroke-width="0.35"/>
            <circle cx="1100" cy="100" r="12" fill="#6b1f1f" opacity="0.3"/>
        </g>
        {# Rosace en bas à gauche #}
        <g opacity="0.15" transform="translate(80,720)">
            <circle cx="0" cy="0" r="130" fill="none" stroke="#6b1f1f" stroke-width="0.8"/>
            <circle cx="0" cy="0" r="90"  fill="none" stroke="#6b1f1f" stroke-width="0.5"/>
            <circle cx="0" cy="0" r="50"  fill="none" stroke="#6b1f1f" stroke-width="0.4"/>
            <line x1="0" y1="-130" x2="0" y2="130" stroke="#6b1f1f" stroke-width="0.6"/>
            <line x1="-130" y1="0" x2="130" y2="0" stroke="#6b1f1f" stroke-width="0.6"/>
            <line x1="-92"  y1="-92" x2="92"  y2="92"  stroke="#6b1f1f" stroke-width="0.35"/>
            <line x1="92"   y1="-92" x2="-92" y2="92"  stroke="#6b1f1f" stroke-width="0.35"/>
            <circle cx="0" cy="0" r="10" fill="#6b1f1f" opacity="0.35"/>
        </g>
        {# Étoiles / losanges décoratifs #}
        <g opacity="0.10">
            <path d="M600,30 L620,50 L600,70 L580,50 Z" fill="none" stroke="#6b1f1f" stroke-width="1.2"/>
            <path d="M600,22 L628,50 L600,78 L572,50 Z" fill="none" stroke="#6b1f1f" stroke-width="0.5"/>
            <circle cx="600" cy="50" r="7" fill="#6b1f1f" opacity="0.45"/>
        </g>
        <g opacity="0.08">
            <path d="M200,40 L214,54 L200,68 L186,54 Z" fill="none" stroke="#6b1f1f" stroke-width="0.9"/>
            <path d="M900,730 L914,744 L900,758 L886,744 Z" fill="none" stroke="#6b1f1f" stroke-width="0.9"/>
            <path d="M300,760 L312,772 L300,784 L288,772 Z" fill="none" stroke="#6b1f1f" stroke-width="0.9"/>
        </g>
        {# Bordures horizontales fines #}
        <g opacity="0.06">
            <line x1="0" y1="0"   x2="1200" y2="0"   stroke="#6b1f1f" stroke-width="1.5"/>
            <line x1="0" y1="12"  x2="1200" y2="12"  stroke="#6b1f1f" stroke-width="0.5"/>
            <line x1="0" y1="800" x2="1200" y2="800" stroke="#6b1f1f" stroke-width="1.5"/>
            <line x1="0" y1="788" x2="1200" y2="788" stroke="#6b1f1f" stroke-width="0.5"/>
        </g>
    </svg>

    {# ===== CARD ===== #}
    <div class="login-card">

        {# ===== COLONNE GAUCHE ===== #}
        <div class="login-left">
            {# Motif zellige en filigrane #}
            <svg class="left-pattern" viewBox="0 0 260 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <pattern id="zellige" x="0" y="0" width="46" height="46" patternUnits="userSpaceOnUse">
                        <path d="M23 0 L46 23 L23 46 L0 23 Z" fill="none" stroke="#fff" stroke-width="1"/>
                        <circle cx="23" cy="23" r="5.5" fill="none" stroke="#fff" stroke-width="0.7"/>
                        <line x1="0" y1="0" x2="46" y2="46" stroke="#fff" stroke-width="0.35"/>
                        <line x1="46" y1="0" x2="0" y2="46" stroke="#fff" stroke-width="0.35"/>
                        <circle cx="0"  cy="0"  r="2" fill="#fff" opacity="0.4"/>
                        <circle cx="46" cy="0"  r="2" fill="#fff" opacity="0.4"/>
                        <circle cx="0"  cy="46" r="2" fill="#fff" opacity="0.4"/>
                        <circle cx="46" cy="46" r="2" fill="#fff" opacity="0.4"/>
                    </pattern>
                </defs>
                <rect width="260" height="600" fill="url(#zellige)"/>
            </svg>

            {# Logo KB #}
            <div class="logo-circle">
                <svg width="72" height="62" viewBox="0 0 144 124" xmlns="http://www.w3.org/2000/svg">
                    {# Lettre K (piment rouge) #}
                    <path d="M10 112 L10 22 Q10 8 22 8 Q31 8 37 17 L62 58 L62 10 L80 10 L80 112 L62 112 L62 68 L37 112 Z" fill="#e06040"/>
                    {# Lettre D (maison) #}
                    <path d="M88 112 L88 10 L106 10 L106 48 Q126 46 128 58 Q128 70 106 72 L106 78 Q128 78 128 94 Q128 112 106 112 Z
                             M106 50 L106 66 Q116 66 116 58 Q116 50 106 50 Z
                             M106 76 L106 104 Q116 104 116 94 Q116 84 106 82 Z" fill="#7a4020"/>
                    {# Toit de la maison #}
                    <line x1="88" y1="24" x2="128" y2="24" stroke="#9a5530" stroke-width="2.5"/>
                    {# Cheminée et fumée #}
                    <rect x="112" y="8" width="7" height="18" fill="#7a4020" opacity="0.8"/>
                    <path d="M115 6 Q112 1 109 2 Q113 4 116 8" fill="#c8a880" opacity="0.7"/>
                    <circle cx="114" cy="6" r="3" fill="#c8a880" opacity="0.6"/>
                </svg>
            </div>

            <div class="brand-name">Koul Dyeri</div>

            <ul class="feature-list">
                <li>
                    <div class="feat-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4 14H8V8h8v8z" fill="rgba(255,255,255,0.65)"/>
                        </svg>
                    </div>
                    {{ 'auth.features.recipes'|trans }}
                </li>
                <li>
                    <div class="feat-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="8" r="4" stroke="rgba(255,255,255,0.65)" stroke-width="1.6"/>
                            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="rgba(255,255,255,0.65)" stroke-width="1.6" stroke-linecap="round"/>
                        </svg>
                    </div>
                    {{ 'auth.features.share'|trans }}
                </li>
                <li>
                    <div class="feat-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="rgba(255,255,255,0.65)" stroke-width="1.6"/>
                        </svg>
                    </div>
                    {{ 'auth.features.points'|trans }}
                </li>
            </ul>

            <div class="spices-deco">🌶 🧂 🍋</div>
        </div>

        {# ===== COLONNE DROITE - FORMULAIRE ===== #}
        <div class="login-right">

            {# Ornement coin #}
            <svg class="right-ornament" width="180" height="180" viewBox="0 0 180 180" xmlns="http://www.w3.org/2000/svg">
                <circle cx="160" cy="20" r="155" fill="none" stroke="#6b1f1f" stroke-width="1.2"/>
                <circle cx="160" cy="20" r="120" fill="none" stroke="#6b1f1f" stroke-width="0.6"/>
                <circle cx="160" cy="20" r="85"  fill="none" stroke="#6b1f1f" stroke-width="0.5"/>
                <circle cx="160" cy="20" r="50"  fill="none" stroke="#6b1f1f" stroke-width="0.4"/>
                <line x1="160" y1="-136" x2="160" y2="176" stroke="#6b1f1f" stroke-width="0.6"/>
                <line x1="-4"  y1="20"  x2="324" y2="20"  stroke="#6b1f1f" stroke-width="0.6"/>
            </svg>

            <h2>{{ 'auth.login.heading'|trans }}</h2>
            <p class="login-subtitle">{{ 'auth.login.subtitle'|trans }}</p>

            {# Alerte erreur #}
            {% if error %}
                <div class="alert-tunisian">
                    <strong>{{ 'auth.login.error_label'|trans }}</strong> {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {# Alerte compte bloqué #}
            {% if last_username and loginAttemptService is defined and loginAttemptService.isBlocked(last_username) %}
                <div class="alert-warning-tunisian">
                    <strong>{{ 'auth.login.blocked_title'|trans }}</strong> {{ 'auth.login.blocked_duration'|trans }}
                    {{ 'auth.login.blocked_unlock'|trans }}
                    <a href="{{ path('app_unlock_request') }}" style="color:#5a1a1a;font-weight:700;">{{ 'auth.login.unlock_now'|trans }}</a>
                </div>
                {% do app.session.set('last_blocked_email', last_username) %}
            {% endif %}

            <form method="post" id="loginForm" novalidate>

                {# Email #}
                <div class="form-group">
                    <label for="email">{{ 'auth.form.email_label'|trans }}</label>
                    <div class="input-wrap" id="wrap-email">
                        <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <rect x="2" y="4" width="20" height="16" rx="2" stroke="#7a4530" stroke-width="1.5"/>
                            <path d="M2 8l10 6 10-6" stroke="#7a4530" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <input type="email"
                               id="email"
                               name="email"
                               value="{{ last_username }}"
                               placeholder="{{ 'auth.form.email_placeholder'|trans }}"
                               autocomplete="email"
                               required
                               autofocus>
                    </div>
                </div>

                {# Mot de passe #}
                <div class="form-group">
                    <label for="password">{{ 'auth.form.password_label'|trans }}</label>
                    <div class="input-wrap" id="wrap-password">
                        <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <rect x="3" y="11" width="18" height="11" rx="2" stroke="#7a4530" stroke-width="1.5"/>
                            <path d="M7 11V7a5 5 0 0110 0v4" stroke="#7a4530" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <input type="password"
                               id="password"
                               name="password"
                               placeholder="{{ 'auth.form.password_placeholder'|trans }}"
                               autocomplete="current-password"
                               required>
                        <span class="toggle-password" onclick="togglePassword()" title="{{ 'auth.form.toggle_password'|trans }}">
                            <svg id="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="#7a4530" stroke-width="1.5"/>
                                <circle cx="12" cy="12" r="3" stroke="#7a4530" stroke-width="1.5"/>
                            </svg>
                        </span>
                    </div>
                </div>

                {# Mot de passe oublié #}
                <div class="forgot-link">
                    <a href="{{ path('app_forgot_password') }}">{{ 'auth.login.forgot_password'|trans }}</a>
                </div>

                {# Se souvenir #}
                <div class="checkbox-group">
                    <input type="checkbox" id="remember_me" name="_remember_me">
                    <label for="remember_me">{{ 'auth.login.remember_me'|trans }}</label>
                </div>

                {# CAPTCHA #}
                <div class="form-group" style="background:#f9f0e5; padding: 10px; border-radius: 8px; border: 1px dashed rgba(90, 26, 26, 0.3);">
                    <label for="math_captcha" style="display:flex; align-items:center; gap:6px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7a4530" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Vérification de sécurité : Combien font {{ captcha_num1 }} + {{ captcha_num2 }} ?
                    </label>
                    <div class="input-wrap" id="wrap-captcha" style="height:36px;">
                        <input type="number" 
                               id="math_captcha" 
                               name="math_captcha" 
                               placeholder="Votre réponse" 
                               required
                               style="text-align: center; font-weight: bold;">
                    </div>
                </div>

                {# Token CSRF #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {# Bouton connexion #}
                <button type="submit" class="btn-login">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ 'auth.login.submit'|trans }}
                </button>
            </form>

            {# Séparateur #}
            <div class="divider-line"><span>{{ 'common.or'|trans }}</span></div>

            {# Google #}
            <a href="{{ path('app_google') }}" class="btn-google">
                <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                {{ 'auth.login.google'|trans }}
            </a>

            {# Lien inscription #}
            <p class="register-text">
                {{ 'auth.login.no_account'|trans }}
                <a href="{{ path('app_register') }}">{{ 'auth.login.register_link'|trans }}</a>
            </p>

        </div>{# fin .login-right #}
    </div>{# fin .login-card #}

</div>{# fin .login-page #}

<script>
function togglePassword() {
    const field = document.getElementById('password');
    const icon  = document.getElementById('eye-icon');
    if (field.type === 'password') {
        field.type = 'text';
        icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24M1 1l22 22" stroke="#7a4530" stroke-width="1.5" stroke-linecap="round"/>';
    } else {
        field.type = 'password';
        icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="#7a4530" stroke-width="1.5"/><circle cx="12" cy="12" r="3" stroke="#7a4530" stroke-width="1.5"/>';
    }
}

document.addEventListener('DOMContentLoaded', function () {
    const emailInput    = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const wrapEmail     = document.getElementById('wrap-email');
    const wrapPassword  = document.getElementById('wrap-password');
    const emailRegex    = /^[^\s@]+@([^\s@.,]+\.)+[^\s@.,]{2,}$/;

    emailInput.addEventListener('input', function () {
        if (this.value.length > 0 && !emailRegex.test(this.value.trim())) {
            wrapEmail.classList.add('is-invalid');
        } else {
            wrapEmail.classList.remove('is-invalid');
        }
    });

    passwordInput.addEventListener('input', function () {
        if (this.value.length > 0 && this.value.length < 6) {
            wrapPassword.classList.add('is-invalid');
        } else {
            wrapPassword.classList.remove('is-invalid');
        }
    });
});
</script>
{% endblock %}
