<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{{ 'admin.title'|trans }}{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍽️</text></svg>">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    {% block stylesheets %}
    <style>
        :root {
            --sidebar-bg-1: #fffaf7;
            --sidebar-bg-2: #fff2ea;
            --sidebar-border: #eed7cd;
            --sidebar-text: #5b3434;
            --sidebar-text-soft: #8a6767;
            --primary: #8B0000;
            --primary-light: #B22222;
            --primary-soft: rgba(139, 0, 0, 0.08);
            --gold: #FECB6E;
            --white: #ffffff;
            --content-bg: #f8f6f4;
            --card-shadow: 0 8px 25px rgba(139, 0, 0, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--content-bg);
            min-height: 100vh;
            color: #2f2f2f;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar moderne */
        .admin-sidebar {
            width: 290px;
            background: linear-gradient(180deg, var(--sidebar-bg-1) 0%, var(--sidebar-bg-2) 100%);
            color: var(--sidebar-text);
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            overflow-y: auto;
            z-index: 100;
            transition: transform 0.35s ease, box-shadow 0.35s ease;
            border-right: 1px solid var(--sidebar-border);
            box-shadow: 8px 0 30px rgba(139, 0, 0, 0.05);
        }

        .admin-sidebar::-webkit-scrollbar {
            width: 8px;
        }

        .admin-sidebar::-webkit-scrollbar-thumb {
            background: rgba(139, 0, 0, 0.18);
            border-radius: 10px;
        }

        .admin-sidebar-header {
            padding: 24px 20px 18px;
            text-align: center;
            border-bottom: 1px solid rgba(139, 0, 0, 0.08);
            animation: fadeSlideDown 0.6s ease;
        }

        .admin-logo-wrap {
            width: 92px;
            height: 92px;
            margin: 0 auto 14px;
            border-radius: 24px;
            background: linear-gradient(135deg, #ffffff 0%, #fff1e8 100%);
            box-shadow: 0 8px 22px rgba(139, 0, 0, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px solid rgba(139, 0, 0, 0.08);
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }

        .admin-logo-wrap:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 14px 28px rgba(139, 0, 0, 0.16);
        }

        .admin-logo-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .admin-logo-fallback {
            font-size: 40px;
        }

        .admin-sidebar-header h3 {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 4px;
            letter-spacing: 0.3px;
        }

        .admin-sidebar-header p {
            font-size: 12px;
            color: var(--sidebar-text-soft);
            margin-bottom: 0;
            font-weight: 500;
        }

        .admin-nav {
            padding: 18px 14px 20px;
        }

        .admin-nav-item {
            position: relative;
            padding: 13px 16px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 14px;
            color: var(--sidebar-text);
            text-decoration: none;
            transition: all 0.28s ease;
            border-radius: 16px;
            font-weight: 600;
            overflow: hidden;
            animation: fadeSlideRight 0.45s ease both;
        }

        .admin-nav-item::before {
            content: "";
            position: absolute;
            left: -100%;
            top: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
            transition: left 0.55s ease;
        }

        .admin-nav-item:hover::before {
            left: 100%;
        }

        .admin-nav-item:hover {
            transform: translateX(6px);
            background: rgba(139, 0, 0, 0.07);
            color: var(--primary);
            box-shadow: 0 6px 18px rgba(139, 0, 0, 0.08);
        }

        .admin-nav-item.active {
            background: linear-gradient(135deg, rgba(139,0,0,0.14), rgba(178,34,34,0.08));
            color: var(--primary);
            box-shadow: 0 10px 20px rgba(139, 0, 0, 0.12);
            transform: translateX(4px);
        }

        .admin-nav-item.active::after {
            content: "";
            position: absolute;
            left: 0;
            top: 10px;
            bottom: 10px;
            width: 5px;
            border-radius: 10px;
            background: linear-gradient(180deg, var(--primary), var(--primary-light));
            animation: pulseBar 1.8s infinite;
        }

        .admin-nav-item i {
            width: 24px;
            font-size: 18px;
            text-align: center;
            transition: transform 0.28s ease;
        }

        .admin-nav-item:hover i,
        .admin-nav-item.active i {
            transform: scale(1.12);
        }

        .admin-nav-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(139, 0, 0, 0.18), transparent);
            margin: 14px 8px;
        }

        .admin-sidebar-footer {
            padding: 20px;
            border-top: 1px solid rgba(139, 0, 0, 0.08);
            margin-top: auto;
            color: var(--sidebar-text-soft);
            font-size: 12px;
            text-align: center;
        }

        .admin-content {
            flex: 1;
            margin-left: 290px;
            padding: 20px;
            animation: fadeUp 0.45s ease;
        }

        .admin-topbar {
            background: white;
            border-radius: 18px;
            padding: 15px 25px;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(139, 0, 0, 0.05);
            animation: fadeSlideDown 0.55s ease;
        }

        .admin-topbar-title h2 {
            font-size: 21px;
            font-weight: 700;
            color: #333;
            margin: 0;
        }

        .admin-topbar-user {
            display: flex;
            align-items: center;
            gap: 15px;
            cursor: pointer;
            position: relative;
            padding: 6px 10px;
            border-radius: 14px;
            transition: all 0.28s ease;
        }

        .admin-topbar-user:hover {
            background: rgba(139, 0, 0, 0.04);
        }

        .admin-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8B0000 0%, #A52A2A 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            box-shadow: 0 6px 14px rgba(139, 0, 0, 0.18);
        }

        .admin-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .admin-name {
            font-weight: 600;
            color: #333;
        }

        .admin-dropdown {
            position: absolute;
            top: 58px;
            right: 0;
            background: white;
            border-radius: 16px;
            box-shadow: 0 14px 34px rgba(0, 0, 0, 0.16);
            width: 260px;
            display: none;
            z-index: 1000;
            animation: fadeInDown 0.25s ease;
            overflow: hidden;
            border: 1px solid rgba(139, 0, 0, 0.06);
        }

        .admin-dropdown.show {
            display: block;
        }

        .admin-dropdown-item {
            padding: 13px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #333;
            text-decoration: none;
            transition: background 0.25s ease, padding-left 0.25s ease;
            font-weight: 500;
        }

        .admin-dropdown-item:hover {
            background: #fff7f2;
            padding-left: 22px;
            color: var(--primary);
        }

        .admin-dropdown-item i {
            width: 20px;
            color: var(--primary);
        }

        .admin-dropdown-divider {
            height: 1px;
            background: #f0e6d6;
            margin: 4px 0;
        }

        .admin-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
        }

        .admin-toggle-btn {
            display: none;
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1001;
            background: linear-gradient(135deg, #8B0000 0%, #A52A2A 100%);
            color: white;
            border: none;
            border-radius: 50%;
            width: 54px;
            height: 54px;
            font-size: 22px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
            transition: transform 0.25s ease;
        }

        .admin-toggle-btn:hover {
            transform: scale(1.08);
        }

        .btn-primary {
            background: linear-gradient(135deg, #8B0000, #A52A2A);
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #A52A2A, #8B0000);
            transform: translateY(-2px);
        }

        /* Animations */
        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-16px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeSlideRight {
            from {
                opacity: 0;
                transform: translateX(-14px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes fadeSlideDown {
            from {
                opacity: 0;
                transform: translateY(-14px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(14px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulseBar {
            0%, 100% {
                opacity: 1;
                transform: scaleY(1);
            }
            50% {
                opacity: 0.7;
                transform: scaleY(0.92);
            }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

            .admin-sidebar.open {
                transform: translateX(0);
            }

            .admin-content {
                margin-left: 0;
                padding: 16px;
            }

            .admin-toggle-btn {
                display: block;
            }

            .admin-topbar {
                padding: 14px 16px;
                gap: 12px;
            }

            .admin-topbar-title h2 {
                font-size: 18px;
            }

            .admin-name {
                display: none;
            }
        }
    </style>
    {% endblock %}

    {% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleAdminDropdown() {
            const dropdown = document.getElementById('adminDropdown');
            if (dropdown) dropdown.classList.toggle('show');
        }

        function toggleAdminSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            if (sidebar) sidebar.classList.toggle('open');
        }

        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('adminDropdown');
            const avatar = document.querySelector('.admin-topbar-user');
            if (dropdown && avatar && !avatar.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.remove('show');
            }
        });
    </script>
    {% endblock %}
</head>
<body>
    {% set currentRoute = app.request.attributes.get('_route') %}

    <div class="admin-wrapper">
        <!-- Sidebar verticale style moderne -->
        <div class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-header">
                <div class="admin-logo-wrap">
                    <img src="/images/logo.png" alt="Koul Dyeri Logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="admin-logo-fallback" style="display:none;">🍽️</div>
                </div>
                <h3>KOUL DYERI</h3>
                <p>{{ 'admin.space'|trans }}</p>
            </div>

            <div class="admin-nav">
                <a href="{{ path('app_home') }}" class="admin-nav-item {{ currentRoute == 'app_home' ? 'active' : '' }}">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>{{ 'admin.nav.dashboard'|trans }}</span>
                </a>

                <a href="{{ path('app_utilisateur_liste') }}" class="admin-nav-item {{ currentRoute == 'app_utilisateur_liste' ? 'active' : '' }}">
                    <i class="fas fa-users"></i>
                    <span>{{ 'admin.nav.users'|trans }}</span>
                </a>

                <a href="{{ path('app_admin_posts_index') }}" class="admin-nav-item {{ currentRoute == 'app_admin_posts_index' ? 'active' : '' }}">
                    <i class="fas fa-newspaper"></i>
                    <span>{{ 'admin.nav.posts'|trans }}</span>
                </a>

                <a href="{{ path('app_admin_produits_index') }}" class="admin-nav-item {{ currentRoute == 'app_admin_produits_index' ? 'active' : '' }}">
                    <i class="fas fa-box"></i>
                    <span>{{ 'admin.nav.products'|trans }}</span>
                </a>

                <a href="{{ path('app_admin_commandes_index') }}" class="admin-nav-item {{ currentRoute == 'app_admin_commandes_index' ? 'active' : '' }}">
                    <i class="fas fa-shopping-cart"></i>
                    <span>{{ 'admin.nav.orders'|trans }}</span>
                </a>

                <a href="{{ path('app_admin_livreurs_liste') }}" class="admin-nav-item {{ currentRoute == 'app_admin_livreurs_liste' ? 'active' : '' }}">
                    <i class="fas fa-user-tie"></i>
                    <span>{{ 'admin.nav.delivery_people'|trans }}</span>
                </a>

                <a href="{{ path('app_admin_livraisons_liste') }}" class="admin-nav-item {{ currentRoute == 'app_admin_livraisons_liste' ? 'active' : '' }}">
                    <i class="fas fa-truck"></i>
                    <span>{{ 'admin.nav.deliveries'|trans }}</span>
                </a>

                <a href="{{ path('app_admin_statistiques') }}" class="admin-nav-item {{ currentRoute == 'app_admin_statistiques' ? 'active' : '' }}">
                    <i class="fas fa-chart-line"></i>
                    <span>{{ 'admin.nav.stats'|trans }}</span>
                </a>

                <div class="admin-nav-divider"></div>

                <a href="{{ path('app_admin_formations_index') }}" class="admin-nav-item {{ currentRoute == 'app_admin_formations_index' ? 'active' : '' }}">
                    <i class="fas fa-graduation-cap"></i>
                    <span>{{ 'admin.nav.formations'|trans }}</span>
                </a>

                <a href="{{ path('app_admin_partenaires_index') }}" class="admin-nav-item {{ currentRoute == 'app_admin_partenaires_index' ? 'active' : '' }}">
                    <i class="fas fa-handshake"></i>
                    <span>{{ 'admin.nav.partners'|trans }}</span>
                </a>

                <a href="{{ path('app_admin_results') }}" class="admin-nav-item {{ currentRoute == 'app_admin_results' ? 'active' : '' }}">
                    <i class="fas fa-list-check"></i>
                    <span>{{ 'admin.nav.quiz'|trans }}</span>
                </a>

                <a href="{{ path('app_admin_certificates') }}" class="admin-nav-item {{ currentRoute == 'app_admin_certificates' ? 'active' : '' }}">
                    <i class="fas fa-certificate"></i>
                    <span>{{ 'admin.nav.certificates'|trans }}</span>
                </a>

                <div class="admin-nav-divider"></div>

                <a href="{{ path('app_logout') }}" class="admin-nav-item">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>{{ 'admin.nav.logout'|trans }}</span>
                </a>
            </div>

            <div class="admin-sidebar-footer">
                {{ 'admin.footer'|trans }}
            </div>
        </div>

        <!-- Contenu principal -->
        <div class="admin-content">
            <div class="admin-topbar">
                <div class="admin-topbar-title">
                    <h2>{% block admin_title %}{{ 'admin.dashboard'|trans }}{% endblock %}</h2>
                </div>

                <div class="admin-topbar-user" onclick="toggleAdminDropdown()">
                    <div class="admin-avatar">
                        {% if app.user.photo %}
                            <img src="{{ app.user.photo }}" alt="{{ 'admin.photo_alt'|trans }}">
                        {% else %}
                            <span style="font-size: 20px;">👤</span>
                        {% endif %}
                    </div>
                    <span class="admin-name">{{ app.user.nom }}</span>
                    <i class="fas fa-chevron-down" style="font-size: 12px;"></i>

                    <div class="admin-dropdown" id="adminDropdown">
                        <a href="{{ path('app_mon_profil') }}" class="admin-dropdown-item">
                            <i class="fas fa-user"></i> {{ 'admin.profile'|trans }}
                        </a>
                        <a href="{{ path('app_utilisateur_editer', {id: app.user.idUtilisateur}) }}" class="admin-dropdown-item">
                            <i class="fas fa-edit"></i> {{ 'admin.profile_edit'|trans }}
                        </a>

                        <div class="admin-dropdown-divider"></div>

                        <a href="{{ path('app_logout') }}" class="admin-dropdown-item">
                            <i class="fas fa-sign-out-alt"></i> {{ 'admin.logout'|trans }}
                        </a>
                    </div>
                </div>
            </div>

            <!-- Messages flash -->
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('warning') %}
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('info') %}
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <i class="fas fa-info-circle"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% block admin_content %}{% endblock %}
        </div>
    </div>

    <!-- Bouton pour toggle la sidebar sur mobile -->
    <button class="admin-toggle-btn" onclick="toggleAdminSidebar()">
        <i class="fas fa-bars"></i>
    </button>

    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
</body>
</html>
