                            <option value="Béja">{{ 'auth.regions.beja'|trans }}</option>
                            <option value="Jendouba">{{ 'auth.regions.jendouba'|trans }}</option>
                            <option value="Le Kef">{{ 'auth.regions.le_kef'|trans }}</option>
                            <option value="Siliana">{{ 'auth.regions.siliana'|trans }}</option>
                            <option value="Sousse">{{ 'auth.regions.sousse'|trans }}</option>
                            <option value="Monastir">{{ 'auth.regions.monastir'|trans }}</option>
                            <option value="Mahdia">{{ 'auth.regions.mahdia'|trans }}</option>
                            <option value="Sfax">{{ 'auth.regions.sfax'|trans }}</option>
                            <option value="Kairouan">{{ 'auth.regions.kairouan'|trans }}</option>
                            <option value="Kasserine">{{ 'auth.regions.kasserine'|trans }}</option>
                            <option value="Sidi Bouzid">{{ 'auth.regions.sidi_bouzid'|trans }}</option>
                            <option value="Gabès">{{ 'auth.regions.gabes'|trans }}</option>
                            <option value="Médenine">{{ 'auth.regions.medenine'|trans }}</option>
                            <option value="Tataouine">{{ 'auth.regions.tataouine'|trans }}</option>
                            <option value="Gafsa">{{ 'auth.regions.gafsa'|trans }}</option>
