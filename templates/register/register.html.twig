</div>

<script>
function togglePassword(fieldId) {
    const field = document.getElementById(fieldId);
    const eyeIcon = fieldId === 'password' ? 'eye-icon-pwd' : 'eye-icon-confirm';
    const icon = document.getElementById(eyeIcon);
    
    if (field.type === 'password') {
        field.type = 'text';
        icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24M1 1l22 22" stroke="#7a4530" stroke-width="1.5" stroke-linecap="round"/>';
    } else {
        field.type = 'password';
        icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="#7a4530" stroke-width="1.5"/><circle cx="12" cy="12" r="3" stroke="#7a4530" stroke-width="1.5"/>';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('registerForm');
    const nomInput = document.getElementById('nom');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirm_password');
    const roleSelect = document.getElementById('role');
    const wrapNom = document.getElementById('wrap-nom');
    const wrapEmail = document.getElementById('wrap-email');
    const wrapPassword = document.getElementById('wrap-password');
    const wrapConfirm = document.getElementById('wrap-confirm');
    const emailRegex = /^[^\s@]+@([^\s@.,]+\.)+[^\s@.,]{2,}$/;
    
    // Validation du nom
    nomInput.addEventListener('input', function() {
        const value = this.value.trim();
        if (value.length === 0) {
            wrapNom.classList.add('is-invalid');
        } else if (value.length < 3) {
            wrapNom.classList.add('is-invalid');
        } else {
            wrapNom.classList.remove('is-invalid');
        }
    });
    
    // Validation de l'email
    emailInput.addEventListener('input', function() {
        const value = this.value.trim();
        if (value.length === 0 || !emailRegex.test(value)) {
            wrapEmail.classList.add('is-invalid');
        } else {
            wrapEmail.classList.remove('is-invalid');
        }
    });
    
    // Validation du mot de passe
    passwordInput.addEventListener('input', function() {
        const value = this.value;
        if (value.length === 0) {
            wrapPassword.classList.add('is-invalid');
        } else if (value.length < 6) {
            wrapPassword.classList.add('is-invalid');
        } else {
            wrapPassword.classList.remove('is-invalid');
            if (confirmInput.value) validateConfirmPassword();
        }
    });
    
    function validateConfirmPassword() {
        if (confirmInput.value.length === 0) {
            wrapConfirm.classList.add('is-invalid');
        } else if (passwordInput.value !== confirmInput.value) {
            wrapConfirm.classList.add('is-invalid');
        } else {
            wrapConfirm.classList.remove('is-invalid');
        }
    }
    
    confirmInput.addEventListener('input', validateConfirmPassword);
    
    // Validation du rôle avant soumission
    form.addEventListener('submit', function(e) {
        if (!roleSelect.value) {
            e.preventDefault();
            alert('Veuillez sélectionner un type d\'utilisateur');
            return false;
        }
        
        let hasError = false;
        const inputs = [nomInput, emailInput, passwordInput, confirmInput];
        
        inputs.forEach(input => {
            const wrap = document.getElementById('wrap-' + input.id);
            if (wrap && wrap.classList.contains('is-invalid')) {
                hasError = true;
                input.parentElement.classList.add('shake');
                setTimeout(() => {
                    input.parentElement.classList.remove('shake');
                }, 300);
            }
        });
        
        if (hasError) {
            e.preventDefault();
            alert('Veuillez corriger les erreurs dans le formulaire');
        }
    });
});
</script>
{% endblock %}
