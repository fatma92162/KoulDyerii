{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.register.page_title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ===== RESET & BASE ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ===== PAGE ===== */
    .register-page {
        min-height: 100vh;
        background-color: #ede8dc;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
        font-family: Arial, sans-serif;
    }

    /* ===== ORNEMENTS SVG EN ARRIERE-PLAN ===== */
    .bg-ornaments {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    /* ===== CARD PRINCIPALE ===== */
    .register-card {
        display: flex;
        width: 100%;
        max-width: 1100px;
        border-radius: 22px;
        overflow: hidden;
        position: relative;
        z-index: 2;
        border: 0.5px solid rgba(90, 26, 26, 0.15);
        animation: fadeInUp 0.7s ease-out;
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ===== COLONNE GAUCHE ===== */
    .register-left {
        width: 280px;
        flex-shrink: 0;
        background-color: #5a1a1a;
        padding: 2.5rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .left-pattern {
        position: absolute;
        inset: 0;
        opacity: 0.10;
        pointer-events: none;
        width: 100%;
        height: 100%;
    }

    /* Logo */
    .logo-circle {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        border: 1.5px solid rgba(255, 255, 255, 0.22);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        position: relative;
        z-index: 1;
    }

    .brand-name {
        font-family: Georgia, serif;
        font-size: 17px;
        font-weight: normal;
        color: #f5d9c0;
        letter-spacing: 0.08em;
        text-align: center;
        margin-bottom: 2rem;
        position: relative;
        z-index: 1;
    }

    /* Features list */
    .feature-list {
        list-style: none;
        width: 100%;
        position: relative;
        z-index: 1;
        margin-top: auto;
    }

    .feature-list li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 0;
        border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
        font-size: 12px;
        color: rgba(255, 255, 255, 0.75);
        line-height: 1.4;
    }

    .feat-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.10);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .spices-deco {
        margin-top: 2rem;
        text-align: center;
        font-size: 20px;
        letter-spacing: 6px;
        opacity: 0.55;
        position: relative;
        z-index: 1;
    }

    /* ===== COLONNE DROITE ===== */
    .register-right {
        flex: 1;
        background: #faf5ec;
        padding: 2.5rem 2.5rem;
        position: relative;
        overflow-y: auto;
        max-height: 90vh;
    }

    .right-ornament {
        position: absolute;
        top: 0; right: 0;
        pointer-events: none;
        opacity: 0.055;
    }

    .register-right h2 {
        font-family: Georgia, serif;
        font-size: 26px;
        font-weight: normal;
        color: #3a1a0a;
        margin-bottom: 4px;
        position: relative;
        z-index: 1;
    }

    .register-subtitle {
        font-size: 13px;
        color: #a08060;
        margin-bottom: 1.8rem;
        position: relative;
        z-index: 1;
    }

    /* Form fields */
    .form-group {
        margin-bottom: 1rem;
        position: relative;
        z-index: 1;
    }

    .form-group label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: #7a4530;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .input-wrap {
        display: flex;
        align-items: center;
        background: #ffffff;
        border: 1px solid rgba(90, 26, 26, 0.18);
        border-radius: 10px;
        padding: 0 14px;
        height: 44px;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-wrap:focus-within {
        border-color: #5a1a1a;
        box-shadow: 0 0 0 3px rgba(90, 26, 26, 0.10);
    }

    .input-wrap.is-invalid {
        border-color: #c0392b;
    }

    .input-icon {
        flex-shrink: 0;
        margin-right: 10px;
        opacity: 0.5;
    }

    .input-wrap input, .input-wrap select {
        border: none;
        background: transparent;
        font-size: 14px;
        color: #3a1a0a;
        font-family: Arial, sans-serif;
        outline: none;
        width: 100%;
    }

    .input-wrap select {
        cursor: pointer;
    }

    .input-wrap input::placeholder { color: #c0a090; }

    .toggle-password {
        cursor: pointer;
        color: #8a4530;
        opacity: 0.6;
        flex-shrink: 0;
        transition: opacity 0.15s;
    }
    .toggle-password:hover { opacity: 1; }

    .row {
        display: flex;
        gap: 15px;
        margin-bottom: 0;
    }

    .row .form-group {
        flex: 1;
    }

    /* Help text */
    .help-text {
        font-size: 11px;
        color: #a08060;
        margin-top: 4px;
        display: block;
    }

    /* Buttons */
    .btn-register {
        width: 100%;
        height: 46px;
        background-color: #5a1a1a;
        color: #ffffff;
        border: none;
        border-radius: 25px;
        font-size: 15px;
        font-family: Arial, sans-serif;
        font-weight: 600;
        cursor: pointer;
        letter-spacing: 0.03em;
        transition: opacity 0.2s, transform 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        position: relative;
        z-index: 1;
        margin-top: 1rem;
    }

    .btn-register:hover {
        opacity: 0.88;
        transform: translateY(-1px);
    }

    /* Divider */
    .divider-line {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 1.2rem 0;
        position: relative;
        z-index: 1;
    }

    .divider-line span {
        font-size: 12px;
        color: #b09080;
        white-space: nowrap;
    }

    .divider-line::before,
    .divider-line::after {
        content: '';
        flex: 1;
        height: 0.5px;
        background: rgba(90, 26, 26, 0.15);
    }

    /* Google button */
    .btn-google {
        width: 100%;
        height: 44px;
        background: #ffffff;
        border: 1px solid rgba(90, 26, 26, 0.20);
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 14px;
        color: #3a1a0a;
        font-family: Arial, sans-serif;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s, transform 0.15s;
        position: relative;
        z-index: 1;
    }

    .btn-google:hover {
        background: #f5ede0;
        transform: translateY(-1px);
        color: #3a1a0a;
        text-decoration: none;
    }

    /* Login link */
    .login-text {
        text-align: center;
        margin-top: 1.2rem;
        font-size: 13px;
        color: #9a7060;
        position: relative;
        z-index: 1;
    }

    .login-text a {
        color: #5a1a1a;
        text-decoration: none;
        font-weight: 700;
    }

    .login-text a:hover { text-decoration: underline; }

    /* Alert */
    .alert-tunisian {
        background: #f5e8e0;
        border: 0.5px solid rgba(90, 26, 26, 0.25);
        border-left: 3px solid #5a1a1a;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 13px;
        color: #5a1a1a;
        margin-bottom: 1.5rem;
        position: relative;
        z-index: 1;
    }

    .alert-success-tunisian {
        background: #e0f5e8;
        border: 0.5px solid rgba(26, 90, 50, 0.25);
        border-left: 3px solid #2a7a4f;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 13px;
        color: #1a5a36;
        margin-bottom: 1.5rem;
        position: relative;
        z-index: 1;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .register-left { display: none; }
        .register-right { padding: 2rem 1.5rem; }
        .register-card { max-width: 500px; border-radius: 16px; }
        .row { flex-direction: column; gap: 0; }
    }
</style>
{% endblock %}

{% block body %}
<div class="register-page">

    {# ===== Ornements arabesques en arrière-plan ===== #}
    <svg class="bg-ornaments" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <g opacity="0.20">
            <circle cx="1100" cy="100" r="160" fill="none" stroke="#6b1f1f" stroke-width="0.8"/>
            <circle cx="1100" cy="100" r="120" fill="none" stroke="#6b1f1f" stroke-width="0.5"/>
            <circle cx="1100" cy="100" r="80"  fill="none" stroke="#6b1f1f" stroke-width="0.4"/>
            <circle cx="1100" cy="100" r="40"  fill="none" stroke="#6b1f1f" stroke-width="0.4"/>
            <line x1="1100" y1="-62" x2="1100" y2="262" stroke="#6b1f1f" stroke-width="0.6"/>
            <line x1="938"  y1="100" x2="1262" y2="100" stroke="#6b1f1f" stroke-width="0.6"/>
            <line x1="987"  y1="-13" x2="1213" y2="213" stroke="#6b1f1f" stroke-width="0.35"/>
            <line x1="1213" y1="-13" x2="987"  y2="213" stroke="#6b1f1f" stroke-width="0.35"/>
            <circle cx="1100" cy="100" r="12" fill="#6b1f1f" opacity="0.3"/>
        </g>
        <g opacity="0.15" transform="translate(80,720)">
            <circle cx="0" cy="0" r="130" fill="none" stroke="#6b1f1f" stroke-width="0.8"/>
            <circle cx="0" cy="0" r="90"  fill="none" stroke="#6b1f1f" stroke-width="0.5"/>
            <circle cx="0" cy="0" r="50"  fill="none" stroke="#6b1f1f" stroke-width="0.4"/>
            <line x1="0" y1="-130" x2="0" y2="130" stroke="#6b1f1f" stroke-width="0.6"/>
            <line x1="-130" y1="0" x2="130" y2="0" stroke="#6b1f1f" stroke-width="0.6"/>
            <line x1="-92"  y1="-92" x2="92"  y2="92"  stroke="#6b1f1f" stroke-width="0.35"/>
            <line x1="92"   y1="-92" x2="-92" y2="92"  stroke="#6b1f1f" stroke-width="0.35"/>
            <circle cx="0" cy="0" r="10" fill="#6b1f1f" opacity="0.35"/>
        </g>
        <g opacity="0.10">
            <path d="M600,30 L620,50 L600,70 L580,50 Z" fill="none" stroke="#6b1f1f" stroke-width="1.2"/>
            <path d="M600,22 L628,50 L600,78 L572,50 Z" fill="none" stroke="#6b1f1f" stroke-width="0.5"/>
            <circle cx="600" cy="50" r="7" fill="#6b1f1f" opacity="0.45"/>
        </g>
        <g opacity="0.08">
            <path d="M200,40 L214,54 L200,68 L186,54 Z" fill="none" stroke="#6b1f1f" stroke-width="0.9"/>
            <path d="M900,730 L914,744 L900,758 L886,744 Z" fill="none" stroke="#6b1f1f" stroke-width="0.9"/>
            <path d="M300,760 L312,772 L300,784 L288,772 Z" fill="none" stroke="#6b1f1f" stroke-width="0.9"/>
        </g>
        <g opacity="0.06">
            <line x1="0" y1="0"   x2="1200" y2="0"   stroke="#6b1f1f" stroke-width="1.5"/>
            <line x1="0" y1="12"  x2="1200" y2="12"  stroke="#6b1f1f" stroke-width="0.5"/>
            <line x1="0" y1="800" x2="1200" y2="800" stroke="#6b1f1f" stroke-width="1.5"/>
            <line x1="0" y1="788" x2="1200" y2="788" stroke="#6b1f1f" stroke-width="0.5"/>
        </g>
    </svg>

    {# ===== CARD ===== #}
    <div class="register-card">

        {# ===== COLONNE GAUCHE ===== #}
        <div class="register-left">
            <svg class="left-pattern" viewBox="0 0 280 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <pattern id="zellige" x="0" y="0" width="46" height="46" patternUnits="userSpaceOnUse">
                        <path d="M23 0 L46 23 L23 46 L0 23 Z" fill="none" stroke="#fff" stroke-width="1"/>
                        <circle cx="23" cy="23" r="5.5" fill="none" stroke="#fff" stroke-width="0.7"/>
                        <line x1="0" y1="0" x2="46" y2="46" stroke="#fff" stroke-width="0.35"/>
                        <line x1="46" y1="0" x2="0" y2="46" stroke="#fff" stroke-width="0.35"/>
                        <circle cx="0"  cy="0"  r="2" fill="#fff" opacity="0.4"/>
                        <circle cx="46" cy="0"  r="2" fill="#fff" opacity="0.4"/>
                        <circle cx="0"  cy="46" r="2" fill="#fff" opacity="0.4"/>
                        <circle cx="46" cy="46" r="2" fill="#fff" opacity="0.4"/>
                    </pattern>
                </defs>
                <rect width="280" height="600" fill="url(#zellige)"/>
            </svg>

            <div class="logo-circle">
                <svg width="72" height="62" viewBox="0 0 144 124" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 112 L10 22 Q10 8 22 8 Q31 8 37 17 L62 58 L62 10 L80 10 L80 112 L62 112 L62 68 L37 112 Z" fill="#e06040"/>
                    <path d="M88 112 L88 10 L106 10 L106 48 Q126 46 128 58 Q128 70 106 72 L106 78 Q128 78 128 94 Q128 112 106 112 Z M106 50 L106 66 Q116 66 116 58 Q116 50 106 50 Z M106 76 L106 104 Q116 104 116 94 Q116 84 106 82 Z" fill="#7a4020"/>
                    <line x1="88" y1="24" x2="128" y2="24" stroke="#9a5530" stroke-width="2.5"/>
                    <rect x="112" y="8" width="7" height="18" fill="#7a4020" opacity="0.8"/>
                    <path d="M115 6 Q112 1 109 2 Q113 4 116 8" fill="#c8a880" opacity="0.7"/>
                    <circle cx="114" cy="6" r="3" fill="#c8a880" opacity="0.6"/>
                </svg>
            </div>

            <div class="brand-name">Koul Dyeri</div>

            <ul class="feature-list">
                <li>
                    <div class="feat-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4 14H8V8h8v8z" fill="rgba(255,255,255,0.65)"/>
                        </svg>
                    </div>
                    {{ 'auth.features.recipes'|trans }}
                </li>
                <li>
                    <div class="feat-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="8" r="4" stroke="rgba(255,255,255,0.65)" stroke-width="1.6"/>
                            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="rgba(255,255,255,0.65)" stroke-width="1.6" stroke-linecap="round"/>
                        </svg>
                    </div>
                    {{ 'auth.features.share'|trans }}
                </li>
                <li>
                    <div class="feat-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="rgba(255,255,255,0.65)" stroke-width="1.6"/>
                        </svg>
                    </div>
                    {{ 'auth.features.points'|trans }}
                </li>
                <li>
                    <div class="feat-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="M3 3h18v18H3z" stroke="rgba(255,255,255,0.65)" stroke-width="1.6"/>
                            <path d="M8 7h8M8 12h8M8 17h5" stroke="rgba(255,255,255,0.65)" stroke-width="1.6" stroke-linecap="round"/>
                        </svg>
                    </div>
                    {{ 'auth.features.shop'|trans }}
                </li>
            </ul>

            <div class="spices-deco">🌶 🧂 🍋 🍅</div>
        </div>

        {# ===== COLONNE DROITE - FORMULAIRE ===== #}
        <div class="register-right">

            <svg class="right-ornament" width="180" height="180" viewBox="0 0 180 180" xmlns="http://www.w3.org/2000/svg">
                <circle cx="160" cy="20" r="155" fill="none" stroke="#6b1f1f" stroke-width="1.2"/>
                <circle cx="160" cy="20" r="120" fill="none" stroke="#6b1f1f" stroke-width="0.6"/>
                <circle cx="160" cy="20" r="85"  fill="none" stroke="#6b1f1f" stroke-width="0.5"/>
                <circle cx="160" cy="20" r="50"  fill="none" stroke="#6b1f1f" stroke-width="0.4"/>
                <line x1="160" y1="-136" x2="160" y2="176" stroke="#6b1f1f" stroke-width="0.6"/>
                <line x1="-4"  y1="20"  x2="324" y2="20"  stroke="#6b1f1f" stroke-width="0.6"/>
            </svg>

            <h2>{{ 'auth.register.heading'|trans }}</h2>
            <p class="register-subtitle">{{ 'auth.register.subtitle'|trans }}</p>

            {# Flash messages #}
            {% for message in app.flashes('success') %}
                <div class="alert-success-tunisian">
                    {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert-tunisian">
                    {{ message }}
                </div>
            {% endfor %}

            <form method="post" id="registerForm" novalidate>

                {# Nom complet #}
                <div class="form-group">
                    <label for="nom">{{ 'auth.register.full_name_label'|trans }}</label>
                    <div class="input-wrap" id="wrap-nom">
                        <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="8" r="4" stroke="#7a4530" stroke-width="1.5"/>
                            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="#7a4530" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <input type="text"
                               id="nom"
                               name="nom"
                               placeholder="{{ 'auth.register.full_name_placeholder'|trans }}"
                               value="{{ last_nom|default('') }}"
                               required>
                    </div>
                </div>

                {# Email #}
                <div class="form-group">
                    <label for="email">{{ 'auth.form.email_label'|trans }}</label>
                    <div class="input-wrap" id="wrap-email">
                        <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <rect x="2" y="4" width="20" height="16" rx="2" stroke="#7a4530" stroke-width="1.5"/>
                            <path d="M2 8l10 6 10-6" stroke="#7a4530" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        <input type="email"
                               id="email"
                               name="email"
                               placeholder="{{ 'auth.form.email_placeholder'|trans }}"
                               value="{{ last_email|default('') }}"
                               required>
                    </div>
                </div>

                {# Mot de passe + Confirmation #}
                <div class="row">
                    <div class="form-group">
                        <label for="password">{{ 'auth.form.password_label'|trans }}</label>
                        <div class="input-wrap" id="wrap-password">
                            <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <rect x="3" y="11" width="18" height="11" rx="2" stroke="#7a4530" stroke-width="1.5"/>
                                <path d="M7 11V7a5 5 0 0110 0v4" stroke="#7a4530" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            <input type="password"
                                   id="password"
                                   name="password"
                                   placeholder="{{ 'auth.form.password_placeholder'|trans }}"
                                   required>
                            <span class="toggle-password" onclick="togglePassword('password')" title="{{ 'auth.form.toggle_password'|trans }}">
                                <svg id="eye-icon-pwd" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="#7a4530" stroke-width="1.5"/>
                                    <circle cx="12" cy="12" r="3" stroke="#7a4530" stroke-width="1.5"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="confirm_password">{{ 'auth.register.confirm_label'|trans }}</label>
                        <div class="input-wrap" id="wrap-confirm">
                            <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <rect x="3" y="11" width="18" height="11" rx="2" stroke="#7a4530" stroke-width="1.5"/>
                                <path d="M7 11V7a5 5 0 0110 0v4" stroke="#7a4530" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            <input type="password"
                                   id="confirm_password"
                                   name="confirm_password"
                                   placeholder="{{ 'auth.form.password_placeholder'|trans }}"
                                   required>
                            <span class="toggle-password" onclick="togglePassword('confirm_password')" title="{{ 'auth.form.toggle_password'|trans }}">
                                <svg id="eye-icon-confirm" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="#7a4530" stroke-width="1.5"/>
                                    <circle cx="12" cy="12" r="3" stroke="#7a4530" stroke-width="1.5"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                </div>

                {# Gouvernorat #}
                <div class="form-group">
                    <label for="region">{{ 'auth.register.region_label'|trans }}</label>
                    <div class="input-wrap">
                        <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
