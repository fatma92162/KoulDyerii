                </div>

                {# Date de naissance #}
                <div class="form-group">
                    <label for="dateNaissance">{{ 'auth.register.birthdate_label'|trans }}</label>
                    <div class="input-wrap">
                        <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <rect x="3" y="4" width="18" height="18" rx="2" stroke="#7a4530" stroke-width="1.5"/>
                            <path d="M3 10h18M8 2v4M16 2v4" stroke="#7a4530" stroke-width="1.5" stroke-linecap="round"/>
