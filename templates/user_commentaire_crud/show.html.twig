{% extends 'base.html.twig' %}

{% block title %}Commentaire{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Commentaire</h1>
    <table class="table">
        <tbody>
            <tr><th>Id</th><td>{{ commentaire.id }}</td></tr>
            <tr><th>Contenu</th><td>{{ commentaire.content|nl2br }}</td></tr>
            <tr><th>Article</th><td>{{ commentaire.post.title }}</td></tr>
            <tr><th>Auteur</th><td>{{ commentaire.utilisateur ? commentaire.utilisateur.email : 'Anonyme' }}</td></tr>
            <tr><th>Créé le</th><td>{{ commentaire.createdAt|date('d/m/Y H:i') }}</td></tr>
        </tbody>
    </table>
    <a href="{{ path('user_commentaire_edit', {'id': commentaire.id}) }}" class="btn btn-warning">Modifier</a>
    {{ include('user_commentaire_crud/_delete_form.html.twig') }}
    <a href="{{ path('user_forum') }}" class="btn btn-secondary">Retour au forum</a>
</div>
{% endblock %}