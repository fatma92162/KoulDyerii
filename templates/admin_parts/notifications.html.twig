{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <h1>Notifications administrateur</h1>
    
    {% if notifications is empty %}
        <div class="alert alert-info">Aucune notification pour le moment.</div>
    {% else %}
        <div class="list-group">
            {% for notif in notifications %}
                <div class="list-group-item {% if not notif.isRead %}list-group-item-warning{% endif %}">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>{{ notif.createdAt|date('d/m/Y H:i') }}</strong><br>
                            {{ notif.message }}
                            
                            {% if notif.entityId %}
                                <br>
                                <small>
                                    {% if notif.entityType == 'post' %}
                                        <a href="{{ path('app_admin_post_show', {id: notif.entityId}) }}">
                                            🔗 Voir la publication
                                        </a>
                                    {% elseif notif.entityType == 'comment' %}
                                        <a href="{{ path('app_admin_post_show', {id: notif.entityId}) }}?comment={{ notif.entityId }}">
                                            🔗 Voir le commentaire
                                        </a>
                                    {% endif %}
                                </small>
                            {% endif %}
                        </div>
                        
                        {% if not notif.isRead %}
                            <button class="btn btn-sm btn-primary mark-read" data-id="{{ notif.id }}">
                                ✓ Marquer comme lue
                            </button>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

<script>
document.querySelectorAll('.mark-read').forEach(btn => {
    btn.addEventListener('click', function() {
        fetch('/admin/notifications/mark-read/' + this.dataset.id, {
            method: 'POST',
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) location.reload();
        });
    });
});
</script>
{% endblock %}