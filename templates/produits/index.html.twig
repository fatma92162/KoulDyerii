    position:fixed;
    right:20px;
    bottom:20px;
    z-index:10000;
    background:#111;
    color:#fff;
    padding:14px 18px;
    border-radius:14px;
    font-weight:800;
    box-shadow:0 16px 30px rgba(0,0,0,.16);
    opacity:0;
    transform:translateY(18px);
    pointer-events:none;
    transition:.25s ease;
">
    Produit ajouté au panier
</div>
<script type="text/javascript">
(function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", "wbshd2gcag");
</script>

<script>
let currentProductPrice = 0;
let currentProductStock = 0;
let currentBundle = {
    active: false,
    type: '',
    buyQty: null,
    payQty: null,
    discountPercent: null
};

async function loadMiniCart() {
    try {
        const response = await fetch('{{ path('app_panier_mini_data') }}');
        const data = await response.json();

        const itemsContainer = document.getElementById('miniCartItems');
        const countEl = document.getElementById('miniCartCount');
        const totalEl = document.getElementById('miniCartTotal');

        countEl.textContent = data.count;
        totalEl.textContent = data.total;

        if (!data.items.length) {
            itemsContainer.innerHTML = '<div class="mini-cart-empty">Votre panier est vide.</div>';
            return;
        }

        itemsContainer.innerHTML = data.items.map(item => `
            <div class="mini-cart-item">
                ${item.photo
                    ? `<img src="${item.photo}" alt="${item.nom}">`
                    : `<div class="mini-cart-item-fallback"><i class="fas fa-box"></i></div>`
                }

                <div class="mini-cart-item-content">
                    <div class="mini-cart-item-name">${item.nom}</div>
                    <div class="mini-cart-item-price">${item.prix}</div>
                    <div class="mini-cart-qty">
                        <button type="button" onclick="updateMiniCart(${item.id}, 'minus')">-</button>
                        <span>${item.quantite}</span>
                        <button type="button" onclick="updateMiniCart(${item.id}, 'plus')">+</button>
                    </div>
                </div>
            </div>
        `).join('');
    } catch (e) {
        console.error('Mini cart error:', e);
    }
}

async function updateMiniCart(id, action) {
    try {
        const formData = new FormData();
        formData.append('action', action);

        const response = await fetch(`/produits/panier/mini-update/${id}`, {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
            alert(data.message || 'Erreur panier');
            return;
        }

        loadMiniCart();
    } catch (e) {
        console.error('Mini cart update error:', e);
    }
}
function showAovCartToast(message) {
    const toast = document.getElementById('aovCartToast');
    if (!toast) return;

    toast.textContent = message;
    toast.style.opacity = '1';
    toast.style.transform = 'translateY(0)';

    setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(18px)';
    }, 1800);
}
function formatTnd(value) {
    return Number(value).toFixed(2).replace('.', ',') + ' TND';
}

function buildBundleUI() {
    const grid = document.getElementById('bundleGrid');
    const noteBox = document.getElementById('bundleNoteBox');

    grid.innerHTML = `
        <div class="bundle-card active" onclick="selectBundle(event, 1)">
            <span class="bundle-badge">Standard</span>
            <h6>1 unité</h6>
            <p>Achat simple</p>
            <div class="bundle-price">${formatTnd(currentProductPrice)}</div>
        </div>
    `;

    noteBox.style.display = 'none';
    noteBox.innerHTML = '';

    if (!currentBundle.active) {
        return;
    }

    if (currentBundle.type === 'discount' && currentBundle.discountPercent) {
        const bundleQty = 2;
        const normal = currentProductPrice * bundleQty;
        const discounted = normal * (1 - (currentBundle.discountPercent / 100));

        grid.innerHTML += `
            <div class="bundle-card" onclick="selectBundle(event, ${bundleQty})">
                <span class="bundle-badge">-${currentBundle.discountPercent}%</span>
                <h6>${bundleQty} unités</h6>
                <p>Offre bundle active</p>
                <span class="bundle-old">${formatTnd(normal)}</span>
                <div class="bundle-price">${formatTnd(discounted)}</div>
            </div>
        `;

        noteBox.style.display = 'block';
        noteBox.innerHTML = `💡 Offre bundle : <strong>${bundleQty} unités = ${currentBundle.discountPercent}% de réduction</strong>`;
    }

    if (currentBundle.type === 'bxgy' && currentBundle.buyQty && currentBundle.payQty) {
        const normal = currentProductPrice * currentBundle.buyQty;
        const bundleTotal = currentProductPrice * currentBundle.payQty;

        grid.innerHTML += `
            <div class="bundle-card" onclick="selectBundle(event, ${currentBundle.buyQty})">
                <span class="bundle-badge">Bundle</span>
                <h6>${currentBundle.buyQty} unités</h6>
                <p>Tu paies seulement ${currentBundle.payQty}</p>
                <span class="bundle-old">${formatTnd(normal)}</span>
                <div class="bundle-price">${formatTnd(bundleTotal)}</div>
            </div>
        `;

        noteBox.style.display = 'block';
        noteBox.innerHTML = `💡 Offre bundle : <strong>Acheter ${currentBundle.buyQty} / Payer ${currentBundle.payQty}</strong>`;
    }
}

function openProductModal(card) {
    currentProductPrice = parseFloat(card.dataset.prix || '0');
    currentProductStock = parseInt(card.dataset.quantite || '0', 10);

    currentBundle = {
        active: (card.dataset.bundleActive || '0') === '1',
        type: card.dataset.bundleType || '',
        buyQty: card.dataset.bundleBuy ? parseInt(card.dataset.bundleBuy, 10) : null,
        payQty: card.dataset.bundlePay ? parseInt(card.dataset.bundlePay, 10) : null,
        discountPercent: card.dataset.bundleDiscount ? parseInt(card.dataset.bundleDiscount, 10) : null
    };

    document.getElementById('modalProductName').textContent = card.dataset.nom || 'Produit';
    document.getElementById('modalProductPrice').textContent = formatTnd(currentProductPrice);
    document.getElementById('modalProductDescription').textContent = card.dataset.description || 'Aucune description disponible.';
    document.getElementById('modalStockText').textContent = currentProductStock > 0 ? 'Disponible maintenant' : 'Indisponible';
    document.getElementById('modalQuantite').value = 1;

    const image = document.getElementById('modalProductImage');
    const fallback = document.getElementById('modalProductImageFallback');
    const photo = card.dataset.photo || '';

    if (photo) {
        image.src = photo;
        image.style.display = 'block';
        fallback.style.display = 'none';
    } else {
        image.src = '';
        image.style.display = 'none';
        fallback.style.display = 'block';
    }

    const lowStockBox = document.getElementById('modalLowStockBox');
    if (currentProductStock > 0 && currentProductStock < 10) {
        lowStockBox.style.display = 'block';
        lowStockBox.innerHTML = `🔥 Dépêche-toi, ce produit part très vite.`;
    } else {
        lowStockBox.style.display = 'none';
    }

    document.getElementById('modalAddToCartForm').action = `/produits/${card.dataset.id}/ajouter-panier`;

    buildBundleUI();

    document.getElementById('productModal').classList.add('open');
    document.getElementById('productOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeProductModal() {
    document.getElementById('productModal').classList.remove('open');
    document.getElementById('productOverlay').classList.remove('open');
    document.body.style.overflow = '';
}

function selectBundle(event, qty) {
    event.stopPropagation();
    document.querySelectorAll('.bundle-card').forEach(el => el.classList.remove('active'));
    event.currentTarget.classList.add('active');
    document.getElementById('modalQuantite').value = qty;
}

function changeModalQty(step) {
    const input = document.getElementById('modalQuantite');
    let value = parseInt(input.value || '1', 10);
    value += step;

    if (value < 1) value = 1;
    if (currentProductStock > 0 && value > currentProductStock) value = currentProductStock;

    input.value = value;
}

function initRevealAnimation() {
    const elements = document.querySelectorAll('.reveal');

    if (!('IntersectionObserver' in window)) {
        elements.forEach(el => el.classList.add('show'));
        return;
    }

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('show');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.12 });

    elements.forEach(el => observer.observe(el));
}

document.addEventListener('DOMContentLoaded', function () {
    const wrapper = document.getElementById('miniCartWrapper');

    if (wrapper) {
        wrapper.addEventListener('mouseenter', loadMiniCart);
    }

    loadMiniCart();
    initRevealAnimation();

   const addToCartForm = document.getElementById('modalAddToCartForm');

addToCartForm.addEventListener('click', function (e) {
    e.stopPropagation();
});

addToCartForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    e.stopPropagation();

    try {
        const formData = new FormData(addToCartForm);

        const response = await fetch(addToCartForm.action, {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
            showAovCartToast(data.message || 'Erreur panier');
            return;
        }

        showAovCartToast(data.message || 'Produit ajouté au panier');
        closeProductModal();
        loadMiniCart();
    } catch (error) {
        showAovCartToast('Erreur réseau ou serveur');
    }
});

document.getElementById('productModal').addEventListener('click', function (e) {
    e.stopPropagation();
});
});

document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
        closeProductModal();
    }
});
</script>
{% endblock %}