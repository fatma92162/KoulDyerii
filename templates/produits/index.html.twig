                    <i class="fas fa-info-circle"></i> Aucun produit disponible pour le moment.
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<div id="productOverlay" class="product-overlay" onclick="closeProductModal()"></div>

<div id="productModal" class="product-modal">
    <div class="product-modal-header">
        <h3 class="product-modal-title" id="modalProductName">Produit</h3>
        <button type="button" class="product-modal-close" onclick="closeProductModal()">✕</button>
    </div>

    <div class="product-modal-body">
        <div class="product-modal-grid">
            <div class="product-modal-image-box">
                <img id="modalProductImage" src="" alt="Produit" style="display:none;">
                <div id="modalProductImageFallback" class="product-modal-image-fallback">📦</div>
            </div>

            <div>
                <div class="product-modal-price" id="modalProductPrice">0.00 TND</div>

                <div class="modal-promo-row">
                    <div class="modal-promo-pill"><i class="fas fa-fire"></i> Très demandé</div>
                    <div class="modal-promo-pill"><i class="fas fa-gift"></i> Bundle disponible</div>
                    <div class="modal-promo-pill"><i class="fas fa-bolt"></i> Achat rapide</div>
                </div>

                <div id="modalLowStockBox" class="almost-sold-out" style="display:none;">
                    🔥 Ce produit est presque en rupture. Dépêche-toi avant qu’il soit sold out.
                </div>

                <div class="product-modal-desc" id="modalProductDescription"></div>

                <div class="bundle-note" id="bundleNoteBox" style="display:none;"></div>

                <div class="bundle-title">Choisir une offre</div>

                <div class="bundle-grid" id="bundleGrid">
                    <div class="bundle-card active" onclick="selectBundle(event, 1)">
                        <span class="bundle-badge">Standard</span>
                        <h6>1 unité</h6>
                        <p>Achat simple</p>
                        <div class="bundle-price" id="bundlePrice1">0.00 TND</div>
                    </div>
                </div>

                <form id="modalAddToCartForm" method="post" action="">
                    <div class="modal-qty-row">
                        <button type="button" class="qty-btn" onclick="changeModalQty(-1)">−</button>
                        <input type="number" min="1" value="1" name="quantite" id="modalQuantite" class="form-control modal-qty-input">
                        <button type="button" class="qty-btn" onclick="changeModalQty(1)">+</button>
                        <span id="modalStockText" class="text-muted fw-bold"></span>
                    </div>

                    <button type="submit" class="btn-modal-panier">
                        <i class="fas fa-cart-plus"></i> Ajouter au panier
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
