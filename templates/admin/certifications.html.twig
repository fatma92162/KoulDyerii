{% extends 'base_admin.html.twig' %}

{% block admin_title %}Certifications{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .cert-card { border: 0; border-radius: 16px; box-shadow: 0 10px 24px rgba(90, 40, 40, .08); }
</style>
{% endblock %}

{% block admin_content %}
<div class="cert-card p-3">
    <h3 class="mb-3">Certifications et QR</h3>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>ID certificat</th><th>Utilisateur</th><th>Formation</th><th>Score</th><th>Actions</th></tr></thead>
            <tbody>
            {% for item in items %}
                <tr>
                    <td><strong>{{ item.certificateId }}</strong></td>
                    <td>{{ item.utilisateur }}</td>
                    <td>{{ item.formation }}</td>
                    <td>
                        {% if item.score is null %}
                            <span class="badge bg-warning text-dark">Non évalué</span>
                        {% else %}
                            <span class="badge {{ item.eligible ? 'bg-success' : 'bg-danger' }}">{{ item.score }}%</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if item.eligible %}
                            <a href="{{ path('app_certification_qr', {id: item.inscriptionId}) }}" class="btn btn-sm btn-primary">QR</a>
                            <a href="{{ path('app_certification_pdf_private', {id: item.inscriptionId}) }}" class="btn btn-sm btn-dark" target="_blank" rel="noopener">PDF</a>
                        {% else %}
                            <span class="text-muted small">Disponible à partir de 80%</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted">Aucune certification.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
