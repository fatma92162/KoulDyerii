{% extends 'base.html.twig' %}

{% block title %}Mon Profil | Koul Dyeri{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .profile-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }
    
    .profile-card {
        background: white;
        border-radius: 40px;
        padding: 0;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.2);
        animation: fadeInUp 0.7s ease-out;
        max-width: 800px;
        margin: 0 auto;
        overflow: hidden;
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .profile-header {
        background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
        padding: 40px 30px;
        text-align: center;
        position: relative;
        cursor: pointer;
    }
    
    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: white;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        transition: transform 0.3s ease;
    }
    
    .profile-avatar:hover {
        transform: scale(1.05);
    }
    
    .profile-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .profile-avatar .avatar-placeholder {
        font-size: 60px;
    }
    
    .profile-header h2 {
        color: white;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 5px;
    }
    
    .profile-header p {
        color: #fff9e6;
        font-size: 14px;
    }
    
    .points-card {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        padding: 15px 20px;
        margin-top: 20px;
        backdrop-filter: blur(10px);
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .points-card:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-3px);
    }
    
    .points-value {
        font-size: 32px;
        font-weight: bold;
        color: #FFD700;
        text-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    }
    
    .points-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: white;
        opacity: 0.9;
    }
    
    .profile-body {
        padding: 40px;
    }
    
    .info-section {
        margin-bottom: 30px;
    }
    
    .info-title {
        font-size: 20px;
        font-weight: 700;
        color: #333;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 3px solid #FF6B6B;
        display: inline-block;
    }
    
    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 20px;
    }
    
    .info-item {
        background: #fefcf8;
        padding: 15px 20px;
        border-radius: 15px;
        border: 1px solid #f0e6d6;
        transition: all 0.3s ease;
    }
    
    .info-item:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        border-color: #FF6B6B;
    }
    
    .info-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #FF6B6B;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }
    
    .info-value {
        font-size: 18px;
        font-weight: 500;
        color: #333;
        word-break: break-word;
    }
    
    .role-badge {
        display: inline-block;
        padding: 5px 15px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }
    
    .role-admin {
        background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
        color: white;
    }
    
    .role-user {
        background: #4CAF50;
        color: white;
    }
    
    .actions-section {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 40px;
        padding-top: 30px;
        border-top: 1px solid #f0e6d6;
    }
    
    .btn-action {
        padding: 12px 30px;
        border-radius: 50px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }
    
    .btn-edit {
        background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
        color: white;
        border: none;
    }
    
    .btn-edit:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(255, 107, 107, 0.4);
        color: white;
    }
    
    .btn-logout {
        background: #333;
        color: white;
        border: none;
    }
    
    .btn-logout:hover {
        background: #555;
        transform: translateY(-3px);
        color: white;
    }
    
    .btn-rewards {
        background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
        color: #333;
        border: none;
    }
    
    .btn-rewards:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(255, 215, 0, 0.4);
        color: #333;
    }
    
    /* Modal styles */
    .modal-points {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    @media (max-width: 768px) {
        .profile-body {
            padding: 25px;
        }
        .info-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }
        .actions-section {
            flex-direction: column;
        }
        .btn-action {
            justify-content: center;
        }
        .profile-header h2 {
            font-size: 24px;
        }
        .profile-avatar {
            width: 90px;
            height: 90px;
        }
        .profile-avatar .avatar-placeholder {
            font-size: 45px;
        }
        .points-value {
            font-size: 24px;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="profile-container">
    <div class="profile-card">
        <div class="profile-header" onclick="showPointsModal()">
            <div class="profile-avatar">
                {% if utilisateur.photo %}
                    <img src="{{ utilisateur.photo }}" alt="Photo de profil">
                {% else %}
                    <div class="avatar-placeholder">
                        🍽️
                    </div>
                {% endif %}
            </div>
            <h2>{{ utilisateur.nom }}</h2>
            <p>Membre de Koul Dyeri</p>
            
            <!-- ✅ Carte des points de fidélité -->
            <div class="points-card">
                <div class="row align-items-center">
                    <div class="col-4 text-start">
                        <i class="fas fa-star" style="font-size: 32px; color: #FFD700;"></i>
                    </div>
                    <div class="col-8 text-end">
                        <div class="points-label">Mes points de fidélité</div>
                        <div class="points-value">{{ points|default(0) }} pts</div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="profile-body">
            <div class="info-section">
                <h3 class="info-title">📋 Informations personnelles</h3>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">ID utilisateur</div>
                        <div class="info-value">#{{ utilisateur.idUtilisateur }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Nom complet</div>
                        <div class="info-value">{{ utilisateur.nom }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Adresse email</div>
                        <div class="info-value">{{ utilisateur.email }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Rôle</div>
                        <div class="info-value">
                            <span class="role-badge {% if utilisateur.role == 'admin' %}role-admin{% else %}role-user{% endif %}">
                                {% if utilisateur.role == 'admin' %}👑 Administrateur{% else %}👤 Utilisateur{% endif %}
                            </span>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">📍 Région</div>
                        <div class="info-value">{{ utilisateur.region ?: 'Non renseignée' }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">🎂 Date de naissance</div>
                        <div class="info-value">{{ utilisateur.dateNaissance ? utilisateur.dateNaissance|date('d/m/Y') : 'Non renseignée' }}</div>
                    </div>
                </div>
            </div>
            
            <div class="actions-section">
                <a href="{{ path('app_utilisateur_editer', {id: utilisateur.idUtilisateur}) }}" class="btn-action btn-edit">
                    ✏️ Modifier mon profil
                </a>
                <a href="{{ path('app_recompenses_index') }}" class="btn-action btn-rewards">
                    🎁 Voir les récompenses
                </a>
                <a href="{{ path('app_logout') }}" class="btn-action btn-logout">
                    🔓 Déconnexion
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Modal pour les détails des points -->
<div class="modal fade" id="pointsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);">
                <h5 class="modal-title text-white">
                    <i class="fas fa-star"></i> Mes Points de Fidélité
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-4">
                    <i class="fas fa-gem" style="font-size: 64px; color: #FFD700;"></i>
                    <h2 class="mt-3">{{ points|default(0) }} <small class="text-muted">points</small></h2>
                </div>
                
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Comment gagner des points ?
                </div>
                
                <div class="list-group mb-3">
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-pen-alt text-primary"></i> Publier un article</span>
                        <span class="badge bg-primary rounded-pill">+10 points</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-comment text-success"></i> Commenter une publication</span>
                        <span class="badge bg-success rounded-pill">+5 points</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-heart text-danger"></i> Recevoir un like</span>
                        <span class="badge bg-danger rounded-pill">+2 points</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-thumbs-up text-info"></i> Donner un like</span>
                        <span class="badge bg-info rounded-pill">+1 point</span>
                    </div>
                </div>
                
                <div class="progress mb-3" style="height: 10px;">
                    {% set nextLevel = 500 %}
                    {% set progress = (points|default(0) / nextLevel * 100)|round %}
                    <div class="progress-bar bg-warning" style="width: {{ progress > 100 ? 100 : progress }}%"></div>
                </div>
                <small class="text-muted">
                    {% set remaining = nextLevel - points|default(0) %}
                    {% if remaining > 0 %}
                        Plus que {{ remaining }} points pour atteindre le niveau suivant !
                    {% else %}
                        🎉 Félicitations ! Vous avez atteint le niveau supérieur !
                    {% endif %}
                </small>
            </div>
            <div class="modal-footer">
                <a href="{{ path('app_recompenses_index') }}" class="btn btn-warning w-100">
                    <i class="fas fa-gift"></i> Voir les récompenses disponibles
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function showPointsModal() {
    var myModal = new bootstrap.Modal(document.getElementById('pointsModal'));
    myModal.show();
}
</script>
{% endblock %}