{% extends 'base_admin.html.twig' %}

{% block admin_title %}Détails partenaire - {{ partenaire.nom }}{% endblock %}

{% block admin_content %}
<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>🤝 Détails du partenaire</h3>
        <a href="{{ path('app_admin_partenaires_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Informations générales</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Nom:</strong></div>
                        <div class="col-sm-8">{{ partenaire.nom }}</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Type:</strong></div>
                        <div class="col-sm-8">{{ partenaire.type }}</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Téléphone:</strong></div>
                        <div class="col-sm-8">{{ partenaire.telephone }}</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Adresse:</strong></div>
                        <div class="col-sm-8">{{ partenaire.adresse }}</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Statut:</strong></div>
                        <div class="col-sm-8">
                            <span class="status-badge status-{{ partenaire.statut }}">
                                {% if partenaire.statut == 'en_attente' %}⏳ En attente
                                {% elseif partenaire.statut == 'accepte' %}✅ Accepté
                                {% else %}❌ Refusé{% endif %}
                            </span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Date demande:</strong></div>
                        <div class="col-sm-8">{{ partenaire.dateDemande ? partenaire.dateDemande|date('d/m/Y H:i') : '-' }}</div>
                    </div>
                    {% if partenaire.dateValidation %}
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Date validation:</strong></div>
                        <div class="col-sm-8">{{ partenaire.dateValidation|date('d/m/Y H:i') }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>
            
            {% if partenaire.description %}
            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Description</h5>
                </div>
                <div class="card-body">
                    <p>{{ partenaire.description }}</p>
                </div>
            </div>
            {% endif %}
        </div>
        
        <div class="col-md-4">
            {% if partenaire.logo %}
            <div class="card mb-3">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Logo</h5>
                </div>
                <div class="card-body text-center">
                    <img src="{{ partenaire.logo }}" class="img-fluid rounded" style="max-height: 200px;">
                </div>
            </div>
            {% endif %}
            
            <div class="card">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    {% if partenaire.statut == 'en_attente' %}
                        <form action="{{ path('app_admin_partenaire_accepter', {id: partenaire.id}) }}" method="post" class="mb-2">
                            <button type="submit" class="btn btn-success w-100" onclick="return confirm('Accepter ce partenaire ?')">
                                <i class="fas fa-check"></i> Accepter
                            </button>
                        </form>
                        <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#refuseModal">
                            <i class="fas fa-times"></i> Refuser
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Refuser -->
<div class="modal fade" id="refuseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="{{ path('app_admin_partenaire_refuser', {id: partenaire.id}) }}" method="post">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Refuser le partenaire</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label for="motif" class="form-label">Motif du refus (optionnel)</label>
                    <textarea name="motif" id="motif" class="form-control" rows="3" placeholder="Expliquez la raison du refus..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Confirmer le refus</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }
    .status-en_attente {
        background: #FF9800;
        color: white;
    }
    .status-accepte {
        background: #4CAF50;
        color: white;
    }
    .status-refuse {
        background: #f44336;
        color: white;
    }
</style>
{% endblock %}